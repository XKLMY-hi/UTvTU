<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ═══════════════════════════════════════════════════════════════════════
       Fluent 主题画刷键 → 颜色池（2026-09-25 · SukiUI 移除后重建）

       用途：CheckBox / RadioButton / ToggleSwitch / Slider / ComboBox / ProgressBar
       这些控件我们**不自写模板**，直接用 Fluent 的（行为最完整）；它们的状态色写在模板部件上、
       取自 Fluent 的主题画刷键。把这些键指向颜色池，既统一了配色，又保留 Fluent 自带的状态过渡
       —— 不需要从外面打 `/template/` 补丁（那会互踩导致闪烁）。

       挂载位置：`Application.Resources`（资源查找先于 Styles；画刷是整把对象，随颜色池重建而更新）。
       命名规律：`<控件><部位><状态>`，均为 Avalonia Fluent 主题的标准键名。
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- 复选框 -->
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{DynamicResource md3.color.surface-container-high}"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{DynamicResource md3.color.outline}"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{DynamicResource md3.color.on-primary}"/>
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{DynamicResource md3.color.on-primary}"/>
  <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{DynamicResource md3.color.on-surface}"/>
  <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPointerOver" Color="{DynamicResource md3.color.on-surface}"/>
  <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{DynamicResource md3.color.on-surface}"/>

  <!-- 单选框 -->
  <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="{DynamicResource md3.color.outline}"/>
  <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePointerOver" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="{DynamicResource md3.color.surface-container-high}"/>
  <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPointerOver" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{DynamicResource md3.color.on-primary}"/>
  <SolidColorBrush x:Key="RadioButtonCheckGlyphStroke" Color="{DynamicResource md3.color.on-primary}"/>
  <SolidColorBrush x:Key="RadioButtonForeground" Color="{DynamicResource md3.color.on-surface}"/>
  <SolidColorBrush x:Key="RadioButtonForegroundPointerOver" Color="{DynamicResource md3.color.on-surface}"/>

  <!-- 开关 -->
  <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{DynamicResource md3.color.outline}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{DynamicResource md3.color.outline}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource md3.color.on-primary}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{DynamicResource md3.color.on-primary}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{DynamicResource md3.color.outline}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{DynamicResource md3.color.on-surface-variant}"/>

  <!-- 滑条 -->
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="SliderTrackFill" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource md3.color.primary}"/>

  <!-- 下拉框 -->
  <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource md3.color.surface-container-high}"/>
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{DynamicResource md3.color.outline-variant}"/>
  <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{DynamicResource md3.color.outline}"/>
  <SolidColorBrush x:Key="ComboBoxForeground" Color="{DynamicResource md3.color.on-surface}"/>
  <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="{DynamicResource md3.color.on-surface}"/>
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource md3.color.surface-container-high}"/>
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource md3.color.outline-variant}"/>
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{DynamicResource md3.color.secondary-container}"/>
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{DynamicResource md3.color.on-secondary-container}"/>

  <!-- 进度条 -->
  <SolidColorBrush x:Key="ProgressBarForeground" Color="{DynamicResource md3.color.primary}"/>
  <SolidColorBrush x:Key="ProgressBarBackground" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="ProgressBarIndeterminateForeground" Color="{DynamicResource md3.color.primary}"/>
</ResourceDictionary>
