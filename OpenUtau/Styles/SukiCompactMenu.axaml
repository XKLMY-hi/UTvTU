<Styles xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    紧凑菜单接管（探针实证：Suki 菜单条模板高 45 + MenuItem 内容区固定 ~10px，
    24px 顶栏内文字被压到 6px 半切）。菜单视觉由 Plus 紧凑模板提供（行高 ~25px）。
    弹出方向约定（探针实证 MenuItem 逻辑只在无显式 Placement 时按层级设置）：
    - 顶栏一级（Menu 直接子项）→ MenuItemTopLevel 模板（无 Placement，逻辑设 Bottom 向下）
    - 右键一级 / 各级二级 → 默认 MenuItem 模板（Placement=RightEdgeAlignedTop 向右）
    Menu 模板为纯 ItemsPresenter（Popup 内 ItemsPresenter 会双重挂载崩溃——启动实证）。
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
        <Setter Property="Template">
          <ControlTemplate>
            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                            KeyboardNavigation.TabNavigation="Continue"/>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- 顶栏一级菜单项：Popup 无 Placement（MenuItem 逻辑按 Menu 直接子项设 Bottom 向下）。
           由 Menu.ItemContainerTheme 指定（Menu 容器专用）。
           ⚠️ PART_Popup 必须有名字：MenuItem 靠模板 Popup 判断"鼠标是否在子菜单上"
           （IsPointerOverSubMenu），无名则 _popup=null → 鼠标移入子菜单即关闭
           2026-09-25：文字左对齐（去掉无用的图标占位列）、悬浮高光改圆角 + md3 角色色 -->
      <ControlTheme x:Key="MenuItemTopLevel" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Border x:Name="PART_Item" Background="Transparent" CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <Grid ColumnDefinitions="*,Auto">
                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Header}"
                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                  Foreground="{DynamicResource md3.on-surface}"/>
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGesture}"
                           FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource md3.on-surface-variant}"/>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubMenuOpen}"
                       HorizontalOffset="2">
                  <Border Background="{DynamicResource md3.surface-container-high}"
                          BorderBrush="{DynamicResource md3.outline-variant}"
                          BorderThickness="1"
                          CornerRadius="12"
                          BoxShadow="{DynamicResource PlusElevationPopup}"
                          MinWidth="180" Padding="4" ClipToBounds="True" Classes="menuPopup">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Item">
          <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter">
          <Setter Property="Opacity" Value="0.4"/>
        </Style>
      </ControlTheme>

      <!-- 默认菜单项：Popup 向右（右键一级 / 各级二级）
           2026-09-25：文字左对齐、悬浮高光改圆角 + md3 角色色（原先整行直角 + Plus 旧令牌） -->
      <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Border x:Name="PART_Item" Background="Transparent" CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <Grid ColumnDefinitions="*,Auto">
                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Header}"
                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                  Foreground="{DynamicResource md3.on-surface}"/>
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGesture}"
                           FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource md3.on-surface-variant}"/>
                <!-- Placement 硬编码向右（右键一级的 MenuItem 逻辑判"顶层"会给 Bottom，
                     需显式向右；二级亦向右） -->
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubMenuOpen}"
                       Placement="RightEdgeAlignedTop" HorizontalOffset="2">
                  <Border Background="{DynamicResource md3.surface-container-high}"
                          BorderBrush="{DynamicResource md3.outline-variant}"
                          BorderThickness="1"
                          CornerRadius="12"
                          BoxShadow="{DynamicResource PlusElevationPopup}"
                          MinWidth="180" Padding="4" ClipToBounds="True" Classes="menuPopup">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Item">
          <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter">
          <Setter Property="Opacity" Value="0.4"/>
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Border x:Name="PART_PopupBorder"
                    Background="{DynamicResource md3.surface-container-high}"
                    BorderBrush="{DynamicResource md3.outline-variant}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="{TemplateBinding Padding}"
                    BoxShadow="{DynamicResource PlusElevationPopup}"
                    MinWidth="180" ClipToBounds="True">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Menu 容器（顶栏一级）用 MenuItemTopLevel 模板：方向由逻辑设向下 -->
  <Style Selector="Menu">
    <Setter Property="ItemContainerTheme" Value="{StaticResource MenuItemTopLevel}"/>
  </Style>

  <!-- 弹出淡入由 Motion.Enter="Fade" + AutoPlay 提供（时长/缓动走动效令牌） -->
</Styles>
