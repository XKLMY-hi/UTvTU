<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenUtau.App.Controls">
  <Style>
    <Style.Resources>
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
      <x:Double x:Key="MenuFlyoutThemeMinHeight">20</x:Double>
      <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
      <Thickness x:Key="ComboBoxDropdownContentMargin">0</Thickness>
    </Style.Resources>
  </Style>
  <!-- Rounded popup overlays -->
  <Style Selector="Popup > Border">
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter /template/ Border#PART_PopupBorder">
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter /template/ Border">
    <Setter Property="CornerRadius" Value="8"/>
  </Style>

  <Style Selector="Window">
    <!-- 字体走 Plus 令牌（Plus.Resources 全局资源，不依赖语言包/继承链；
         裸 $Default 在部分设备上 Skia 解析失败会崩溃） -->
    <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/>
    <Setter Property="Icon" Value="/Assets/open-utau.ico"/>
    <!-- 跟随主题色渐变背景（顶部 base → 底部 accent 注入） -->
    <Setter Property="Background" Value="{DynamicResource PlusBrushWindowBackground}"/>
  </Style>
  <!-- 字体兜底：AccessText/TextPresenter 是 TextBlock 子类，不吃 TextBlock 选择器；
       ToolTip/ContextMenu/MenuFlyoutPresenter/FlyoutPresenter 渲染在 PopupRoot
       （不继承 Window 字体）——全部显式指定 Plus 令牌，杜绝 $Default 回流 -->
  <Style Selector="AccessText">
    <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/>
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/>
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/>
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/>
  </Style>
  <Style Selector="Menu">
    <Setter Property="Height" Value="24"/>
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="8,2,8,2"/>
  </Style>
  <Style Selector="MenuItem /template/ Path#PART_ChevronPath">
    <Setter Property="RenderTransform" Value="Scale(0.75,0.75)"/>
    <Setter Property="Fill" Value="{DynamicResource PlusBrushTextSecondary}"/>
  </Style>
  <!-- v4.0：菜单 hover = accent-muted（不再是 Fluent 的白色 overlay） -->
  <Style Selector="MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource PlusBrushAccentMuted}"/>
    <Setter Property="Foreground" Value="{DynamicResource PlusBrushAccent}"/>
  </Style>
  <Style Selector="MenuItem:selected">
    <Setter Property="Background" Value="{DynamicResource PlusBrushAccentMuted}"/>
    <Setter Property="Foreground" Value="{DynamicResource PlusBrushAccent}"/>
  </Style>
  <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForeground}"/>
  </Style>
  <Style Selector="MenuItem:selected /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPointerOver}"/>
  </Style>
  <Style Selector="MenuItem:pressed /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPressed}"/>
  </Style>
  <Style Selector="MenuItem:disabled /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemForegroundDisabled}"/>
  </Style>
  <Style Selector="MenuItem > Separator, ContextMenu > Separator">
    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightBaseMediumHighBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="Height" Value="1" />
  </Style>

  <Style Selector="MenuItem.MenuItemWithSubMenu MenuItem">
    <Setter Property="Header" Value="{Binding Header}"/>
    <Setter Property="Command" Value="{Binding Command}"/>
    <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
    <Setter Property="Height" Value="{Binding Height}"/>
    <Setter Property="Icon" Value="{Binding Icon}"/>
  </Style>

  <Style Selector="ContextMenu MenuItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="4,2,4,2"/>
  </Style>

  <Style Selector="ContextMenu.WithCommand MenuItem">
    <Setter Property="Header" Value="{Binding Header}"/>
    <Setter Property="Command" Value="{Binding Command}"/>
    <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
  </Style>

  <Style Selector="Path.checkmenu">
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Data" Value="M1,5 L4,8 L9,1"/>
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush1}"/>
    <Setter Property="StrokeThickness" Value="2"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="Label">
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="SelectionForegroundBrush" Value="White"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush1Semi}"/>
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush1}"/>
    <Setter Property="BorderThickness" Value="1.5"/>
  </Style>
  <Style Selector="TextBox:disabled">
    <Setter Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}" />
  </Style>

  <!-- Button 基础模板与**类变体颜色**均由 PlusTheme ControlTheme 接管（v4.0 / T8）。
       此处仅保留应用级布局与几何；变体颜色（primary/outline/danger）在
       Styles/Md3ControlThemes.axaml 内定义 —— 应用级 setter 会压过主题 setter，
       旧写法还在 `ContentPresenter#PART_ContentPresenter` 上刷固定色方块，
       导致主按钮「池色圆角底 + 固定色方块」两层叠色、深色池下白字对比度不足。 -->
  <Style Selector="Button">
    <Setter Property="Margin" Value="0,4"/>
  </Style>

  <!-- Button.primary / .outline / .danger 的颜色（含悬浮·按下）已移入 ControlTheme：
       md3.primary · md3.on-primary ／ md3.outline ／ md3.error · md3.on-error -->

  <Style Selector="Button.clear">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
  </Style>
  <!-- .clear 的悬浮底色由 ControlTheme 的 `^:pointerover` 提供（surface-container-high），
       不再从外部往 ContentPresenter 上刷方块（那会与主题抢同一层且没有圆角） -->

  <!-- 链接按钮（MessageBox 错误详情 URL 化，阶段 D 自 MessageBox.axaml 迁出） -->
  <Style Selector="Button.linkButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <!-- 链接按钮的强调色 + 下划线（T9：Button 模板改为 RecognizesAccessKey=True 后，字符串内容
       由 AccessText 承载而不是 TextBlock —— 只写 TextBlock 的规则会失效，故两种都列上） -->
  <Style Selector="Button.linkButton TextBlock, Button.linkButton AccessText">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush1}"/>
    <Setter Property="TextDecorations" Value="Underline"/>
  </Style>
  <Style Selector="Button.linkButton:pointerover TextBlock, Button.linkButton:pointerover AccessText">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush2}"/>
  </Style>

  <Style Selector="ToggleButton.normal">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrush}" />
    </Style>
    <Style Selector="^:pressed  /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushPointerOver}" />
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushSemi}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrush}" />
    </Style>
    <Style Selector="^:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushPointerOver}" />
    </Style>
  </Style>

  <Style Selector="ToggleButton.toolbar">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushPointerOver}" />
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushSemi}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrush}" />
    </Style>
    <Style Selector="^:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushPointerOver}" />
    </Style>

    <Style Selector="^ Path.filled">
      <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="^ Ellipse.stroked">
      <Setter Property="StrokeThickness" Value="1"/>
      <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="^ Path.stroked">
      <Setter Property="StrokeThickness" Value="1"/>
      <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
  </Style>

  <Style Selector="ToggleButton.switch">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- ToggleSwitch 模板已由 PlusTheme ControlTheme 接管（v4.0：off 暗 / on accent）。
       旧全局 /template/ 覆盖已删——它无条件把轨道设红，导致所有开关开闭都是红。 -->


  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceControl}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="Padding" Value="8,0,0,0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="ComboBox /template/ Path#DropDownGlyph">
    <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <!-- 选中态配色已由 Md3ListBoxItemTheme 的 ^:selected 拥有（secondary-container + on-secondary-container，
       实测对比度 7.19:1）。此处曾有应用级补丁 `ListBoxItem:selected /template/ ContentPresenter
       { Background = AccentBrush1Semi }`，它会在主题胶囊内再叠一层 #A699C3，把选中行局部对比度压到 3.49:1
       （低于 WCAG AA 正文 4.5:1）——同一类"应用级 /template/ 补丁压过 ControlTheme"的问题，故删除。 -->
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrushPointerOver}"/>
  </Style>

  <!-- CheckBox 模板已由 PlusTheme ControlTheme 接管（v4.0）；仅保留尺寸与 .menu 变体 -->
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="CheckBox.menu">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Style Selector="^:unchecked /template/ Border#NormalRectangle">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="^:checked /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush1}" />
      <Setter Property="Width" Value="12" />
    </Style>
    <Style Selector="^:checked /template/ Border#NormalRectangle">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Style>

  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ DataGridFrozenGrid">
    <Setter Property="Background" Value="{DynamicResource AccentBrush1Semi}" />
  </Style>
  <Style Selector="DataGridCell > TextBox">
    <Setter Property="Margin" Value="0"/>
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush1}"/>
  </Style>

  <Style Selector="Border.playback">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NeutralAccentBrushSemi}"/>
    <Setter Property="Height" Value="20"/>
  </Style>
  <Style Selector="Border.playback TextBlock">
    <Setter Property="Padding" Value="6,0,0,1"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.playback StackPanel">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.playback Button">
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="21"/>
    <Setter Property="Height" Value="19"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style Selector="Border.tips">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NeutralAccentBrushSemi}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <Style Selector="TextBlock.tips">
    <Setter Property="LineHeight" Value="18"/>
  </Style>

  <Style Selector="ScrollBar.music[IsExpanded=True] /template/ Rectangle#TrackRect">
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar.music[IsExpanded=true] /template/ Thumb.thumb">
    <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushSemi}" />
  </Style>
  <Style Selector="ScrollBar.music[IsExpanded=true] /template/ Thumb.thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource NeutralAccentBrush}" />
  </Style>
  <Style Selector="ScrollBar.music /template/ RepeatButton.line /template/ Border#Root" >
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar.music /template/ RepeatButton.line:pointerover /template/ Border#Root" >
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar.music /template/ RepeatButton.line:pressed /template/ Border#Root" >
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar.music:vertical /template/ RepeatButton.line.up /template/ Path">
    <Setter Property="Data" Value="M 0 20 L 20 20 L 10 0 Z" />
  </Style>
  <Style Selector="ScrollBar.music:vertical /template/ RepeatButton.line.down /template/ Path">
    <Setter Property="Data" Value="M 0 0 L 20 0 L 10 20 Z" />
  </Style>
  <Style Selector="ScrollBar.music:horizontal /template/ RepeatButton.line.up /template/ Path">
    <Setter Property="Data" Value="M 0 10 L 20 0 L 20 20 Z" />
  </Style>
  <Style Selector="ScrollBar.music:horizontal /template/ RepeatButton.line.down /template/ Path">
    <Setter Property="Data" Value="M 20 10 L 0 0 L 0 20 Z" />
  </Style>
  <Style Selector="ScrollBar.music /template/ RepeatButton.line /template/ Viewbox" >
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>
  <Style Selector="ScrollBar.music /template/ RepeatButton.line /template/ Path#Arrow" >
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Fill" Value="{DynamicResource NeutralAccentBrushSemi}" />
  </Style>
  <Style Selector="ScrollBar.music /template/ RepeatButton.line:pointerover /template/ Path#Arrow" >
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Fill" Value="{DynamicResource NeutralAccentBrush}" />
  </Style>
  <Style Selector="ScrollBar.music /template/ RepeatButton.line:pressed /template/ Path#Arrow" >
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Fill" Value="{DynamicResource NeutralAccentBrush}" />
  </Style>

  <Style Selector="HeaderedContentControl.groupbox">
    <Setter Property="Margin" Value="5"/>
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border ZIndex="1" Padding="2,0,2,0" Background="{TemplateBinding Background}" Margin="5,0,0,0">
              <TextBlock Text="{TemplateBinding Header}"/>
            </Border>
            <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="12,12,12,8"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="8">
              <ContentPresenter Content="{TemplateBinding Content}" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="Slider.fader">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush1}"/>
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Border>
            <Grid x:Name="SliderContainer" MinHeight="16">
              <Track
                  Name="PART_Track"
                  Minimum="{TemplateBinding Minimum}"
                  Maximum="{TemplateBinding Maximum}"
                  Value="{TemplateBinding Value, Mode=TwoWay}"
                  IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                  Orientation="Horizontal"
                  Height="4"
                  VerticalAlignment="Center">
                <Track.DecreaseButton>
                  <RepeatButton
                      Name="PART_DecreaseButton"
                      Background="{TemplateBinding Foreground}"
                      Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate>
                        <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton
                      Name="PART_IncreaseButton"
                      Background="{TemplateBinding Background}"
                      Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate>
                        <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseButton>
                <Thumb
                    Name="thumb"
                    Width="{DynamicResource SliderHorizontalThumbWidth}"
                    Height="{DynamicResource SliderHorizontalThumbHeight}"
                    Margin="0"
                    Padding="0"
                    Background="{TemplateBinding Foreground}"
                    BorderThickness="0"
                    DataContext="{TemplateBinding Value}">
                  <Thumb.Template>
                    <ControlTemplate>
                      <Border Background="{TemplateBinding Background}" Height="6" Width="16" CornerRadius="2"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track>
            </Grid>
          </Border>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- 只给 fader 变体提亮（v4.0 起混合台推子 = AccentBrush1/2 一对）。
       2026-10 选择类控件自有 ControlTheme 后，这条必须收窄到 `.fader`：
       普通 Slider 的模板里也有 RepeatButton#PART_DecreaseButton，若不收窄，
       这条应用级补丁会压住新主题里"已选轨道 = primary"的状态色。 -->
  <Style Selector="Slider.fader:pointerover /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource AccentBrush2}" />
  </Style>

  <Style Selector="Expander" >
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="IsExpanded" Value="True" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="Transparent" />

    <Style Selector="^:down /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="^:down /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
      <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="^:down /template/ ToggleButton#ExpanderHeader /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Margin" Value="7,0,0,0"/>
    </Style>
  </Style>

  <Style Selector="ColorPicker TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="0,4,4,0"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="5"/>
    <Setter Property="Margin" Value="0"/>
  </Style>


  <!-- TabItem -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{DynamicResource AccentBrush1}"/>
  </Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrushPointerOver}"/>
  </Style>

  <!-- RadioButton (global) -->
  <Style Selector="RadioButton">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Margin" Value="0,2"/>
    <Setter Property="MinHeight" Value="28"/>
  </Style>

  <!-- ToolTip -->
  <Style Selector="ToolTip">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
  </Style>

  <!-- Separator -->
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="2,4"/>
  </Style>

  <!-- ScrollBar thumbs -->
  <Style Selector="ScrollBar /template/ Thumb.thumb">
    <Setter Property="CornerRadius" Value="3"/>
  </Style>

  <!-- ── Window title bar buttons (Edge / Office style) ── -->
  <Style Selector="Button.titleBarBtn">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>

  <!-- Close button: red hover only (min / max stay flat) -->
  <Style Selector="Button.titleBarBtn.closeBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E81123"/>
  </Style>
  <Style Selector="Button.titleBarBtn.closeBtn:pointerover Path">
    <Setter Property="Stroke" Value="White"/>
  </Style>
  <Style Selector="Button.titleBarBtn.closeBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#BF0F1D"/>
  </Style>
  <Style Selector="Button.titleBarBtn.closeBtn:pressed Path">
    <Setter Property="Stroke" Value="White"/>
  </Style>
</Styles>
