<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.resourceCard">
    <Setter Property="Background" Value="{DynamicResource md3.surface-container}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeExtraLarge}"/>
    <Setter Property="Padding" Value="20"/>
  </Style>
  <Style Selector="Button.resourceTab">
    <Setter Property="Theme" Value="{StaticResource Md3ButtonTheme}"/>
    <Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="40"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeFull}"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
    <Setter Property="Padding" Value="16,0"/>
  </Style>
  <Style Selector="Button.resourceTab.selected">
    <Setter Property="Background" Value="{DynamicResource md3.secondary-container}"/>
    <Setter Property="Foreground" Value="{DynamicResource md3.on-secondary-container}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="TextBox.resourceField,ComboBox.resourceField">
    <Setter Property="Height" Value="{DynamicResource Md3WorkspaceControlHeight}"/>
    <Setter Property="MinHeight" Value="{DynamicResource Md3WorkspaceControlHeight}"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodyMedium}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeSmall}"/>
  </Style>
  <Style Selector="Button.resourceAction">
    <Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="36"/>
  </Style>
  <Style Selector="Button.catalogAction">
    <Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="40"/>
    <Setter Property="Margin" Value="0,0,8,8"/>
  </Style>
  <Style Selector="TextBlock.resourceSectionTitle">
    <Setter Property="FontSize" Value="{DynamicResource Md3TypeTitleMedium}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
  </Style>
</Styles>
