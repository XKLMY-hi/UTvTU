<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ═══════════════════════════════════════════════════════════════════════
       MD3 控件主题（实验：ControlTheme 与"装主题"的样式放在**同一个文件**）

       上一轮四种挂法都失败，怀疑点是"跨字典 StaticResource 解析不到"：
       主题在 App.Resources、引用它的样式在另一个 Styles 文件 → 装不上去。
       这里把两者放同一字典，再用应用级 Style 显式 Setter Property="Theme"
       （应用级 Style 优先级已被反复验证为最高）。

       T8 起：**类变体的颜色也在本文件内**（`^.primary` / `^.outline` / `^.danger` 及其
       悬浮·按下态）。原因：应用级 Style setter 压过 ControlTheme setter —— 变体颜色留在
       应用级样式里会反过来压住主题（还会在 ContentPresenter 上刷没有圆角的色块）。
       ═══════════════════════════════════════════════════════════════════════ -->
  <Styles.Resources>
    <ControlTheme x:Key="Md3ButtonTheme" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <!-- 基础标签色（T9-B 决策）：MD3 规范里 outlined 按钮标签应为 md3.primary，
           但那个取值在"转发修复"之前**从未真正渲染过**（一直被应用级 TextBlock 前景压住），
           用户这几个月确认的普通按钮观感就是 on-surface ⇒ 本轮保持 on-surface，避免
           全 App 普通按钮标签一起变 indigo 这种未经预览的大面积视觉变更。
           要回到 MD3 规范态：把下面这行的 md3.on-surface 改成 md3.primary 即可（一行，无其它副作用）。 -->
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline-variant}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource md3.outline}"/>
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.38"/>
      </Style>
      <Style Selector="^.primary">
        <Setter Property="Background" Value="{DynamicResource md3.primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource md3.on-primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="18,6"/>
        <Setter Property="FontWeight" Value="Medium"/>
      </Style>
      <Style Selector="^.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource md3.primary}"/>
        <Setter Property="Opacity" Value="0.92"/>
      </Style>
      <!-- 按下反馈（T8-A 收敛）：旧实现由应用级样式在 ContentPresenter 上刷固定色方块，
           现收归主题 —— 深色池下 primary 是浅色容器，on-primary 才是对比色，文字不再压白。 -->
      <Style Selector="^.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource md3.primary}"/>
        <Setter Property="Opacity" Value="0.85"/>
      </Style>
      <!-- 描边按钮：显式用 outline 角色（比基础态的 outline-variant 更实），颜色仍归主题 -->
      <Style Selector="^.outline">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource md3.outline}"/>
      </Style>
      <!-- 危险按钮（T8-A 收敛）：旧实现用固定 #e53935 / #c62828 / White，现改用 error 角色 -->
      <Style Selector="^.danger">
        <Setter Property="Foreground" Value="{DynamicResource md3.error}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource md3.error}"/>
      </Style>
      <Style Selector="^.danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource md3.error}"/>
        <Setter Property="Foreground" Value="{DynamicResource md3.on-error}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource md3.error}"/>
      </Style>
      <Style Selector="^.danger:pressed">
        <Setter Property="Background" Value="{DynamicResource md3.error}"/>
        <Setter Property="Foreground" Value="{DynamicResource md3.on-error}"/>
        <Setter Property="Opacity" Value="0.85"/>
      </Style>
      <Style Selector="^.linkButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="MinHeight" Value="24"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="Md3ListBoxItemTheme" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Background" Value="{DynamicResource md3.secondary-container}"/>
        <Setter Property="Foreground" Value="{DynamicResource md3.on-secondary-container}"/>
      </Style>
      <Style Selector="^:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource md3.secondary-container}"/>
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- 装主题：应用级 Style（同文件内的 StaticResource 必定解析得到） -->
  <Style Selector="Button">
    <Setter Property="Theme" Value="{StaticResource Md3ButtonTheme}"/>
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Theme" Value="{StaticResource Md3ListBoxItemTheme}"/>
  </Style>
</Styles>
