<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="using:OpenUtau.Theming">
  <!-- Spatial springs and effects use one live preference, including popup roots.
       Avalonia owns interpolation, interruption and lifetime; editor data is immediate. -->
  <Style Selector="Control"><Setter Property="motion:Md3Motion.Reduced" Value="{DynamicResource Md3ReducedMotion}"/></Style>
  <Style x:SetterTargetType="Visual" Selector=".md3-fade">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Transitions"><Transitions>
      <DoubleTransition Property="Opacity" Duration="{DynamicResource Md3MotionEffectsDefault}" Easing="{StaticResource Md3EffectsDefaultEasing}"/>
    </Transitions></Setter>
  </Style>
  <Style x:SetterTargetType="Visual" Selector=".md3-fade.shown"><Setter Property="Opacity" Value="1"/></Style>
  <Style x:SetterTargetType="Visual" Selector=".md3-pop">
    <Setter Property="Opacity" Value="0"/><Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="RenderTransform" Value="scale(0.96)"/>
    <Setter Property="Transitions"><Transitions>
      <DoubleTransition Property="Opacity" Duration="{DynamicResource Md3MotionEffectsDefault}" Easing="{StaticResource Md3EffectsDefaultEasing}"/>
      <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource Md3MotionSpatialFast}" Easing="{StaticResource Md3SpatialFastEasing}"/>
    </Transitions></Setter>
  </Style>
  <Style x:SetterTargetType="Visual" Selector=".md3-pop.shown"><Setter Property="Opacity" Value="1"/><Setter Property="RenderTransform" Value="scale(1)"/></Style>
  <Style x:SetterTargetType="Visual" Selector=".no-motion .md3-fade, .no-motion .md3-pop"><Setter Property="Transitions" Value="{x:Null}"/></Style>
  <Style Selector="Border.menuPopup:not(:reduced-motion)">
    <Style.Animations><Animation Duration="{DynamicResource Md3MotionEffectsFast}" Easing="{StaticResource Md3EffectsFastEasing}" FillMode="Forward">
      <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
      <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
    </Animation></Style.Animations>
  </Style>
  <Style Selector="Border.menuPopup:reduced-motion"><Setter Property="Opacity" Value="1"/></Style>
</Styles>
