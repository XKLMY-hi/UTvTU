<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base">
  <!--
    Suki 收敛层：必须在 SukiTheme 之后挂载（App.axaml Styles 尾部）。
    Suki 默认 Quicksand 15px 偏大、中文字体回退不佳 → 全局收束到 Plus 令牌
    （HarmonyOS Sans SC 13px），解决"整体偏大、控件被挤压、文字上下被裁切"。
    实例级样式优先于 ControlTheme 模板 Setter，可稳定覆盖 Suki 模板默认值。
    TextBox ControlTheme 自 PlusTheme 并入（阶段 C）：Suki 7.x 无 TextBox
    模板（只有 TextBoxExtensions 附加属性），仍由 Plus 模板接管。
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <!-- TextBox（v4.0）：PART_BorderElement/ScrollViewer/TextPresenter/Watermark 全保留。
           hover=边框提亮 · focus=accent 边框+焦点环 · disabled=降面降字。
           水印 IsVisible 用 TextPresenter.PreeditText+Text 双绑（与 Fluent 一致）。 -->
      <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
        <Setter Property="FontSize" Value="{DynamicResource PlusFontSizeBase}"/>
        <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceControl}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource PlusRadiusMd}"/>
        <Setter Property="MinHeight" Value="{DynamicResource PlusControlHeight}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PlusBrushTextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PlusBrushAccentSoft}"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="Template">
          <ControlTemplate>
            <DataValidationErrors>
              <Panel>
                <Border x:Name="PART_BorderElement"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        MinWidth="{TemplateBinding MinWidth}"
                        MinHeight="{TemplateBinding MinHeight}"
                        TemplatedControl.IsTemplateFocusTarget="True"/>
                <ScrollViewer x:Name="PART_ScrollViewer"
                              Margin="{TemplateBinding BorderThickness}"
                              Padding="{TemplateBinding Padding}"
                              ClipToBounds="True"
                              HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                              IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                              BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                  <Panel>
                    <TextBlock x:Name="PART_Watermark"
                               Text="{TemplateBinding Watermark}"
                               Foreground="{DynamicResource PlusBrushTextSecondary}"
                               TextAlignment="{TemplateBinding TextAlignment}"
                               TextWrapping="{TemplateBinding TextWrapping}"
                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                               IsHitTestVisible="False">
                      <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static data:BoolConverters.And}">
                          <Binding ElementName="PART_TextPresenter" Path="PreeditText"
                                   Converter="{x:Static data:StringConverters.IsNullOrEmpty}"/>
                          <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text"
                                   Converter="{x:Static data:StringConverters.IsNullOrEmpty}"/>
                        </MultiBinding>
                      </TextBlock.IsVisible>
                    </TextBlock>
                    <TextPresenter x:Name="PART_TextPresenter"
                                   Text="{TemplateBinding Text, Mode=TwoWay}"
                                   CaretBrush="{TemplateBinding CaretBrush}"
                                   CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                   CaretIndex="{TemplateBinding CaretIndex}"
                                   SelectionStart="{TemplateBinding SelectionStart}"
                                   SelectionEnd="{TemplateBinding SelectionEnd}"
                                   TextAlignment="{TemplateBinding TextAlignment}"
                                   TextWrapping="{TemplateBinding TextWrapping}"
                                   LineHeight="{TemplateBinding LineHeight}"
                                   LetterSpacing="{TemplateBinding LetterSpacing}"
                                   PasswordChar="{TemplateBinding PasswordChar}"
                                   RevealPassword="{TemplateBinding RevealPassword}"
                                   SelectionBrush="{TemplateBinding SelectionBrush}"
                                   SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                  </Panel>
                </ScrollViewer>
              </Panel>
            </DataValidationErrors>
          </ControlTemplate>
        </Setter>

        <!-- PointerOver：边框提亮 -->
        <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
          <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushBorderHover}"/>
        </Style>

        <!-- Focus：accent 边框 + 焦点环 -->
        <Style Selector="^:focus /template/ Border#PART_BorderElement">
          <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushBorderFocus}"/>
          <Setter Property="BoxShadow" Value="{DynamicResource PlusFocusRing}"/>
        </Style>

        <!-- Disabled：面降色 + 文字降色 + 水印降色 -->
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextDisabled}"/>
          <Style Selector="^ /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource PlusBrushSurfaceDisabled}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PlusBrushBorderDefault}"/>
          </Style>
          <Style Selector="^ /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{DynamicResource PlusBrushTextDisabled}"/>
          </Style>
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
  <!-- Foreground 显式绑定 TextFillColorPrimaryBrush（Brushes.axaml 提供，跟随 ForegroundColor 系）：
       Suki 的 TextBlock/Label/Expander ControlTheme 后挂覆盖 Fluent 默认值导致暗色下黑字
       （探针实证：Label/Expander 深色下 Foreground=Black） -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
  </Style>
  <Style Selector="Label">
    <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
  </Style>
  <Style Selector="Expander">
    <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
  </Style>
  <Style Selector="TreeView, TreeViewItem">
    <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/>
  </Style>
  <Style Selector="Menu, MenuItem, ContextMenu">
    <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource PlusFontSizeBase}"/>
  </Style>
  <Style Selector="Slider">
    <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource PlusFontSizeBase}"/>
  </Style>
  <Style Selector="TabControl, TabItem">
    <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource PlusFontSizeBase}"/>
  </Style>
</Styles>
