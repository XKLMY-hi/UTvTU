<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">false</system:Boolean>

  <!-- Warm gray light palette -->
  <!-- 窗口渐变背景（跟随主题色：底部微注入 accent ≈ 5%） -->



  <!-- Accent: warm red #B0C4DE -->
  <!-- PointerOver -->
  <!-- Pressed -->




  <!--Keyboard Background-->



  <!-- ════════ PlusTheme palette v4.0（覆写 Plus.Resources 默认）════════ -->
  <!-- Surface 实色 8 档 -->
  <!-- 对话框卡片（Suki GlassCard 同款质感：亮色近白） -->
  <!-- Border -->
  <Color x:Key="PlusBorderSubtle">#d0ccc8</Color>
  <Color x:Key="PlusBorderDefault">#c8c4c0</Color>
  <Color x:Key="PlusBorderHover">#a09890</Color>
  <Color x:Key="PlusBorderFocus">#B0C4DE</Color>
  <Color x:Key="PlusBorderGlass">#1A000000</Color>
  <Color x:Key="PlusBorderGlassStrong">#2A000000</Color>
  <!-- Accent -->
  <Color x:Key="PlusAccent">#B0C4DE</Color>
  <Color x:Key="PlusAccentHover">#BED4EE</Color>
  <Color x:Key="PlusAccentPressed">#9BABC1</Color>
  <Color x:Key="PlusAccentMuted">#1FB0C4DE</Color>
  <Color x:Key="PlusAccentSoft">#33B0C4DE</Color>
  <Color x:Key="PlusAccentGlow">#4DB0C4DE</Color>
  <!-- Text -->
  <Color x:Key="PlusTextPrimary">#1a1a20</Color>
  <Color x:Key="PlusTextSecondary">#6a6a74</Color>
  <Color x:Key="PlusTextDisabled">#909098</Color>
  <Color x:Key="PlusTextOnAccent">#ffffff</Color>
  <!-- Semantic -->
  <Color x:Key="PlusSemanticSuccess">#2e7d32</Color>
  <Color x:Key="PlusSemanticWarning">#b26a00</Color>
  <Color x:Key="PlusSemanticWarningBg">#fff4ce</Color>
  <Color x:Key="PlusSemanticDanger">#d32f2f</Color>
  <Color x:Key="PlusSemanticInfo">#1976d2</Color>
  <!-- Glass（仅浮层） -->
  <Color x:Key="PlusGlassCard">#EBF5F2F0</Color>
  <Color x:Key="PlusGlassPopover">#F0F5F2F0</Color>
  <Color x:Key="PlusGlassBackdrop">#66000000</Color>
  <Color x:Key="PlusGlassHeader">#99FFFFFF</Color>
  <Color x:Key="PlusGlassInsetBottom">#14000000</Color>
</ResourceDictionary>
