<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
  <!--
    PlusTheme 令牌层 v4.0
    ────────────────────────────────────────────────────────────
    Layer 1 = palette（可主题化 Color）：Plus* 颜色键。本文件提供 DARK 默认值兜底，
              实际值由 Colors/DarkTheme|LightTheme|CustomTheme.axaml 主题字典覆写。
    Layer 2 = 语义画刷（PlusBrush*）+ 固定几何/动效（PlusRadius*/PlusElevation*...）。
              固定值只在此定义，不随主题切换。
    Layer 3 = 控件模板/视图，全部 {DynamicResource Plus*}，禁止字面量。
    设计纪律：背景实色 + 主题色渐变（底部微注入 accent）；玻璃只用于浮层；
              hover=表面提亮；选中=accent-muted。
    ────────────────────────────────────────────────────────────
  -->

  <system:Boolean x:Key="IsDarkMode">false</system:Boolean>

  <!-- ══════════ Layer 1 · palette 颜色（DARK 默认，主题字典覆写）══════════ -->
  <!-- 窗口渐变背景两档（跟随主题色：底部微注入 accent，主题字典覆写） -->
  <!-- Surface 实色 8 档 -->

  <!-- Border 4 + 玻璃描边 -->
  <Color x:Key="PlusBorderSubtle">#2a2a3a</Color>
  <Color x:Key="PlusBorderDefault">#383848</Color>
  <Color x:Key="PlusBorderHover">#484868</Color>
  <Color x:Key="PlusBorderFocus">#B0C4DE</Color>
  <Color x:Key="PlusBorderGlass">#14FFFFFF</Color>        <!-- 玻璃面板外描边 -->
  <Color x:Key="PlusBorderGlassStrong">#1FB0C4DE</Color>  <!-- 浮起玻璃描边 -->

  <!-- Accent 3 实色 + 3 透明 -->
  <Color x:Key="PlusAccent">#B0C4DE</Color>
  <Color x:Key="PlusAccentHover">#BED4EE</Color>
  <Color x:Key="PlusAccentPressed">#9BABC1</Color>
  <Color x:Key="PlusAccentMuted">#1FB0C4DE</Color>   <!-- 选中底 · α.12 -->
  <Color x:Key="PlusAccentSoft">#33B0C4DE</Color>    <!-- 描边 · 次级强调 · α.20 -->
  <Color x:Key="PlusAccentGlow">#4DB0C4DE</Color>    <!-- 主按钮 focus 泛光 · α.30 -->

  <!-- Text 4 档 -->
  <Color x:Key="PlusTextPrimary">#f0f0f0</Color>
  <Color x:Key="PlusTextSecondary">#a0a0b0</Color>
  <Color x:Key="PlusTextDisabled">#585868</Color>
  <Color x:Key="PlusTextOnAccent">#ffffff</Color>

  <!-- Semantic 5 档（仅状态提示，绝不做轨道色） -->
  <Color x:Key="PlusSemanticSuccess">#4caf50</Color>
  <Color x:Key="PlusSemanticWarning">#ff9800</Color>
  <Color x:Key="PlusSemanticWarningBg">#4a3520</Color>
  <Color x:Key="PlusSemanticDanger">#e53935</Color>
  <Color x:Key="PlusSemanticInfo">#5b9bd5</Color>

  <!-- Glass 5 个（仅浮层用） -->
  <Color x:Key="PlusGlassCard">#EB1E2028</Color>          <!-- 弹窗/面板 · .92 -->
  <Color x:Key="PlusGlassPopover">#F0262632</Color>       <!-- 菜单/下拉/tooltip · .94 -->
  <Color x:Key="PlusGlassBackdrop">#80000000</Color>      <!-- 弹窗遮罩 -->
  <Color x:Key="PlusGlassHeader">#0DFFFFFF</Color>        <!-- 顶部高光带 -->
  <Color x:Key="PlusGlassInsetBottom">#24000000</Color>   <!-- 底部内阴影 -->

  <!-- legacy 33 键暗色默认（变体未设时的启动兜底；Brushes.axaml 依赖这些键解析） -->

  <!-- ══════════ Layer 2 · 语义画刷（映射 palette → 消费）══════════ -->
  <!-- 窗口背景：顶部 base → 底部 accent 注入（跟随主题色；GradientStop 动态资源随主题字典切换） -->
  <LinearGradientBrush x:Key="PlusBrushWindowBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="{DynamicResource md3.color.surface-container-lowest}"/>
    <GradientStop Offset="0.55" Color="{DynamicResource md3.color.surface}"/>
    <GradientStop Offset="1" Color="{DynamicResource md3.color.surface-container-low}"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="PlusBrushSurfaceDeep" Color="{DynamicResource md3.color.surface-container-lowest}"/>
  <SolidColorBrush x:Key="PlusBrushSurfaceBase" Color="{DynamicResource md3.color.surface}"/>
  <SolidColorBrush x:Key="PlusBrushSurfaceRaised" Color="{DynamicResource md3.color.surface-container}"/>
  <SolidColorBrush x:Key="PlusBrushSurfaceControl" Color="{DynamicResource md3.color.surface-container-high}"/>
  <SolidColorBrush x:Key="PlusBrushSurfaceHover" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="PlusBrushSurfacePressed" Color="{DynamicResource md3.color.surface-container-highest}"/>
  <SolidColorBrush x:Key="PlusBrushSurfaceDisabled" Color="{DynamicResource md3.color.surface-container-low}"/>
  <SolidColorBrush x:Key="PlusBrushBorderSubtle" Color="{DynamicResource PlusBorderSubtle}"/>
  <SolidColorBrush x:Key="PlusBrushBorderDefault" Color="{DynamicResource PlusBorderDefault}"/>
  <SolidColorBrush x:Key="PlusBrushBorderHover" Color="{DynamicResource PlusBorderHover}"/>
  <SolidColorBrush x:Key="PlusBrushBorderFocus" Color="{DynamicResource PlusBorderFocus}"/>
  <SolidColorBrush x:Key="PlusBrushTextPrimary" Color="{DynamicResource PlusTextPrimary}"/>
  <SolidColorBrush x:Key="PlusBrushTextSecondary" Color="{DynamicResource PlusTextSecondary}"/>
  <SolidColorBrush x:Key="PlusBrushTextDisabled" Color="{DynamicResource PlusTextDisabled}"/>
  <SolidColorBrush x:Key="PlusBrushTextOnAccent" Color="{DynamicResource PlusTextOnAccent}"/>
  <SolidColorBrush x:Key="PlusBrushAccent" Color="{DynamicResource PlusAccent}"/>
  <SolidColorBrush x:Key="PlusBrushAccentHover" Color="{DynamicResource PlusAccentHover}"/>
  <SolidColorBrush x:Key="PlusBrushAccentPressed" Color="{DynamicResource PlusAccentPressed}"/>
  <SolidColorBrush x:Key="PlusBrushAccentMuted" Color="{DynamicResource PlusAccentMuted}"/>
  <SolidColorBrush x:Key="PlusBrushAccentSoft" Color="{DynamicResource PlusAccentSoft}"/>
  <SolidColorBrush x:Key="PlusBrushGlassCard" Color="{DynamicResource PlusGlassCard}"/>
  <SolidColorBrush x:Key="PlusBrushGlassPopover" Color="{DynamicResource PlusGlassPopover}"/>
  <SolidColorBrush x:Key="PlusBrushBorderGlass" Color="{DynamicResource PlusBorderGlass}"/>
  <SolidColorBrush x:Key="PlusBrushBorderGlassStrong" Color="{DynamicResource PlusBorderGlassStrong}"/>
  <SolidColorBrush x:Key="PlusBrushSemanticSuccess" Color="{DynamicResource PlusSemanticSuccess}"/>
  <SolidColorBrush x:Key="PlusBrushSemanticWarning" Color="{DynamicResource PlusSemanticWarning}"/>
  <SolidColorBrush x:Key="PlusBrushSemanticDanger" Color="{DynamicResource PlusSemanticDanger}"/>
  <SolidColorBrush x:Key="PlusBrushSemanticInfo" Color="{DynamicResource PlusSemanticInfo}"/>

  <!-- ══════════ Layer 2 · 固定几何令牌（不随主题切换）══════════ -->
  <!-- Radii -->
  <CornerRadius x:Key="PlusRadiusXs">4</CornerRadius>
  <CornerRadius x:Key="PlusRadiusSm">6</CornerRadius>
  <CornerRadius x:Key="PlusRadiusMd">8</CornerRadius>
  <CornerRadius x:Key="PlusRadiusLg">12</CornerRadius>
  <CornerRadius x:Key="PlusRadiusXl">16</CornerRadius>
  <CornerRadius x:Key="PlusRadiusPill">999</CornerRadius>

  <!-- Sizing -->
  <system:Double x:Key="PlusControlHeight">32</system:Double>
  <system:Double x:Key="PlusControlHeightSmall">24</system:Double>
  <system:Double x:Key="PlusControlHeightLarge">40</system:Double>
  <system:Double x:Key="PlusIconSize">18</system:Double>

  <!-- Spacing (4px 基准) -->
  <Thickness x:Key="PlusSpace1">4</Thickness>
  <Thickness x:Key="PlusSpace2">8</Thickness>
  <Thickness x:Key="PlusSpace3">12</Thickness>
  <Thickness x:Key="PlusSpace4">16</Thickness>
  <Thickness x:Key="PlusSpace5">20</Thickness>
  <Thickness x:Key="PlusSpace6">24</Thickness>
  <Thickness x:Key="PlusSpace8">32</Thickness>

  <!-- Typography -->
  <system:Double x:Key="PlusFontSizeXs">10</system:Double>
  <system:Double x:Key="PlusFontSizeSm">11</system:Double>
  <system:Double x:Key="PlusFontSizeBase">13</system:Double>
  <system:Double x:Key="PlusFontSizeMd">14</system:Double>
  <system:Double x:Key="PlusFontSizeLg">16</system:Double>
  <system:Double x:Key="PlusFontSizeXl">20</system:Double>
  <system:Double x:Key="PlusFontSize2Xl">24</system:Double>

  <!-- 字体（Language 文件可覆写本地化栈） -->
  <FontFamily x:Key="PlusFontFamily">HarmonyOS Sans SC, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
  <FontFamily x:Key="PlusFontFamilyMono">Cascadia Code, Consolas, Fira Code, Courier New</FontFamily>

  <!-- ══════════ Layer 2 · 固定阴影/焦点/辉光（BoxShadows 资源，Control.BoxShadow 为复数类型）══════════ -->
  <BoxShadows x:Key="PlusElevationContact">0 0 2 0 #40000000</BoxShadows>
  <BoxShadows x:Key="PlusElevationFloat">0 2 8 0 #4D000000</BoxShadows>
  <BoxShadows x:Key="PlusElevationRaised">0 6 20 0 #61000000</BoxShadows>
  <BoxShadows x:Key="PlusElevationPopup">0 12 32 0 #80000000</BoxShadows>
  <BoxShadows x:Key="PlusHighlightTop">inset 0 1 0 0 #0FFFFFFF</BoxShadows>
  <BoxShadows x:Key="PlusHighlightTopStrong">inset 0 1 0 0 #1AFFFFFF</BoxShadows>
  <BoxShadows x:Key="PlusShadowBottom">inset 0 -1 0 0 #24000000</BoxShadows>
  <BoxShadows x:Key="PlusFocusRing">0 0 0 3 #33B0C4DE</BoxShadows>
  <!-- 1px 亮边(spread) + 10px 泛光(blur) 两段合一 -->
  <BoxShadows x:Key="PlusGlowPrimary">0 0 0 1 #8CB0C4DE, 0 0 10 0 #47B0C4DE</BoxShadows>
  <BoxShadows x:Key="PlusGlowDanger">0 0 0 1 #80FF7874, 0 0 10 0 #47FF7874</BoxShadows>

  <!-- ══════════ Fluent 兼容几何键（删除 Fluent 前预备）══════════ -->
  <system:Double x:Key="SliderHorizontalThumbWidth">16</system:Double>
  <system:Double x:Key="SliderHorizontalThumbHeight">16</system:Double>
  <system:Double x:Key="ControlContentThemeFontSize">13</system:Double>
  <system:Double x:Key="ComboBoxThemeMinWidth">120</system:Double>
  <system:Double x:Key="ComboBoxMinHeight">32</system:Double>
</ResourceDictionary>
