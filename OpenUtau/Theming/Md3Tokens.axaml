<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="using:OpenUtau.Theming" xmlns:sys="using:System">
  <!-- M3 shape scale; the separate 6-DIP DAW shape is reserved for dense editing controls. -->
  <CornerRadius x:Key="Md3ShapeNone">0</CornerRadius>
  <CornerRadius x:Key="Md3ShapeExtraSmall">4</CornerRadius>
  <CornerRadius x:Key="Md3DawCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="Md3ShapeSmall">8</CornerRadius>
  <CornerRadius x:Key="Md3ShapeMedium">12</CornerRadius>
  <CornerRadius x:Key="Md3ShapeLarge">16</CornerRadius>
  <CornerRadius x:Key="Md3ShapeExtraLarge">28</CornerRadius>
  <CornerRadius x:Key="Md3ShapeFull">999</CornerRadius>
  <!-- Page typography and an explicitly compact desktop body/label scale. -->
  <x:Double x:Key="Md3TypeDisplaySmall">36</x:Double>
  <x:Double x:Key="Md3TypeHeadlineMedium">28</x:Double>
  <x:Double x:Key="Md3TypeHeadlineSmall">24</x:Double>
  <x:Double x:Key="Md3TypeTitleLarge">22</x:Double>
  <x:Double x:Key="Md3TypeTitleMedium">16</x:Double>
  <x:Double x:Key="Md3TypeTitleSmall">14</x:Double>
  <x:Double x:Key="Md3TypeBodyLarge">14</x:Double>
  <x:Double x:Key="Md3TypeBodyMedium">13</x:Double>
  <x:Double x:Key="Md3TypeBodySmall">12</x:Double>
  <x:Double x:Key="Md3TypeLabelLarge">13</x:Double>
  <x:Double x:Key="Md3TypeLabelMedium">12</x:Double>
  <x:Double x:Key="Md3TypeLabelSmall">11</x:Double>
  <x:Double x:Key="Md3TypeLabelTiny">10</x:Double>
  <x:Double x:Key="Md3ControlHeight">40</x:Double>
  <x:Double x:Key="Md3WorkspaceControlHeight">40</x:Double>
  <x:Double x:Key="Md3CompactControlHeight">32</x:Double>
  <x:Double x:Key="Md3DenseControlHeight">24</x:Double>
  <x:Double x:Key="Md3Spacing1">4</x:Double>
  <x:Double x:Key="Md3Spacing2">8</x:Double>
  <x:Double x:Key="Md3Spacing3">12</x:Double>
  <x:Double x:Key="Md3Spacing4">16</x:Double>
  <x:Double x:Key="Md3Spacing6">24</x:Double>
  <x:Double x:Key="Md3Spacing8">32</x:Double>
  <Thickness x:Key="Md3PagePadding">24</Thickness>
  <Thickness x:Key="Md3CardPadding">16</Thickness>
  <Thickness x:Key="Md3ButtonPadding">24,0</Thickness>
  <Thickness x:Key="Md3CompactButtonPadding">16,0</Thickness>
  <sys:Boolean x:Key="Md3ReducedMotion">False</sys:Boolean>
  <sys:TimeSpan x:Key="Md3MotionEffectsFast">0:0:0.150</sys:TimeSpan>
  <sys:TimeSpan x:Key="Md3MotionEffectsDefault">0:0:0.231</sys:TimeSpan>
  <sys:TimeSpan x:Key="Md3MotionEffectsSlow">0:0:0.327</sys:TimeSpan>
  <sys:TimeSpan x:Key="Md3MotionSpatialFast">0:0:0.230</sys:TimeSpan>
  <sys:TimeSpan x:Key="Md3MotionSpatialDefault">0:0:0.325</sys:TimeSpan>
  <sys:TimeSpan x:Key="Md3MotionSpatialSlow">0:0:0.496</sys:TimeSpan>
  <motion:Md3StandardSpringEasing x:Key="Md3SpatialFastEasing" Stiffness="1400" Damping="0.9"/>
  <motion:Md3StandardSpringEasing x:Key="Md3SpatialDefaultEasing" Stiffness="700" Damping="0.9"/>
  <motion:Md3StandardSpringEasing x:Key="Md3SpatialSlowEasing" Stiffness="300" Damping="0.9"/>
  <motion:Md3StandardSpringEasing x:Key="Md3EffectsFastEasing" Stiffness="3800" Damping="1"/>
  <motion:Md3StandardSpringEasing x:Key="Md3EffectsDefaultEasing" Stiffness="1600" Damping="1"/>
  <motion:Md3StandardSpringEasing x:Key="Md3EffectsSlowEasing" Stiffness="800" Damping="1"/>
</ResourceDictionary>
