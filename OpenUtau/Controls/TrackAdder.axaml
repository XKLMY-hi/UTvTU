<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OpenUtau.App.Controls"
             x:Class="OpenUtau.App.Controls.TrackAdder" Width="300" Height="104">
  <Border Margin="8,4">
    <Button Theme="{StaticResource DawButtonTheme}" VerticalAlignment="Center" HorizontalAlignment="Stretch"
            Height="28" MinHeight="0" Padding="8,0" CornerRadius="4" Click="ButtonClicked"
            BorderThickness="1" BorderBrush="{DynamicResource md3.outline-variant}"
            AutomationProperties.Name="{DynamicResource command.track.add}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <c:DawIcon Width="12" Height="12" Data="{StaticResource icon-plus}" Fill="{Binding $parent[Button].Foreground}"/>
        <TextBlock FontSize="11" Text="{DynamicResource command.track.add}"/>
      </StackPanel>
    </Button>
  </Border>
</UserControl>
