<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OpenUtau.App.Controls"
             x:Class="OpenUtau.App.Controls.MixerControl"
             x:Name="MixerRoot">
  <!-- 通道区与主输出占用全部宽度；效果器通过工具栏或通道 FX 进入共享底栏。 -->
  <UserControl.Styles>
    <!-- 链面板折叠键（宿主侧 chevron，W19）：范式抄 W16 的 Button.panelToggle，但那份样式在
         MainWindow.axaml 里（分离窗下不生效），所以这里自带一份；MinHeight/Margin 显式压掉，
         否则被全局 Md3ButtonTheme 的 MinHeight=32 与应用级 Button.Margin=0,4 顶大（W10 教训）。 -->
    <Style Selector="Button.chainToggle">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeExtraSmall}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.chainToggle:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*"
        Background="{DynamicResource md3.surface-container-lowest}">

    <!-- 工具行：＋轨道（既有入口）+ 轨道数 + 链面板折叠键（折叠后仍可展开的唯一入口，必须常驻） -->
    <Border Grid.Row="0" Padding="16,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <!-- 28 高工具行（设计稿无此元素，spec-digest C-6 自定）：MinHeight 必须显式压到 28，
             否则全局 Md3ButtonTheme 的 MinHeight=32 会把 Height 顶成 32；Margin 必须清零，
             否则应用级 `Button { Margin: 0,4 }`（Styles.axaml:159）再撑 8px。 -->
        <Button Grid.Column="0" Name="AddTrackBtn" Theme="{StaticResource DawTextButtonTheme}" Height="28" MinHeight="28" Margin="0" CornerRadius="{DynamicResource Md3ShapeFull}"
                Padding="12,0" FontSize="{DynamicResource Md3TypeLabelSmall}" FontWeight="SemiBold"
                Content="{DynamicResource mixer.addtrack}" Click="OnAddTrackClick"
                Background="{DynamicResource md3.surface-container-high}"
                Foreground="{DynamicResource md3.on-surface-variant}"
                BorderThickness="0"/>
        <TextBlock Grid.Column="2" Name="StatusText" FontSize="{DynamicResource Md3TypeLabelTiny}" VerticalAlignment="Center"
                   Foreground="{DynamicResource md3.on-surface-variant}"/>
        <Button Grid.Column="3" Name="ChainToggleBtn" Theme="{StaticResource DawTextButtonTheme}" Margin="12,0,0,0" Height="28" MinHeight="28" Click="OnToggleChainPanel" Content="{DynamicResource rack.open}"/>

      </Grid>
    </Border>

    <!-- Mixer Area（42：内边距 16 / 间距 8 / 横向排列） -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Name="MixerBody">
      <Border Grid.Column="0" Name="ChannelViewport" Margin="0,16,0,16">
        <ScrollViewer Grid.Column="0" Name="StripsScroll"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <StackPanel Name="TrackStripsPanel" Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing2}"
                      Margin="16,0,8,0" HorizontalAlignment="Left">
            <!-- 通道条按轨道动态生成 -->
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- 主输出条（691：宽 160，固定在最右的滚动区之外） -->
      <ScrollViewer Name="MasterScroll" Grid.Column="1" Margin="0,16,16,16"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <c:MasterStrip Grid.Column="1" x:Name="MasterStripControl" Margin="0"
                       Height="{Binding #MasterScroll.Viewport.Height}"/>
      </ScrollViewer>

    </Grid>
  </Grid>
</UserControl>
