<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OpenUtau.App.Controls"
             x:Class="OpenUtau.App.Controls.MixerControl"
             x:Name="MixerRoot">
  <!--
    混音台（设计规格 Mixer.txt:42 起的 Mixer Area + 691-736 主输出条）。
    · Mixer Area：内边距 16、通道条间距 8；12×96 + 160 + 12×8 = 1408 ⇒ 横向必然滚动；
    · 主输出条固定在滚动区之外（沿用上一轮的 E5 决定：主推子不随轨道滚走）；
    · 效果链叠放在通道区右上方，按内容收缩高度；展开/收起均不预留侧栏宽度。
      沿用 PanelSplitter 的调宽、折叠和持久化；主输出条不在浮层之内。
    · 工具行（＋轨道 / 轨道数 / 链面板折叠键）设计稿里没有，属既有功能入口（spec-digest §7.3 C-6），
      压成一行 28 高；颜色全部走 md3.* 角色键。
  -->
  <UserControl.Styles>
    <!-- 效果链开合键：范式抄 W16 的 Button.panelToggle，但那份样式在
         MainWindow.axaml 里（分离窗下不生效），所以这里自带一份；MinHeight/Margin 显式压掉，
         否则被全局 Md3ButtonTheme 的 MinHeight=32 与应用级 Button.Margin=0,4 顶大（W10 教训）。 -->
    <Style Selector="Button.chainToggle">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeExtraSmall}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.chainToggle:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>
    <Style Selector="Button.chainToggle.floatingOpen">
      <Setter Property="Background" Value="{DynamicResource md3.secondary-container}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-secondary-container}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*"
        Background="{DynamicResource md3.surface-container-lowest}">

    <!-- 工具行：＋轨道（既有入口）+ 轨道数 + 链面板折叠键（折叠后仍可展开的唯一入口，必须常驻） -->
    <Border Grid.Row="0" Padding="16,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <!-- 28 高工具行（设计稿无此元素，spec-digest C-6 自定）：MinHeight 必须显式压到 28，
             否则全局 Md3ButtonTheme 的 MinHeight=32 会把 Height 顶成 32；Margin 必须清零，
             否则应用级 `Button { Margin: 0,4 }`（Styles.axaml:159）再撑 8px。 -->
        <Button Grid.Column="0" Name="AddTrackBtn" Theme="{StaticResource DawTextButtonTheme}" Height="28" MinHeight="28" Margin="0" CornerRadius="{DynamicResource Md3ShapeFull}"
                Padding="12,0" FontSize="{DynamicResource Md3TypeLabelSmall}" FontWeight="SemiBold"
                Content="{DynamicResource mixer.addtrack}" Click="OnAddTrackClick"
                Background="{DynamicResource md3.surface-container-high}"
                Foreground="{DynamicResource md3.on-surface-variant}"
                BorderThickness="0"/>
        <TextBlock Grid.Column="2" Name="StatusText" FontSize="{DynamicResource Md3TypeLabelTiny}" VerticalAlignment="Center"
                   Foreground="{DynamicResource md3.on-surface-variant}"/>
        <Button Grid.Column="3" Name="ChainToggleBtn" Theme="{StaticResource DawButtonTheme}" Classes="chainToggle" Margin="8,0,0,0"
                Click="OnToggleChainPanel" ToolTip.Tip="{DynamicResource fxchain.floating.toggle}"
                AutomationProperties.Name="{DynamicResource fxchain.floating.toggle}"
                DataContext="{Binding #MixerRoot.ChainPanel}" Classes.floatingOpen="{Binding !IsCollapsed}">
          <c:DawIcon Data="{StaticResource icon-equalizer}" Width="14" Height="14"
                     Fill="{Binding $parent[Button].Foreground}"/>
        </Button>
      </Grid>
    </Border>

    <!-- Mixer Area（42：内边距 16 / 间距 8 / 横向排列） -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Name="MixerBody">
      <ScrollViewer Grid.Column="0" Name="StripsScroll"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Name="TrackStripsPanel" Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing2}"
                    Margin="16,16,8,16" HorizontalAlignment="Left">
          <!-- 通道条按轨道动态生成 -->
        </StackPanel>
      </ScrollViewer>

      <!-- 主输出条（691：宽 160，固定在最右的滚动区之外） -->
      <c:MasterStrip Grid.Column="1" x:Name="MasterStripControl" Margin="0,16,16,16"/>

      <!-- 收起后保留边缘展开入口；覆盖层不参与通道列的宽度分配。 -->
      <Panel Grid.Column="0" ZIndex="10" IsHitTestVisible="True">
        <c:PanelRevealTab x:Name="ChainRevealTab"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                          IsVisible="{Binding #MixerRoot.ChainPanel.IsCollapsed}"
                          AnchorRight="True"
                          GlyphData="{StaticResource icon-equalizer}"
                          PanelLabel="{DynamicResource panel.collapse.fxchain}"
                          Hint="{DynamicResource panel.collapse.fxchain}"
                          HintSuffix="{DynamicResource panel.expand.hint}"
                          ExpandRequested="OnRevealChainPanel"/>
      </Panel>

      <!-- 独立浮层：仅覆盖通道区，主输出固定列保持可见。
           PanelColumn=2 排除卡片自身占用；CenterMin=0，浮层无需为通道预留侧栏空间。
           调宽沿用既有分隔条，拖动结束/双击复位由原处理器持久化。 -->
      <Grid Name="FxFloatingLayer" Grid.Column="0" ColumnDefinitions="*,Auto,Auto"
            Margin="16" ZIndex="20">
        <c:PanelSplitter Grid.Column="1" x:Name="FxChainSplitter"
                         DataContext="{Binding #MixerRoot.ChainPanel}" IsVisible="{Binding !IsCollapsed}"
                         PanelColumn="2" Invert="True" Min="264" Max="480" DefaultWidth="280" CenterMin="0"
                         Target="{Binding Width, Mode=TwoWay}" DragCompleted="OnChainPanelDragCompleted"
                         ToolTip.Tip="{DynamicResource panel.drag.hint}"
                         VerticalAlignment="Top" Height="48" Margin="0,40,4,0" Opacity="0.7"/>
        <Border Name="FloatingFxCard" Grid.Column="2"
                Width="{Binding #FxChainSplitter.PanelWidth}" IsVisible="{Binding #FxChainSplitter.PanelShown}"
                MaxHeight="{Binding #FxFloatingLayer.Bounds.Height}" VerticalAlignment="Top"
                CornerRadius="{DynamicResource Md3ShapeLarge}" BorderThickness="1"
                BorderBrush="{DynamicResource md3.outline-variant}"
                Background="{DynamicResource md3.surface-container-high}" BoxShadow="{DynamicResource Md3ElevationLevel3}">
          <Border CornerRadius="15" ClipToBounds="True">
            <Grid RowDefinitions="36,*">
              <Grid ColumnDefinitions="*,Auto" Margin="12,2,6,2">
                <TextBlock Text="{DynamicResource fxchain.floating.title}" FontSize="{DynamicResource Md3TypeLabelMedium}"
                           FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource md3.on-surface-variant}"/>
                <Button Name="CloseFxCard" Grid.Column="1" Theme="{StaticResource DawButtonTheme}"
                        Width="28" Height="28" MinHeight="0" Margin="0" Padding="0" CornerRadius="8"
                        Click="OnToggleChainPanel" ToolTip.Tip="{DynamicResource fxchain.floating.close}"
                        AutomationProperties.Name="{DynamicResource fxchain.floating.close}">
                  <c:DawIcon Data="{StaticResource icon-x}" Width="14" Height="14" Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
              </Grid>
              <!-- 复用原效果链实例及选择、拖入、排序、开关等逻辑。 -->
              <ContentControl Grid.Row="1" Name="FxChainHost" IsVisible="{Binding #FxChainSplitter.PanelShown}"/>
            </Grid>
          </Border>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
