<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenUtau.App.Controls.MasterStrip"
             Width="160">
  <!--
    主输出条（设计规格 .opencode/design/spec/Mixer.txt:691-736）：
    宽 160 / 内边距 8 / 圆角 12 / 列间距 6；名称 12 bold + 副标题 8；
    Bus Info 四行（容器 padding 10 / gap 8 / 圆角 8，每行高 14：标签 8 + 值 9）；
    推子区 144×500（**双表** 10 宽 left 24 / 38、轨 4 宽 left 74、柄 24×16 left 64、刻度 9 条 left 96）；
    峰值读数 13px semibold。
    设计稿里主输出**没有**插入区 / EQ 屏 / 声像 / M/S/R（spec-digest §8 第 23 条）。
    **有意偏离（W1b / task-17）**：名称行右侧加回一个主输出静音键 —— 设计稿缺此元素，
    但 `PlaybackManager.SetMasterMuted` 会因此失去唯一 UI 入口（功能回归），按 R19 精神保留入口：
    视觉沿用通道条 M 键语言（高 20 / 圆角 4 / 10px bold），并入名称行不新增独立行（竖向余量仅 ≈8px）。
    Bus Info 的四个值：能取真值就取真值，取不到的显示占位或**当前导出设置的状态文本**，
    绝不编数（规划 R5、spec-digest §6）——每一项都带 ToolTip 说明来源。
  -->
  <UserControl.Styles>
    <!-- 主输出静音键（W1b）：与通道条 M 键同语言，仅底/字色走 master 条高一档的底色 -->
    <Style Selector="Button.masterMuteBtn">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>
    <Style Selector="Button.masterMuteBtn.muteOn">
      <Setter Property="Background" Value="{DynamicResource md3.error}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-error}"/>
    </Style>
  </UserControl.Styles>
  <Border Name="MasterCard" Padding="8" CornerRadius="12"
          Background="{DynamicResource md3.surface-container-high}">
    <Grid Name="RootGrid" RowSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">

      <!-- 692 · 强调色条 -->
      <Border Grid.Row="0" Name="MasterAccentBar" Height="3" CornerRadius="999"
              HorizontalAlignment="Stretch" Background="{DynamicResource md3.primary}"/>

      <!-- 693 · 名称 12px bold（右侧：主输出静音 —— 设计稿无此键，见文件头「有意偏离」） -->
      <Grid Grid.Row="1" Name="MasterNameRow" ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBlock Name="MasterNameLabel" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource md3.on-surface}"
                   Text="{DynamicResource mixer.master}"/>
        <Button Grid.Column="1" Name="MuteBtn" Classes="masterMuteBtn" Width="24" Height="20"
                CornerRadius="4" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                Content="{DynamicResource mixer.mute}" Click="OnMuteClick"/>
      </Grid>

      <!-- 695 · 副标题 8px -->
      <TextBlock Grid.Row="2" Name="MasterSubtitleLabel" FontSize="8"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource md3.on-surface-variant}"
                 Text="{DynamicResource mixer.bus.subtitle}"/>

      <!-- 697 · Bus Info：四行参数（容器满宽 / padding 10 / gap 8 / 圆角 8；底 = surface-container-lowest） -->
      <Border Grid.Row="3" Name="BusInfo" Padding="10" CornerRadius="8"
              Background="{DynamicResource md3.surface-container-lowest}">
        <Grid RowSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto">
          <Grid Grid.Row="0" Name="BusRowIntegrated" Height="14" ColumnDefinitions="Auto,*">
            <TextBlock Name="IntegratedLabel" FontSize="8" VerticalAlignment="Center"
                       Foreground="{DynamicResource md3.on-surface-variant}"
                       Text="{DynamicResource mixer.bus.integrated}"/>
            <TextBlock Grid.Column="1" Name="IntegratedValue" FontSize="9" VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource md3.on-surface}" Text="—"/>
          </Grid>
          <Grid Grid.Row="1" Name="BusRowTruePeak" Height="14" ColumnDefinitions="Auto,*">
            <TextBlock Name="TruePeakLabel" FontSize="8" VerticalAlignment="Center"
                       Foreground="{DynamicResource md3.on-surface-variant}"
                       Text="{DynamicResource mixer.bus.truepeak}"/>
            <TextBlock Grid.Column="1" Name="TruePeakValue" FontSize="9" VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource md3.on-surface}" Text="—"/>
          </Grid>
          <Grid Grid.Row="2" Name="BusRowLimiter" Height="14" ColumnDefinitions="Auto,*">
            <TextBlock Name="LimiterLabel" FontSize="8" VerticalAlignment="Center"
                       Foreground="{DynamicResource md3.on-surface-variant}"
                       Text="{DynamicResource mixer.bus.limiter}"/>
            <TextBlock Grid.Column="1" Name="LimiterValue" FontSize="9" VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource md3.on-surface}" Text="—"/>
          </Grid>
          <Grid Grid.Row="3" Name="BusRowDither" Height="14" ColumnDefinitions="Auto,*">
            <TextBlock Name="DitherLabel" FontSize="8" VerticalAlignment="Center"
                       Foreground="{DynamicResource md3.on-surface-variant}"
                       Text="{DynamicResource mixer.bus.dither}"/>
            <TextBlock Grid.Column="1" Name="DitherValue" FontSize="9" VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource md3.on-surface}" Text="—"/>
          </Grid>
        </Grid>
      </Border>

      <!-- 718 · 弹性空白 -->
      <Border Grid.Row="4" Name="ChannelSpacer"/>

      <!-- 719-734 · 推子区 144×500（双表 10 宽 left 24/38、轨 4 宽 left 74、柄 24×16 left 64、刻度 9 条 left 96） -->
      <Canvas Grid.Row="5" Name="FaderBox" Width="144" Height="500"
              PointerPressed="OnFaderPressed" PointerMoved="OnFaderMoved">
        <Border Name="MeterBarL" Width="10" Height="500" Canvas.Left="24" Canvas.Top="0"
                CornerRadius="999" ClipToBounds="True"
                Background="{DynamicResource md3.surface-container-highest}">
          <Border Name="MeterFillL" Width="10" Height="0" CornerRadius="999"
                  VerticalAlignment="Bottom" Background="{DynamicResource md3.primary}"/>
        </Border>
        <Border Name="MeterBarR" Width="10" Height="500" Canvas.Left="38" Canvas.Top="0"
                CornerRadius="999" ClipToBounds="True"
                Background="{DynamicResource md3.surface-container-highest}">
          <Border Name="MeterFillR" Width="10" Height="0" CornerRadius="999"
                  VerticalAlignment="Bottom" Background="{DynamicResource md3.primary}"/>
        </Border>
        <Border Name="FaderTrack" Width="4" Height="500" Canvas.Left="74" Canvas.Top="0"
                CornerRadius="999" Background="{DynamicResource md3.surface-container-highest}"/>
        <Border Name="FaderHandle" Width="24" Height="16" Canvas.Left="64" Canvas.Top="116"
                CornerRadius="4" Background="{DynamicResource md3.on-surface}"/>
        <Border Name="FaderTick1" Width="8" Height="1" Canvas.Left="96" Canvas.Top="0"
                Background="{DynamicResource md3.outline-variant}"/>
        <Border Name="FaderTick2" Width="5" Height="1" Canvas.Left="96" Canvas.Top="62"
                Background="{DynamicResource md3.outline-variant}"/>
        <Border Name="FaderTick3" Width="8" Height="1" Canvas.Left="96" Canvas.Top="125"
                Background="{DynamicResource md3.outline-variant}"/>
        <Border Name="FaderTick4" Width="5" Height="1" Canvas.Left="96" Canvas.Top="187"
                Background="{DynamicResource md3.outline-variant}"/>
        <Border Name="FaderTick5" Width="8" Height="1" Canvas.Left="96" Canvas.Top="249"
                Background="{DynamicResource md3.outline-variant}"/>
        <Border Name="FaderTick6" Width="5" Height="1" Canvas.Left="96" Canvas.Top="311"
                Background="{DynamicResource md3.outline-variant}"/>
        <Border Name="FaderTick7" Width="8" Height="1" Canvas.Left="96" Canvas.Top="374"
                Background="{DynamicResource md3.outline-variant}"/>
        <Border Name="FaderTick8" Width="5" Height="1" Canvas.Left="96" Canvas.Top="436"
                Background="{DynamicResource md3.outline-variant}"/>
        <Border Name="FaderTick9" Width="8" Height="1" Canvas.Left="96" Canvas.Top="498"
                Background="{DynamicResource md3.outline-variant}"/>
      </Canvas>

      <!-- 735 · 峰值读数 13px semibold -->
      <TextBlock Grid.Row="6" Name="MasterPeakLabel" FontSize="13" FontWeight="SemiBold"
                 Foreground="{DynamicResource md3.on-surface}" Text="-∞ dB"/>
    </Grid>
  </Border>
</UserControl>
