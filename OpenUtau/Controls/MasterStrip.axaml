<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:OpenUtau.App.Controls" x:Class="OpenUtau.App.Controls.MasterStrip" Width="160" MinHeight="480">
  <!-- 主输出保留独立固定列。表头、推子和读数区与轨道条对齐；双电平表仍由原数据源驱动。 -->
  <UserControl.Styles>
    <Style Selector="Button.masterMuteBtn">
      <Setter Property="Theme" Value="{StaticResource DawMixButtonTheme}"/>
      <Setter Property="MinHeight" Value="20"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>
    <Style Selector="Button.masterMuteBtn.muteOn">
      <Setter Property="Background" Value="{DynamicResource md3.error}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-error}"/>
    </Style>
    <Style Selector="Button.masterMuteBtn">
      <Setter Property="MinHeight" Value="28"/>
    </Style>
  </UserControl.Styles>
  <Border Name="MasterCard" Padding="10" CornerRadius="{DynamicResource Md3ShapeLarge}" Background="{DynamicResource md3.surface-container-high}" BorderThickness="1" BorderBrush="{DynamicResource md3.outline-variant}">
    <Grid Name="RootGrid" RowSpacing="8" RowDefinitions="210,*,32">
      <Grid Name="MasterHeader" RowDefinitions="3,28,16,Auto,*" RowSpacing="8" Grid.Row="0">
        <Border Grid.Row="0" Name="MasterAccentBar" Height="3" CornerRadius="{DynamicResource Md3ShapeFull}" HorizontalAlignment="Stretch" Background="{DynamicResource md3.primary}"/>
        <Grid Grid.Row="1" Name="MasterNameRow" ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBlock Name="MasterNameLabel" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource md3.on-surface}" Text="{DynamicResource mixer.master.title}"/>
          <Button Grid.Column="1" Name="MuteBtn" Classes="masterMuteBtn" Width="28" Height="28" MinHeight="28" CornerRadius="8" FontSize="{DynamicResource Md3TypeLabelTiny}" FontWeight="Bold" VerticalAlignment="Center" Content="{DynamicResource mixer.mute}" Click="OnMuteClick"/>
        </Grid>
        <TextBlock Grid.Row="2" Name="MasterSubtitleLabel" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource md3.on-surface-variant}" Text="{DynamicResource mixer.bus.subtitle}"/>
        <Border Grid.Row="3" Name="BusInfo" Padding="8" CornerRadius="10" Background="{DynamicResource md3.surface-container-lowest}">
          <Grid RowSpacing="{DynamicResource Md3Spacing2}" RowDefinitions="Auto,Auto,Auto,Auto">
            <Grid Grid.Row="0" Name="BusRowIntegrated" Height="14" ColumnDefinitions="Auto,*">
              <TextBlock Name="IntegratedLabel" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource md3.on-surface-variant}" Text="{DynamicResource mixer.bus.integrated}"/>
              <TextBlock Grid.Column="1" Name="IntegratedValue" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource md3.on-surface}" Text="—"/>
            </Grid>
            <Grid Grid.Row="1" Name="BusRowTruePeak" Height="14" ColumnDefinitions="Auto,*">
              <TextBlock Name="TruePeakLabel" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource md3.on-surface-variant}" Text="{DynamicResource mixer.bus.truepeak}"/>
              <TextBlock Grid.Column="1" Name="TruePeakValue" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource md3.on-surface}" Text="—"/>
            </Grid>
            <Grid Grid.Row="2" Name="BusRowLimiter" Height="14" ColumnDefinitions="Auto,*">
              <TextBlock Name="LimiterLabel" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource md3.on-surface-variant}" Text="{DynamicResource mixer.bus.limiter}"/>
              <TextBlock Grid.Column="1" Name="LimiterValue" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource md3.on-surface}" Text="—"/>
            </Grid>
            <Grid Grid.Row="3" Name="BusRowDither" Height="14" ColumnDefinitions="Auto,*">
              <TextBlock Name="DitherLabel" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource md3.on-surface-variant}" Text="{DynamicResource mixer.bus.dither}"/>
              <TextBlock Grid.Column="1" Name="DitherValue" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource md3.on-surface}" Text="—"/>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="4" Name="ChannelSpacer"/>
      </Grid>
      <Border Name="FaderWell" CornerRadius="12" Padding="4,12" Background="{DynamicResource md3.surface-container-lowest}" MinHeight="140" Grid.Row="1">
        <controls:DawFader Name="FaderBox" Width="128" FocusBrush="{DynamicResource md3.primary}" AutomationProperties.Name="{DynamicResource mixer.master}" ToolTip.Tip="{DynamicResource controls.fader.tip}" HorizontalAlignment="Center" VerticalAlignment="Stretch">
          <Border Name="MeterBarL" Width="10" Height="{Binding #FaderBox.Bounds.Height}" Canvas.Left="12.0" Canvas.Top="0" CornerRadius="{DynamicResource Md3ShapeFull}" ClipToBounds="True" Background="{DynamicResource md3.surface-container-highest}">
            <Border Name="MeterFillL" Width="10" Height="0" CornerRadius="{DynamicResource Md3ShapeFull}" VerticalAlignment="Bottom" Background="{DynamicResource md3.primary}"/>
          </Border>
          <Border Name="MeterBarR" Width="10" Height="{Binding #FaderBox.Bounds.Height}" Canvas.Left="26.0" Canvas.Top="0" CornerRadius="{DynamicResource Md3ShapeFull}" ClipToBounds="True" Background="{DynamicResource md3.surface-container-highest}">
            <Border Name="MeterFillR" Width="10" Height="0" CornerRadius="{DynamicResource Md3ShapeFull}" VerticalAlignment="Bottom" Background="{DynamicResource md3.primary}"/>
          </Border>
          <Border Name="FaderTrack" Width="4" Height="{Binding #FaderBox.Bounds.Height}" Canvas.Left="62.0" Canvas.Top="0" CornerRadius="{DynamicResource Md3ShapeFull}" Background="{DynamicResource md3.surface-container-highest}"/>
          <Border Name="FaderHandle" Width="28" Height="20" Canvas.Left="50.0" Canvas.Top="116" CornerRadius="6" Background="{DynamicResource md3.on-surface}">
            <Grid IsHitTestVisible="False">
              <Border Classes="faderGrip" Width="14" Height="1" Margin="0,-3,0,0" VerticalAlignment="Center" Background="{DynamicResource md3.surface-container}"/>
              <Border Classes="faderGrip" Width="14" Height="1" Margin="0,3,0,0" VerticalAlignment="Center" Background="{DynamicResource md3.surface-container}"/>
            </Grid>
          </Border>
          <Border Name="FaderTick1" Width="8" Height="1" Canvas.Left="84.0" Canvas.Top="10" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick2" Width="8" Height="1" Canvas.Left="84.0" Canvas.Top="90" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick3" Width="8" Height="1" Canvas.Left="84.0" Canvas.Top="170" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick4" Width="8" Height="1" Canvas.Left="84.0" Canvas.Top="250" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick5" Width="8" Height="1" Canvas.Left="84.0" Canvas.Top="330" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick6" Width="8" Height="1" Canvas.Left="84.0" Canvas.Top="410" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick7" Width="8" Height="1" Canvas.Left="84.0" Canvas.Top="490" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick8" Width="4" Height="1" Canvas.Left="84.0" Canvas.Top="130" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick9" Width="4" Height="1" Canvas.Left="84.0" Canvas.Top="370" Background="{DynamicResource md3.outline-variant}"/>
          <TextBlock Text="+12" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False" Canvas.Left="96.0" Canvas.Top="4" Name="FaderLabel1" LineHeight="12"/>
          <TextBlock Text="+6" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False" Canvas.Left="96.0" Canvas.Top="84" Name="FaderLabel2" LineHeight="12"/>
          <TextBlock Text="0" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False" Canvas.Left="96.0" Canvas.Top="164" Name="FaderLabel3" LineHeight="12"/>
          <TextBlock Text="−6" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False" Canvas.Left="96.0" Canvas.Top="244" Name="FaderLabel4" LineHeight="12"/>
          <TextBlock Text="−12" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False" Canvas.Left="96.0" Canvas.Top="324" Name="FaderLabel5" LineHeight="12"/>
          <TextBlock Text="−18" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False" Canvas.Left="96.0" Canvas.Top="404" Name="FaderLabel6" LineHeight="12"/>
          <TextBlock Text="−24" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False" Canvas.Left="96.0" Canvas.Top="484" Name="FaderLabel7" LineHeight="12"/>
        </controls:DawFader>
      </Border>
      <Border Name="ReadoutWell" CornerRadius="8" Background="{DynamicResource md3.surface-container-highest}" Grid.Row="2">
        <TextBlock Name="MasterPeakLabel" FontSize="{DynamicResource Md3TypeBodyMedium}" FontWeight="SemiBold" Foreground="{DynamicResource md3.on-surface}" Text="-∞ dB" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource PlusFontFamilyMono}"/>
      </Border>
    </Grid>
  </Border>
</UserControl>