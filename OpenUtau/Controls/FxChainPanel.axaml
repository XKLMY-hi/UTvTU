<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:OpenUtau.App.Controls" x:Class="OpenUtau.App.Controls.FxChainPanel" DragDrop.AllowDrop="True">
  <Border Name="ChainRoot" Background="{DynamicResource md3.surface-container-lowest}" Padding="12,8,12,10" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*" RowSpacing="8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <TextBlock Text="{DynamicResource rack.signal}" VerticalAlignment="Center" FontSize="{DynamicResource Md3TypeLabelSmall}" Foreground="{DynamicResource md3.on-surface-variant}"/>
        <TextBlock Name="HeaderName" Grid.Column="1" Text="{Binding HeaderText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource md3.on-surface}"/>
        <Button Name="AddButton" Grid.Column="2" Theme="{StaticResource DawButtonTheme}" Content="{DynamicResource rack.add}" Click="OnAddClick" IsEnabled="{Binding HasTrack}" Height="30" MinHeight="30" Margin="0" Padding="12,0"/>
      </Grid>
      <Grid Grid.Row="1">
        <ScrollViewer Name="RackScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl Name="RowList" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><c:EffectRackCard Height="{Binding #RackScroll.Viewport.Height}"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel IsVisible="{Binding ShowEmptyHint}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
          <TextBlock Text="{DynamicResource rack.empty}" FontSize="{DynamicResource Md3TypeTitleMedium}" Foreground="{DynamicResource md3.on-surface}" HorizontalAlignment="Center"/>
          <TextBlock Text="{DynamicResource fxchain.empty}" Foreground="{DynamicResource md3.on-surface-variant}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
