<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OpenUtau.App.Controls" xmlns:vm="using:OpenUtau.App.ViewModels"
             x:Class="OpenUtau.App.Controls.SingerPicker" x:DataType="vm:SingerPickerViewModel"
             MinWidth="240" MaxWidth="400" ClipToBounds="True">
  <UserControl.Styles>
    <Style Selector="Button.typeFilterChip">
      <Setter Property="Height" Value="26"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="0,0,4,4"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>
    <Style Selector="Button.typeFilterChip.selected">
      <Setter Property="Background" Value="{DynamicResource md3.secondary-container}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-secondary-container}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource md3.surface-container-high}" CornerRadius="20" Padding="12">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource tracks.selectsinger}" FontWeight="SemiBold" FontSize="16"/>
        <TextBlock Text="{Binding CurrentName}" IsVisible="{Binding HasCurrent}" TextTrimming="CharacterEllipsis" FontSize="12"/>
      </StackPanel>
      <TextBox Name="SearchBox" Grid.Row="1" Text="{Binding Search, Mode=TwoWay}" PlaceholderText="{DynamicResource singerpicker.search}"/>
      <ItemsControl Name="TypeFilterBar" Grid.Row="2" ItemsSource="{Binding TypeFilters}" IsVisible="{Binding HasTypeFilters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SingerTypeFilterOption">
            <Button Classes="typeFilterChip" Classes.selected="{Binding IsSelected}"
                    Theme="{StaticResource DawTextButtonTheme}"
                    Content="{Binding Label}" ToolTip.Tip="{Binding ToolTip}"
                    Click="TypeFilterClicked"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid Grid.Row="3" MinHeight="64">
        <ListBox Name="SingerList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutoScrollToSelectedItem="True">
          <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SingerPickerRow">
              <Grid ColumnDefinitions="40,*,20,36" ColumnSpacing="8" Height="52" Tapped="RowTapped">
                <Border Width="40" Height="40" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource md3.surface-container-highest}">
                  <c:SingerAvatar Singer="{Binding Singer}" Revision="{Binding AvatarRevision}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource md3.on-surface-variant}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="✓" IsVisible="{Binding IsCurrent}" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Width="36" Height="36" Padding="0" Theme="{StaticResource DawTextButtonTheme}"
                        Content="{Binding FavoriteGlyph}" Click="FavoriteClicked" ToolTip.Tip="{DynamicResource singerpicker.favorite}"
                        AutomationProperties.Name="{DynamicResource singerpicker.favorite}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock IsVisible="{Binding IsEmpty}" Text="{DynamicResource singerpicker.empty}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <Button Grid.Column="0" Theme="{StaticResource DawTextButtonTheme}" HorizontalAlignment="Stretch"
                Content="{DynamicResource singerpicker.manage}" Click="ManageClicked"/>
        <Button Name="ClearSingerButton" Grid.Column="1" Theme="{StaticResource DawTextButtonTheme}"
                IsVisible="{Binding CanClearSinger}"
                Content="{DynamicResource tracks.clearsinger}" ToolTip.Tip="{DynamicResource tracks.clearsinger}"
                Click="ClearClicked"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
