<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:OpenUtau.App.Controls" x:Class="OpenUtau.App.Controls.FxChainRow" FontFamily="{DynamicResource PlusFontFamily}">
  <!-- 效果名称独占第一行，预设与格式放在第二行；序号、把手、旁通与移除保持原交互。 -->
  <UserControl.Resources>
    <ControlTheme x:Key="FxChainPowerTheme" TargetType="ToggleButton" BasedOn="{StaticResource DawCompactSwitchTheme}"/>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.rowRoot">
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="TextBlock.rowOrder">
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeLabelTiny}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>
    <Style Selector="TextBlock.rowName">
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodySmall}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
    </Style>
    <Style Selector="TextBlock.rowDetail">
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeLabelTiny}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>
    <Style Selector="TextBlock.rowBadgeText">
      <Setter Property="FontSize" Value="{DynamicResource Md3DawTypeReadout}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.rowChipText">
      <Setter Property="FontSize" Value="{DynamicResource Md3DawTypeReadout}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>
    <Style Selector="Button.rowIcon">
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeFull}"/>
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeLabelSmall}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.rowIcon:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
    </Style>
    <Style Selector="Border.rowRoot:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline}"/>
    </Style>
    <Style Selector="Border.rowRoot:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource md3.primary}"/>
    </Style>
    <Style Selector="Border.rowRoot.dragging">
      <Setter Property="BorderBrush" Value="{DynamicResource md3.primary}"/>
    </Style>
    <Style Selector="TextBlock.rowName">
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="TextBlock.rowDetail">
      <Setter Property="FontSize" Value="11"/>
    </Style>
  </UserControl.Styles>
  <Border Name="RowRoot" Classes="rowRoot" MinHeight="58" CornerRadius="10" BorderThickness="1" Padding="10,10" Background="{DynamicResource md3.surface-container-high}" PointerPressed="OnRowPointerPressed">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
      <Border Name="GripBox" Grid.Column="0" Width="16" Height="20" Margin="0,0,4,0" Background="Transparent" VerticalAlignment="Center" PointerPressed="OnGripPressed" PointerMoved="OnGripMoved" PointerReleased="OnGripReleased" PointerCaptureLost="OnGripCaptureLost">
        <controls:DawIcon Name="Grip" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource icon-list}" Fill="{DynamicResource md3.outline}"/>
      </Border>
      <TextBlock Name="OrderText" Grid.Column="1" Classes="rowOrder" Width="14" Margin="0,0,4,0" UseLayoutRounding="False" Text="{Binding Order}"/>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
        <TextBlock Name="NameText" Classes="rowName" UseLayoutRounding="False" FontFamily="{Binding $parent[UserControl].FontFamily}"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
          <TextBlock Name="DetailText" Classes="rowDetail" UseLayoutRounding="False" FontFamily="{Binding $parent[UserControl].FontFamily}"/>
          <Border Name="BadgeChip" Grid.Column="1" Margin="0" CornerRadius="{DynamicResource Md3ShapeFull}" Padding="4,1" VerticalAlignment="Center" Background="{DynamicResource md3.surface-container-highest}">
            <TextBlock Name="BadgeLabel" Classes="rowBadgeText" UseLayoutRounding="False" FontFamily="{Binding $parent[UserControl].FontFamily}" Foreground="{DynamicResource md3.on-surface-variant}"/>
          </Border>
        </Grid>
      </StackPanel>
      <Border Name="StateChip" Grid.Column="3" Height="22" CornerRadius="{DynamicResource Md3ShapeFull}" Padding="10,0" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="False" Background="{DynamicResource md3.surface-container-highest}">
        <TextBlock Name="StateChipText" Classes="rowChipText" UseLayoutRounding="False" FontFamily="{Binding $parent[UserControl].FontFamily}" Text="{DynamicResource fxcard.bypass}"/>
      </Border>
      <ToggleButton Name="PowerToggle" Grid.Column="4" Classes="fxPower" Theme="{StaticResource FxChainPowerTheme}" Width="34" Height="20" Margin="8,0,2,0" VerticalAlignment="Center" Click="OnPowerClick" AutomationProperties.Name="{DynamicResource fxchain.power.tip}" ToolTip.Tip="{DynamicResource fxchain.power.tip}"/>
      <Button Name="RemoveButton" Grid.Column="5" Classes="rowIcon" Theme="{StaticResource DawButtonTheme}" AutomationProperties.Name="{DynamicResource fxchain.remove.tip}" Click="OnRemoveClick" ToolTip.Tip="{DynamicResource fxchain.remove.tip}">
        <controls:DawIcon Name="RemoveIcon" Width="12" Height="12" Data="{StaticResource icon-x}" Fill="{Binding $parent[Button].Foreground}"/>
      </Button>
    </Grid>
  </Border>
</UserControl>