<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:OpenUtau.App.ViewModels" xmlns:c="clr-namespace:OpenUtau.App.Controls" mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="104" x:Class="OpenUtau.App.Controls.TrackHeader" Width="300" Height="104" TrackNo="{Binding TrackNo}">
  <Design.DataContext>
    <vm:TrackHeaderViewModel/>
  </Design.DataContext>
  <UserControl.Styles>
    <StyleInclude Source="/Styles/TrackHeaderControls.axaml"/>
    <Style Selector="FlyoutPresenter">
      <Setter Property="Padding" Value="5"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="FlyoutPresenter.singerPickerHost">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="20"/>
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <ContextMenu x:Key="RendererMenuRes" Classes="context" Name="RenderersMenu" Placement="BottomEdgeAlignedLeft" HorizontalOffset="-3" ItemsSource="{Binding RenderersMenuItems}">
      <ContextMenu.Styles>
        <Style Selector="MenuItem">
          <Setter Property="Header" Value="{Binding Header}"/>
          <Setter Property="Command" Value="{Binding Command}"/>
          <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
          <Setter Property="ItemsSource" Value="{Binding Items}"/>
        </Style>
      </ContextMenu.Styles>
    </ContextMenu>
    <ContextMenu x:Key="PhonemizerMenuRes" Classes="context" Name="PhonemizersMenu" Placement="BottomEdgeAlignedLeft" HorizontalOffset="-3" ItemsSource="{Binding PhonemizerMenuItems}">
      <ContextMenu.Styles>
        <Style Selector="MenuItem">
          <Setter Property="Header" Value="{Binding Header}"/>
          <Setter Property="Command" Value="{Binding Command}"/>
          <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
          <Setter Property="ItemsSource" Value="{Binding Items}"/>
        </Style>
      </ContextMenu.Styles>
    </ContextMenu>
    <ContextMenu x:Key="SingersMenuRes" Classes="context" Name="SingersMenu" Placement="BottomEdgeAlignedLeft" HorizontalOffset="-3" ItemsSource="{Binding SingerMenuItems}">
      <ContextMenu.Styles>
        <Style Selector="MenuItem">
          <Setter Property="Header" Value="{Binding Header}"/>
          <Setter Property="Command" Value="{Binding Command}"/>
          <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
          <Setter Property="ItemsSource" Value="{Binding Items}"/>
          <Setter Property="Icon" Value="{Binding Icon}"/>
          <Setter Property="ToolTip.Tip" Value="{Binding Location}"/>
          <Setter Property="Height" Value="{Binding Height}"/>
          <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
        </Style>
      </ContextMenu.Styles>
    </ContextMenu>
  </UserControl.Resources>
  <Grid Margin="2,2,2,2">
    <Border Name="MainCard" Margin="0" BorderThickness="1" BorderBrush="{Binding HeaderBorderBrush}" CornerRadius="6" PointerPressed="HeaderPointerPressed" Background="{DynamicResource md3.surface-container}">
      <Grid>
        <Grid Name="HeaderContent" ColumnDefinitions="*" RowDefinitions="*" Margin="8,4,8,4">
          <Grid Name="ContentRows" Grid.Column="0" RowDefinitions="24,18,24,22">
            <Grid Name="TitleRow" Grid.Row="0" ColumnDefinitions="22,*,24">
              <TextBlock Name="TrackNumber" Text="{Binding TrackNo}" FontSize="11" FontWeight="Bold" Foreground="{Binding TrackAccentColor}" VerticalAlignment="Center" FontFamily="{DynamicResource PlusFontFamilyMono}"/>
              <Button Name="TrackNameButton" Classes="trackHeaderText" Theme="{StaticResource TrackHeaderTextButtonTheme}" Grid.Row="0" Margin="0" Padding="2,0" Height="24" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Focusable="True" FontSize="13" FontWeight="SemiBold" Content="{Binding TrackName}" Click="TrackNameButtonClicked" Grid.Column="1"/>
              <Border Name="AvatarCard" Grid.Column="2" VerticalAlignment="Top" Margin="0" Width="24" Height="24" CornerRadius="4" ClipToBounds="True" BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="0">
                <Image Source="{Binding Avatar}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" ToolTip.Tip="{Binding Singer}"/>
              </Border>
            </Grid>
            <Grid Name="RoutingRow" Grid.Row="1" ColumnDefinitions="*,6,64">
              <Button Classes="trackHeaderText" Theme="{StaticResource TrackHeaderTextButtonTheme}" Grid.Row="0" Margin="0" Padding="2,0" Height="18" FontSize="{DynamicResource Md3TypeLabelTiny}" IsVisible="{Binding IsSingerVisible}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Focusable="True" Content="{Binding Singer, TargetNullValue={StaticResource tracks.selectsinger}}" Click="SingerButtonClicked" ContextRequested="SingerButtonContextRequested" ToolTip.Tip="{Binding Singer}" Name="SingerButton" Grid.Column="0"/>
              <Button Name="RendererButton" Classes="trackHeaderText" Theme="{StaticResource TrackHeaderTextButtonTheme}" Grid.Row="0" Margin="0" Padding="2,0" Height="18" FontSize="{DynamicResource Md3TypeLabelTiny}" IsVisible="{Binding IsRendererVisible}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Focusable="True" Content="{Binding Renderer}" Click="RendererButtonClicked" ContextRequested="RendererButtonContextRequested" ToolTip.Tip="{DynamicResource tracks.selectrenderer}" ContextMenu="{StaticResource RendererMenuRes}" Grid.Column="2" Background="{DynamicResource md3.surface-container-high}"/>
            </Grid>
            <Grid Name="ActionsRow" Grid.Row="2" ColumnDefinitions="auto,*">
              <WrapPanel Name="ActionRail" Grid.Column="0" Width="104" VerticalAlignment="Center" Margin="0" Orientation="Horizontal">
                <Button Name="OverflowButton" Classes="trackHeaderAction" Theme="{StaticResource TrackHeaderActionTheme}" Height="18" Width="17" Padding="0" Content="···" FontSize="10" VerticalAlignment="Top" IsVisible="{Binding ShowOverflow}">
                  <Button.Flyout>
                    <Flyout>
                      <StackPanel Spacing="2">
                        <Button Classes="trackHeaderText" Theme="{StaticResource TrackHeaderTextButtonTheme}" Margin="2" Height="18" IsVisible="{Binding !IsSingerVisible}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Focusable="True" Content="{Binding Singer, TargetNullValue={StaticResource tracks.selectsinger}}" Click="SingerButtonClicked" ContextRequested="SingerButtonContextRequested" ToolTip.Tip="{Binding Singer}"/>
                        <Button Classes="trackHeaderText" Theme="{StaticResource TrackHeaderTextButtonTheme}" Margin="2" Height="18" IsVisible="{Binding !IsPhonemizerVisible}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Focusable="True" Content="{Binding PhonemizerTag}" Click="PhonemizerButtonClicked" ContextRequested="PhonemizerButtonContextRequested" ToolTip.Tip="{Binding Phonemizer}" ContextMenu="{StaticResource PhonemizerMenuRes}"/>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <ToggleButton Name="MuteButton" Classes="trackHeaderToggle mute" Theme="{StaticResource TrackHeaderToggleTheme}" MinHeight="0" Margin="0" Padding="0" Height="20" Width="24" HorizontalAlignment="Center" AutomationProperties.Name="{DynamicResource tracks.mute}" ToolTip.Tip="{DynamicResource tracks.mute}" IsChecked="{Binding Mute, Mode=OneWay}" Command="{Binding ToggleMute}" FontSize="{DynamicResource Md3TypeLabelTiny}" FontWeight="Bold" Content="M">
                  <ToggleButton.ContextMenu>
                    <ContextMenu>
                      <MenuItem Classes="context" Header="{StaticResource tracks.mute}" Command="{Binding ToggleMute}"/>
                      <MenuItem Classes="context" Header="{StaticResource tracks.mute.only}" Command="{Binding MuteOnly}"/>
                      <MenuItem Classes="context" Header="{StaticResource tracks.mute.allothers}" Command="{Binding MuteAllOthers}"/>
                      <MenuItem Classes="context" Header="{StaticResource tracks.mute.unmuteall}" Command="{Binding UnmuteAll}"/>
                    </ContextMenu>
                  </ToggleButton.ContextMenu>
                </ToggleButton>
                <ToggleButton Name="SoloButton" Classes="trackHeaderToggle solo" Theme="{StaticResource TrackHeaderToggleTheme}" MinHeight="0" Margin="0" Padding="0" Height="20" Width="24" HorizontalAlignment="Center" AutomationProperties.Name="{DynamicResource tracks.solo}" ToolTip.Tip="{DynamicResource tracks.solo}" IsChecked="{Binding Solo, Mode=OneWay}" Command="{Binding ToggleSolo}" FontSize="{DynamicResource Md3TypeLabelTiny}" FontWeight="Bold" Content="S">
                  <ToggleButton.ContextMenu>
                    <ContextMenu>
                      <MenuItem Classes="context" Header="{StaticResource tracks.solo.only}" Command="{Binding ToggleSolo}"/>
                      <MenuItem Classes="context" Header="{StaticResource tracks.solo.add}" Command="{Binding SoloAdditionally}"/>
                      <MenuItem Classes="context" Header="{StaticResource tracks.solo.unsoloall}" Command="{Binding UnsoloAll}"/>
                    </ContextMenu>
                  </ToggleButton.ContextMenu>
                </ToggleButton>
                <Button Name="FxButton" Classes="trackHeaderAction fxButton" Theme="{StaticResource TrackHeaderEffectsTheme}" Margin="0" Height="20" Width="24" HorizontalAlignment="Center" AutomationProperties.Name="{DynamicResource context.track.effects}" ToolTip.Tip="{DynamicResource context.track.effects}" Classes.fxOn="{Binding MixFxEnabled}" Command="{Binding OpenMixFxDialog}" FontSize="{DynamicResource Md3DawTypeReadout}" FontWeight="SemiBold" Content="fx">
          </Button>
                <Button Name="SettingsButton" Classes="trackHeaderAction" Theme="{StaticResource TrackHeaderActionTheme}" Margin="0" Padding="0" Height="20" Width="24" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Top" Click="TrackSettingsButtonClicked" AutomationProperties.Name="{DynamicResource tracks.tracksettings}" ToolTip.Tip="{DynamicResource tracks.tracksettings}">
                  <c:DawIcon Width="15" Height="15" Data="{StaticResource icon-settings}" Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
              </WrapPanel>
              <Button Classes="trackHeaderText" Theme="{StaticResource TrackHeaderTextButtonTheme}" Grid.Row="0" Margin="4,0,0,0" Padding="2,0" Height="20" FontSize="{DynamicResource Md3TypeLabelTiny}" IsVisible="{Binding IsPhonemizerVisible}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Focusable="True" Content="{Binding PhonemizerTag}" Click="PhonemizerButtonClicked" ContextRequested="PhonemizerButtonContextRequested" ToolTip.Tip="{Binding Phonemizer}" ContextMenu="{StaticResource PhonemizerMenuRes}" Name="PhonemizerButton" Grid.Column="1"/>
            </Grid>
            <Grid Name="LevelsRow" Grid.Row="3" ColumnDefinitions="*,48,6,40,28" Margin="0">
              <Grid.Styles>
                <Style Selector="Slider, TextBlock, TextBox">
                  <Setter Property="VerticalAlignment" Value="Center"/>
                  <Setter Property="MinHeight" Value="0"/>
                  <Setter Property="Height" Value="NaN"/>
                </Style>
              </Grid.Styles>
              <Slider Grid.Column="0" Name="VolumeSlider" HorizontalAlignment="Stretch" Classes="trackHeaderFader" Theme="{StaticResource TrackHeaderFaderTheme}" Foreground="{Binding TrackColor.AccentColor}" Minimum="-24" Maximum="12" Value="{Binding Volume}" PointerPressed="VolumeFaderPointerPressed" ValueChanged="VolumeOrPanSliderValueChanged" ContextRequested="VolumeFaderContextRequested" IsEnabled="{Binding !Muted}"/>
              <TextBlock Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" Margin="0" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource md3.on-surface-variant}" FontFamily="{DynamicResource PlusFontFamilyMono}" PointerPressed="VolumePointerPressed" Name="VolumeReadout">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0:0.0} dB">
                    <Binding Path="Volume"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <TextBox Grid.Column="1" Name="VolumeTextBox" MinWidth="0" HorizontalAlignment="Stretch" BorderThickness="0" IsVisible="False" IsEnabled="False" TextAlignment="Right" FontSize="{DynamicResource Md3DawTypeReadout}" FontFamily="{DynamicResource PlusFontFamilyMono}" KeyDown="VolumeOrPanTextBoxKeyDown" LostFocus="VolumeOrPanTextBoxLostFocus" Padding="0"/>
              <Slider Grid.Column="3" Name="PanSlider" HorizontalAlignment="Stretch" Classes="trackHeaderFader" Theme="{StaticResource TrackHeaderFaderTheme}" Foreground="{Binding TrackColor.AccentColor}" Minimum="-100" Maximum="100" Value="{Binding Pan}" PointerPressed="PanFaderPointerPressed" ValueChanged="VolumeOrPanSliderValueChanged" ContextRequested="PanFaderContextRequested" IsEnabled="{Binding !Muted}"/>
              <TextBlock Grid.Column="4" HorizontalAlignment="Stretch" Background="Transparent" Margin="0" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource md3.on-surface-variant}" FontFamily="{DynamicResource PlusFontFamilyMono}" PointerPressed="PanPointerPressed" Name="PanReadout">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0:00R;00L;C}">
                    <Binding Path="Pan"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <TextBox Grid.Column="4" Name="PanTextBox" MinWidth="0" HorizontalAlignment="Stretch" BorderThickness="0" IsVisible="False" IsEnabled="False" TextAlignment="Center" FontSize="{DynamicResource Md3DawTypeReadout}" FontFamily="{DynamicResource PlusFontFamilyMono}" KeyDown="VolumeOrPanTextBoxKeyDown" LostFocus="VolumeOrPanTextBoxLostFocus" Padding="0"/>
            </Grid>
          </Grid>
          <Grid.ContextMenu>
            <ContextMenu>
              <MenuItem Classes="context" Header="{DynamicResource tracks.remove}" Command="{Binding Remove}"/>
              <MenuItem Classes="context" Header="{DynamicResource tracks.moveup}" Command="{Binding MoveUp}"/>
              <MenuItem Classes="context" Header="{DynamicResource tracks.movedown}" Command="{Binding MoveDown}"/>
              <MenuItem Classes="context" Header="{DynamicResource tracks.rename}" Command="{Binding Rename}"/>
              <MenuItem Classes="context" Header="{DynamicResource tracks.trackcolor}" Command="{Binding SelectTrackColor}"/>
              <MenuItem Classes="context" Header="{DynamicResource tracks.duplicate}" Command="{Binding Duplicate}"/>
              <MenuItem Classes="context" Header="{DynamicResource tracks.duplicatesettings}" Command="{Binding DuplicateSettings}"/>
              <MenuItem Classes="context" Header="{DynamicResource dialogs.voicecolorremapping}" Command="{Binding VoiceColorRemapping}"/>
              <Separator/>
              <MenuItem Classes="context" Header="{DynamicResource tracks.tracksettings}" Click="TrackSettingsButtonClicked"/>
              <MenuItem Classes="context" Header="{DynamicResource tracks.mixfx}" Command="{Binding OpenMixFxDialog}"/>
            </ContextMenu>
          </Grid.ContextMenu>
        </Grid>
        <Border Width="3" Background="{Binding TrackAccentColor}" HorizontalAlignment="Left" CornerRadius="2" IsHitTestVisible="False" Margin="0,4,0,4"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
