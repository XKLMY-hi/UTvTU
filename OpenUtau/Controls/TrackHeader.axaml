<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenUtau.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="104"
             x:Class="OpenUtau.App.Controls.TrackHeader" Width="300" Height="104" TrackNo="{Binding TrackNo}">
  <Design.DataContext>
    <vm:TrackHeaderViewModel/>
  </Design.DataContext>
  <UserControl.Styles>
    <StyleInclude Source="/Styles/TrackHeaderControls.axaml"/>
    <!-- These are density adjustments, not external template-part patches. -->
    <Style Selector="FlyoutPresenter">
      <Setter Property="Padding" Value="5"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="UserControl.compact Grid#HeaderContent">
      <Setter Property="Margin" Value="6,2,4,2"/>
    </Style>
    <Style Selector="UserControl.compact Button#TrackNameButton">
      <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="UserControl.compact Grid#LevelsRow">
      <Setter Property="Margin" Value="0"/>
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <ContextMenu x:Key="RendererMenuRes" Classes="context" Name="RenderersMenu" Placement="BottomEdgeAlignedLeft"
                 HorizontalOffset="-3" ItemsSource="{Binding RenderersMenuItems}">
      <ContextMenu.Styles>
        <Style Selector="MenuItem">
          <Setter Property="Header" Value="{Binding Header}"/>
          <Setter Property="Command" Value="{Binding Command}"/>
          <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
          <Setter Property="ItemsSource" Value="{Binding Items}"/>
        </Style>
      </ContextMenu.Styles>
    </ContextMenu>
    <ContextMenu x:Key="PhonemizerMenuRes" Classes="context" Name="PhonemizersMenu" Placement="BottomEdgeAlignedLeft"
                 HorizontalOffset="-3" ItemsSource="{Binding PhonemizerMenuItems}">
      <ContextMenu.Styles>
        <Style Selector="MenuItem">
          <Setter Property="Header" Value="{Binding Header}"/>
          <Setter Property="Command" Value="{Binding Command}"/>
          <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
          <Setter Property="ItemsSource" Value="{Binding Items}"/>
        </Style>
      </ContextMenu.Styles>
    </ContextMenu>
    <ContextMenu x:Key="SingersMenuRes" Classes="context" Name="SingersMenu" Placement="BottomEdgeAlignedLeft"
                 HorizontalOffset="-3" ItemsSource="{Binding SingerMenuItems}">
      <ContextMenu.Styles>
        <Style Selector="MenuItem">
          <Setter Property="Header" Value="{Binding Header}"/>
          <Setter Property="Command" Value="{Binding Command}"/>
          <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
          <Setter Property="ItemsSource" Value="{Binding Items}"/>
          <Setter Property="Icon" Value="{Binding Icon}"/>
          <Setter Property="ToolTip.Tip" Value="{Binding Location}"/>
          <Setter Property="Height" Value="{Binding Height}"/>
          <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
        </Style>
      </ContextMenu.Styles>
    </ContextMenu>
  </UserControl.Resources>

  <!-- Track header: compact track surface, with existing height-dependent layout. -->
  <Grid Margin="2,2,2,2">
    <!-- Main card -->
    <Border Name="MainCard" Margin="0" BorderThickness="1" BorderBrush="{Binding HeaderBorderBrush}"
            CornerRadius="4" PointerPressed="HeaderPointerPressed"
            Background="{DynamicResource md3.surface-container-low}">
      <Grid Name="HeaderContent" ColumnDefinitions="auto,*,auto" RowDefinitions="*" Margin="6,3,4,3">

        <!-- ── Left: Avatar（圆角矩形，竖居中）+ TrackNo badge（右下角不挡头像） ── -->
        <Border Name="AvatarCard" Grid.Column="0" VerticalAlignment="Top" Margin="0,2,6,0"
                Width="44" Height="44" CornerRadius="8" ClipToBounds="True"
                BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="0">
          <Image Source="{Binding Avatar}" Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="HighQuality"
                 ToolTip.Tip="{Binding Singer}"/>
        </Border>
        <Border Background="{Binding TrackAccentColor}" Height="14" Width="20"
                CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="4,4" Grid.Column="0" ZIndex="1">
          <TextBlock TextAlignment="Center" FontSize="10" FontWeight="Bold"
                     Text="{Binding TrackNo}"
                     Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

        <!-- ── Center: Track name + singer/phonemizer/renderer + volume/pan ── -->
        <Grid Name="ContentRows" Grid.Column="1" RowDefinitions="auto,auto,auto,auto,auto">
          <!-- Row 0: Track name（紧凑档下渲染器会内联到本行右侧，见 code-behind） -->
          <Button Name="TrackNameButton" Classes="trackHeaderText" Theme="{StaticResource TrackHeaderTextButtonTheme}" Grid.Row="0" Margin="2,0,0,0" Padding="2,0" Height="18"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Focusable="True"
                  FontSize="11" FontWeight="SemiBold"
                  Content="{Binding TrackName}" Click="TrackNameButtonClicked"/>

          <!-- Row 1: Singer (visible when track is tall enough) -->
          <Button Classes="trackHeaderText" Theme="{StaticResource TrackHeaderTextButtonTheme}" Grid.Row="1" Margin="2,0,0,0" Padding="2,0" Height="16"
                  FontSize="10" IsVisible="{Binding IsSingerVisible}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Focusable="True"
                  Content="{Binding Singer, TargetNullValue={StaticResource tracks.selectsinger}}"
                  Click="SingerButtonClicked" ContextRequested="SingerButtonContextRequested"
                  ToolTip.Tip="{Binding Singer}" ContextMenu="{StaticResource SingersMenuRes}"/>

          <!-- Row 2: Phonemizer -->
          <Button Classes="trackHeaderText" Theme="{StaticResource TrackHeaderTextButtonTheme}" Grid.Row="2" Margin="2,0,0,0" Padding="2,0" Height="16"
                  FontSize="10" IsVisible="{Binding IsPhonemizerVisible}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Focusable="True"
                  Content="{Binding PhonemizerTag}" Click="PhonemizerButtonClicked"
                  ContextRequested="PhonemizerButtonContextRequested"
                  ToolTip.Tip="{Binding Phonemizer}" ContextMenu="{StaticResource PhonemizerMenuRes}"/>

          <!-- Row 3: Renderer（W33：**恒可见**，不再按轨道高裁剪；命名供布局测试定位） -->
          <Button Name="RendererButton" Classes="trackHeaderText" Theme="{StaticResource TrackHeaderTextButtonTheme}" Grid.Row="3" Margin="2,0,0,0" Padding="2,0" Height="16"
                  FontSize="10" IsVisible="{Binding IsRendererVisible}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Focusable="True"
                  Content="{Binding Renderer}" Click="RendererButtonClicked"
                  ContextRequested="RendererButtonContextRequested"
                  ToolTip.Tip="{DynamicResource tracks.selectrenderer}" ContextMenu="{StaticResource RendererMenuRes}"/>

          <!-- Row 4: Volume + Pan mini sliders -->
          <Grid Name="LevelsRow" Grid.Row="4" ColumnDefinitions="3,*,auto,*,auto" Margin="0,2,0,0">
            <Grid.Styles>
              <Style Selector="Slider, TextBlock, TextBox">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Height" Value="NaN"/>
              </Style>
            </Grid.Styles>
            <!-- Volume -->
            <Slider Grid.Column="1" Name="VolumeSlider" HorizontalAlignment="Stretch"
                    Classes="trackHeaderFader" Theme="{StaticResource TrackHeaderFaderTheme}" Foreground="{Binding TrackColor.AccentColor}" Minimum="-24" Maximum="12" Value="{Binding Volume}"
                    PointerPressed="VolumeFaderPointerPressed" ValueChanged="VolumeOrPanSliderValueChanged"
                    ContextRequested="VolumeFaderContextRequested" IsEnabled="{Binding !Muted}"/>
            <TextBlock Grid.Column="2" HorizontalAlignment="Left" Background="Transparent" Margin="2,0"
                       TextAlignment="Center" FontSize="9" Foreground="{DynamicResource md3.on-surface-variant}" FontFamily="{DynamicResource PlusFontFamilyMono}"
                       PointerPressed="VolumePointerPressed">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0:+#00.0;-#00.0}">
                  <Binding Path="Volume"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <TextBox Grid.Column="2" Name="VolumeTextBox" MinWidth="28"
                     HorizontalAlignment="Left" BorderThickness="0" IsVisible="False" IsEnabled="False"
                     TextAlignment="Right" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}"
                     KeyDown="VolumeOrPanTextBoxKeyDown" LostFocus="VolumeOrPanTextBoxLostFocus"/>

            <!-- Pan -->
            <Slider Grid.Column="3" Name="PanSlider" HorizontalAlignment="Stretch"
                    Classes="trackHeaderFader" Theme="{StaticResource TrackHeaderFaderTheme}" Foreground="{Binding TrackColor.AccentColor}" Minimum="-100" Maximum="100" Value="{Binding Pan}"
                    PointerPressed="PanFaderPointerPressed" ValueChanged="VolumeOrPanSliderValueChanged"
                    ContextRequested="PanFaderContextRequested" IsEnabled="{Binding !Muted}"/>
            <TextBlock Grid.Column="4" HorizontalAlignment="Stretch" Background="Transparent" Margin="1,0"
                       TextAlignment="Center" FontSize="9" Foreground="{DynamicResource md3.on-surface-variant}" FontFamily="{DynamicResource PlusFontFamilyMono}"
                       PointerPressed="PanPointerPressed">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0:00R;00L;C}">
                  <Binding Path="Pan"/>
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <TextBox Grid.Column="4" Name="PanTextBox" MinWidth="26" HorizontalAlignment="Center"
                     BorderThickness="0" IsVisible="False" IsEnabled="False" TextAlignment="Center" FontSize="9"
                     FontFamily="{DynamicResource PlusFontFamilyMono}" KeyDown="VolumeOrPanTextBoxKeyDown" LostFocus="VolumeOrPanTextBoxLostFocus"/>
          </Grid>
        </Grid>

        <!-- ── Right: Mute / Solo / FX / Settings buttons ── -->
        <WrapPanel Name="ActionRail" Grid.Column="2" Width="24"
                   VerticalAlignment="Top" Margin="0,2,0,0">

          <!-- "⋯" overflow button（紧凑视图：歌手/音素器被按高裁掉时才出现）。
               触发条件从 `!IsRendererVisible` 改成 `ShowOverflow`（W33）：渲染器已恒显，
               若还挂渲染器那个条件就永远不显示了；同时**渲染器兜底项已删除**（同一入口两处呈现是隐患）。 -->
          <Button Name="OverflowButton" Classes="trackHeaderAction" Theme="{StaticResource TrackHeaderActionTheme}" Height="18" Width="17" Padding="0"
                  Content="⋯" FontSize="12"
                  VerticalAlignment="Top" IsVisible="{Binding ShowOverflow}">
            <Button.Flyout>
              <Flyout>
                <StackPanel Spacing="2">
                  <Button Classes="trackHeaderText" Theme="{StaticResource TrackHeaderTextButtonTheme}" Margin="2" Height="18" IsVisible="{Binding !IsSingerVisible}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Focusable="True"
                          Content="{Binding Singer, TargetNullValue={StaticResource tracks.selectsinger}}"
                          Click="SingerButtonClicked" ContextRequested="SingerButtonContextRequested"
                          ToolTip.Tip="{Binding Singer}" ContextMenu="{StaticResource SingersMenuRes}"/>
                  <Button Classes="trackHeaderText" Theme="{StaticResource TrackHeaderTextButtonTheme}" Margin="2" Height="18" IsVisible="{Binding !IsPhonemizerVisible}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Focusable="True"
                          Content="{Binding PhonemizerTag}" Click="PhonemizerButtonClicked"
                          ContextRequested="PhonemizerButtonContextRequested"
                          ToolTip.Tip="{Binding Phonemizer}" ContextMenu="{StaticResource PhonemizerMenuRes}"/>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Mute button -->
          <ToggleButton Name="MuteButton" Classes="trackHeaderToggle" Theme="{StaticResource TrackHeaderToggleTheme}" MinHeight="0" Margin="0" Padding="0" Height="20" Width="24"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource tracks.mute}" ToolTip.Tip="{DynamicResource tracks.mute}"
                        IsChecked="{Binding Mute, Mode=OneWay}" Command="{Binding ToggleMute}">
            <Path Width="16" Height="16" Fill="{Binding $parent[ToggleButton].Foreground}"
                  Data="M15.31 17A.51.56 0 0 1 14.81 16.44V9.2A.07.08 0 0 0 14.66 9.17L12.39 14.5a.29.32 0 0 1-.26.19h-.35a.29.32 0 0 1-.26-.19L9.27 9.17 9.12 9.2v7.24A.51.56 0 0 1 8.62 17H8.51A.51.56 0 0 1 8 16.44V7.56A.51.56 0 0 1 8.51 7h.84a.43.48 0 0 1 .39.28l2.23 5.2a.04.05 0 0 0 .07 0l2.16-5.2a.43.48 0 0 1 .41-.28h.88A.51.56 0 0 1 16 7.56v8.88A.51.56 0 0 1 15.5 17Z"/>
            <ToggleButton.ContextMenu>
              <ContextMenu>
                <MenuItem Classes="context" Header="{StaticResource tracks.mute}" Command="{Binding ToggleMute}"/>
                <MenuItem Classes="context" Header="{StaticResource tracks.mute.only}" Command="{Binding MuteOnly}"/>
                <MenuItem Classes="context" Header="{StaticResource tracks.mute.allothers}" Command="{Binding MuteAllOthers}"/>
                <MenuItem Classes="context" Header="{StaticResource tracks.mute.unmuteall}" Command="{Binding UnmuteAll}"/>
              </ContextMenu>
            </ToggleButton.ContextMenu>
          </ToggleButton>

          <!-- Solo button -->
          <ToggleButton Name="SoloButton" Classes="trackHeaderToggle" Theme="{StaticResource TrackHeaderToggleTheme}" MinHeight="0" Margin="0" Padding="0" Height="20" Width="24"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource tracks.solo}" ToolTip.Tip="{DynamicResource tracks.solo}"
                        IsChecked="{Binding Solo, Mode=OneWay}" Command="{Binding ToggleSolo}">
            <Path Width="16" Height="16" Fill="{Binding $parent[ToggleButton].Foreground}"
                  Data="M15.99 14.08c0-.7-.2-1.23-.58-1.62-.38-.39-.97-.67-1.73-.86-.39-.09-.84-.17-1.4-.27-.54-.09-.97-.15-1.27-.21-.55-.12-.95-.3-1.17-.52-.23-.24-.33-.56-.33-.96 0-.45.22-.82.67-1.1.45-.28 1.04-.43 1.78-.43.67 0 1.33.1 1.97.31.64.2 1.58.49 1.99.81H16V7.71c-.47-.2-1.42-.38-2.03-.51-.6-.13-1.28-.2-2.01-.2-1.12 0-2.05.26-2.79.78-.73.5-1.1 1.17-1.1 1.98 0 .71.21 1.27.65 1.72.45.44 1.13.75 2.06.93.45.09.88.16 1.29.21.41.06.79.13 1.13.22.47.11.79.28 1.03.47.23.21.34.52.34.95 0 .5-.24.89-.71 1.19-.47.3-1.14.43-1.99.43-.61 0-1.24-.11-1.94-.33-.67-.23-1.28-.53-1.81-.94H8v1.61c.61.26 1.22.46 1.82.59.59.12 1.26.19 2.01.19.7 0 1.29-.07 1.78-.23.5-.16.94-.38 1.3-.65.33-.26.6-.56.79-.93.19-.37.29-.74.29-1.12Z"/>
            <ToggleButton.ContextMenu>
              <ContextMenu>
                <MenuItem Classes="context" Header="{StaticResource tracks.solo.only}" Command="{Binding ToggleSolo}"/>
                <MenuItem Classes="context" Header="{StaticResource tracks.solo.add}" Command="{Binding SoloAdditionally}"/>
                <MenuItem Classes="context" Header="{StaticResource tracks.solo.unsoloall}" Command="{Binding UnsoloAll}"/>
              </ContextMenu>
            </ToggleButton.ContextMenu>
          </ToggleButton>

          <!-- FX button -->
          <Button Name="FxButton" Classes="trackHeaderAction fxButton" Theme="{StaticResource TrackHeaderEffectsTheme}" Margin="0" Height="20" Width="24"
                  HorizontalAlignment="Center"
                  AutomationProperties.Name="{DynamicResource context.track.effects}" ToolTip.Tip="{DynamicResource context.track.effects}"
                  Classes.fxOn="{Binding MixFxEnabled}"
                  Command="{Binding OpenMixFxDialog}">
            <TextBlock Text="fx" FontSize="9" FontWeight="SemiBold" Foreground="{Binding $parent[Button].Foreground}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Button>

          <!-- 轨道设置按钮（重建：旧按钮点击无效——去 Separator、常显、明确布局） -->
          <Button Name="SettingsButton" Classes="trackHeaderAction" Theme="{StaticResource TrackHeaderActionTheme}" Margin="0" Padding="0" Height="20" Width="24"
                  Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Click="TrackSettingsButtonClicked"
                  AutomationProperties.Name="{DynamicResource tracks.tracksettings}" ToolTip.Tip="{DynamicResource tracks.tracksettings}">
            <Path Width="15" Height="15" Stretch="Uniform" Data="{StaticResource icon-settings}"
                  Fill="{Binding $parent[Button].Foreground}"/>
          </Button>
        </WrapPanel>

        <!-- ── Context menu (right-click on whole header) ── -->
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Classes="context" Header="{DynamicResource tracks.remove}" Command="{Binding Remove}"/>
            <MenuItem Classes="context" Header="{DynamicResource tracks.moveup}" Command="{Binding MoveUp}"/>
            <MenuItem Classes="context" Header="{DynamicResource tracks.movedown}" Command="{Binding MoveDown}"/>
            <MenuItem Classes="context" Header="{DynamicResource tracks.rename}" Command="{Binding Rename}"/>
            <MenuItem Classes="context" Header="{DynamicResource tracks.trackcolor}" Command="{Binding SelectTrackColor}"/>
            <MenuItem Classes="context" Header="{DynamicResource tracks.duplicate}" Command="{Binding Duplicate}"/>
            <MenuItem Classes="context" Header="{DynamicResource tracks.duplicatesettings}" Command="{Binding DuplicateSettings}"/>
            <MenuItem Classes="context" Header="{DynamicResource dialogs.voicecolorremapping}" Command="{Binding VoiceColorRemapping}"/>
            <Separator/>
            <!-- W45/S1′：引擎/轨道设置的第二条入口 —— 行高 42 档要把 ⚙ 从动作条挪走（动作条只剩
                 M/S/fx + 引擎状态点，合计 82 才能在同行放下），故卡片右键菜单必须有一条等价入口。
                 **复用同一个 `TrackSettingsButtonClicked`** ⇒ 入口两处、逻辑一处（与 §5.1 引擎 badge 同规格）。 -->
            <MenuItem Classes="context" Header="{DynamicResource tracks.tracksettings}"
                      Click="TrackSettingsButtonClicked"/>
            <MenuItem Classes="context" Header="{DynamicResource tracks.mixfx}" Command="{Binding OpenMixFxDialog}"/>
          </ContextMenu>
        </Grid.ContextMenu>
      </Grid>
    </Border>
  </Grid>
</UserControl>
