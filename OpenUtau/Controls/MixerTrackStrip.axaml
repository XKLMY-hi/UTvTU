<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:OpenUtau.App.Controls"
             x:Class="OpenUtau.App.Controls.MixerTrackStrip"
             Width="56" MinHeight="300">
  <UserControl.Styles>
    <Style Selector="Button.mixerBtn">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="1"/>
    </Style>
    <Style Selector="Button.mixerBtn.muteOn">
      <Setter Property="Background" Value="#E53935"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.mixerBtn.soloOn">
      <Setter Property="Background" Value="#FBC02D"/>
      <Setter Property="Foreground" Value="#1a1a1a"/>
    </Style>
    <Style Selector="Button.fxEntryBtn">
      <Setter Property="Height" Value="24"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="4,6,4,2"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrushPointerOver}"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.fxEntryBtn.fxActive">
      <Setter Property="BorderBrush" Value="{DynamicResource md3.color.primary}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.color.primary}"/>
    </Style>
    <Style Selector="TextBlock.sectionLabel">
      <Setter Property="FontSize" Value="8"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Opacity" Value="0.5"/>
      <Setter Property="Margin" Value="0,4,0,1"/>
    </Style>
    <Style Selector="TextBlock.trackNameSmall">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Margin" Value="2,3,2,0"/>
    </Style>
    <Style Selector="TextBox.volEdit">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontFamily" Value="{DynamicResource PlusFontFamilyMono}"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
  </UserControl.Styles>

  <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="0" CornerRadius="8" Margin="2,4"
          Padding="4,4,4,4"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Name="RootGrid">
      <!-- Row 0: LED 电平表（代码生成 10 段） -->
      <StackPanel Grid.Row="0" Name="LevelMeterPanel" Margin="8,4,8,2" Spacing="1"/>

      <!-- Row 1: 轨道色块 + 名称 -->
      <Grid Grid.Row="1" ColumnDefinitions="4,2,*" Margin="2,0">
        <Border Name="ColorBar" Width="4" Height="16" CornerRadius="2"
                VerticalAlignment="Center" Background="{DynamicResource AccentBrush1}"/>
        <TextBlock Grid.Column="2" Classes="trackNameSmall" Name="TrackNameLabel" Text="--"/>
      </Grid>

      <!-- Row 2: Mute / Solo -->
      <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="6,0">
        <Button Grid.Column="0" Classes="mixerBtn" Content="{DynamicResource mixer.mute}" Name="MuteBtn"
                Click="OnMuteClick" HorizontalAlignment="Right"/>
        <Button Grid.Column="1" Classes="mixerBtn" Content="{DynamicResource mixer.solo}" Name="SoloBtn"
                Click="OnSoloClick" HorizontalAlignment="Left"/>
      </Grid>

      <!-- Row 3: Pan knob（FL Studio 同款旋钮） -->
      <Grid Grid.Row="3" Margin="0,2">
        <c:PanKnob Name="PanKnobControl" HorizontalAlignment="Center"/>
      </Grid>

      <!-- Row 4: FADER（4px 轨道 + 横线拇指） -->
      <Grid Grid.Row="4" Name="FaderBox"
            Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
            Margin="8,2,8,2" MinHeight="100"
            ClipToBounds="True"
            PointerPressed="OnFaderPressed"
            PointerMoved="OnFaderMoved">
        <Border Name="FaderRail" Width="4" HorizontalAlignment="Center"
                CornerRadius="2" Background="#30FFFFFF" IsHitTestVisible="False"/>
        <Border Name="ThumbBar" Width="26" Height="4" CornerRadius="2"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="{DynamicResource AccentBrush1}"
                BorderBrush="{DynamicResource AccentBrush1}"
                BorderThickness="1" ZIndex="10"
                IsHitTestVisible="False"/>
      </Grid>

      <!-- Row 5: Volume value -->
      <TextBlock Grid.Row="5" Name="VolValueLabel" Classes="sectionLabel"
                 FontSize="11" Opacity="1.0"
                 Text="-3.0 dB"
                 PointerPressed="OnVolLabelPressed"/>

      <!-- Row 6: FX entry button (opens unified TrackEffectRack) -->
      <Button Grid.Row="6" Name="FxEntryBtn" Classes="fxEntryBtn"
              Content="{DynamicResource mixer.fx}" Click="OnFxEntryClick"/>
    </Grid>
  </Border>
</UserControl>
