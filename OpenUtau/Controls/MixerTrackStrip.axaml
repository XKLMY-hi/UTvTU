<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:OpenUtau.App.Controls" x:Class="OpenUtau.App.Controls.MixerTrackStrip" Width="120" MinHeight="480" Height="{Binding $parent[StackPanel].MinHeight}">
  <!-- 视觉布局：120px 通道、统一表头、弹性推子和固定读数区。保留原控件名称、命令与输入路由；颜色走 MD3 角色。 -->
  <UserControl.Styles>
    <Style Selector="Border#PanHitArea:focus-visible">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.primary}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeExtraSmall}"/>
    </Style>
    <Style Selector="Border#PanHitArea:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>
    <Style Selector="Button.mixerBtn">
      <Setter Property="Theme" Value="{StaticResource DawMixButtonTheme}"/>
      <Setter Property="MinHeight" Value="20"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>
    <Style Selector="Button.mixerBtn.muteOn">
      <Setter Property="Background" Value="{DynamicResource md3.error}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-error}"/>
    </Style>
    <Style Selector="Button.mixerBtn.soloOn">
      <Setter Property="Background" Value="{DynamicResource md3.primary}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-primary}"/>
    </Style>
    <Style Selector="TextBlock#TrackNameLabel">
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
    </Style>
    <Style Selector="Border#FaderHandle">
      <Setter Property="Background" Value="{DynamicResource md3.on-surface}"/>
    </Style>
    <Style Selector="Border#StripCard.selected TextBlock#TrackNameLabel">
      <Setter Property="Foreground" Value="{DynamicResource md3.primary}"/>
    </Style>
    <Style Selector="Border#StripCard.selected Border#FaderHandle">
      <Setter Property="Background" Value="{DynamicResource md3.primary}"/>
    </Style>
    <Style Selector="Border#StripCard">
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline-variant}"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container}"/>
    </Style>
    <Style Selector="Border#StripCard.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource md3.primary}"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>
    <Style Selector="Border#StripCard.selected Border.faderGrip">
      <Setter Property="Background" Value="{DynamicResource md3.on-primary}"/>
    </Style>
    <Style Selector="Button.mixerBtn">
      <Setter Property="MinHeight" Value="28"/>
    </Style>
  </UserControl.Styles>
  <Border Name="StripCard" Padding="10" CornerRadius="{DynamicResource Md3ShapeLarge}" BorderThickness="1">
    <Grid Name="RootGrid" RowSpacing="8" RowDefinitions="210,*,32">
      <Grid Name="ChannelHeader" RowDefinitions="3,32,76,28,28,*" RowSpacing="8" Grid.Row="0">
        <Border Grid.Row="0" Name="AccentBar" Height="3" CornerRadius="{DynamicResource Md3ShapeFull}" HorizontalAlignment="Stretch" Background="{DynamicResource md3.primary}"/>
        <TextBlock Grid.Row="1" Name="TrackNameLabel" FontSize="12" LineHeight="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="--" TextWrapping="Wrap" MaxHeight="32" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Border Grid.Row="2" Name="EqDisplay" Height="76" CornerRadius="{DynamicResource Md3ShapeSmall}" ClipToBounds="True" Background="{DynamicResource md3.surface-container-lowest}">
          <Grid>
            <c:MixerEqCurve Name="EqCurve" CurveBrush="{DynamicResource md3.primary}"/>
            <Border Name="EqZeroLine" Height="1" VerticalAlignment="Center" Background="{DynamicResource md3.outline-variant}"/>
            <TextBlock Text="EQ" FontSize="8" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <Border Grid.Row="3" Name="PanHitArea" Height="28" Margin="0" VerticalAlignment="Center" Background="{DynamicResource md3.surface-container-highest}" Cursor="SizeWestEast" Focusable="True" PointerPressed="OnPanPressed" PointerCaptureLost="OnPanCaptureLost" PointerWheelChanged="OnPanWheel" KeyDown="OnPanKeyDown" DoubleTapped="OnPanDoubleTapped" Padding="8,0" CornerRadius="8">
          <Border Name="PanRow" Height="18" VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Name="PanLabel" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource md3.on-surface-variant}" Text="{DynamicResource mixer.pan}"/>
              <TextBlock Grid.Column="1" Name="PanValueLabel" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource md3.on-surface}" Text="C"/>
            </Grid>
          </Border>
        </Border>
        <Grid Grid.Row="4" Name="MsRow" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Md3Spacing1}">
          <Button Grid.Column="0" Name="MuteBtn" Classes="mixerBtn" Height="28" MinHeight="28" CornerRadius="8" FontSize="{DynamicResource Md3TypeLabelTiny}" FontWeight="Bold" Click="OnMuteClick" Content="{DynamicResource mixer.mute}"/>
          <Button Grid.Column="1" Name="SoloBtn" Classes="mixerBtn" Height="28" MinHeight="28" CornerRadius="8" FontSize="{DynamicResource Md3TypeLabelTiny}" FontWeight="Bold" Click="OnSoloClick" Content="{DynamicResource mixer.solo}"/>
        </Grid>
        <Button Grid.Row="5" Name="EffectsButton" Theme="{StaticResource DawTextButtonTheme}" Click="OnOpenEffects" MinHeight="24" Height="24" Margin="0" Padding="4,0" FontSize="10" Content="FX" ToolTip.Tip="{DynamicResource rack.open}"/>
      </Grid>
      <Border Name="FaderWell" CornerRadius="12" Padding="4,12" Background="{DynamicResource md3.surface-container-lowest}" MinHeight="140" Grid.Row="1">
        <c:DawFader Name="FaderBox" Width="88" FocusBrush="{DynamicResource md3.primary}" AutomationProperties.Name="{DynamicResource controls.volume}" ToolTip.Tip="{DynamicResource controls.fader.tip}" HorizontalAlignment="Center" VerticalAlignment="Stretch">
          <Border Name="MeterBar" Width="8" Height="{Binding #FaderBox.Bounds.Height}" Canvas.Left="4" Canvas.Top="0" CornerRadius="{DynamicResource Md3ShapeFull}" ClipToBounds="True" Background="{DynamicResource md3.surface-container-highest}">
            <Border Name="MeterFill" Width="8" Height="0" CornerRadius="{DynamicResource Md3ShapeFull}" VerticalAlignment="Bottom" Background="{DynamicResource md3.primary}"/>
          </Border>
          <Border Name="FaderTrack" Width="4" Height="{Binding #FaderBox.Bounds.Height}" Canvas.Left="34" Canvas.Top="0" CornerRadius="{DynamicResource Md3ShapeFull}" Background="{DynamicResource md3.surface-container-highest}"/>
          <Border Name="FaderHandle" Width="28" Height="20" Canvas.Left="22" Canvas.Top="146" CornerRadius="6">
            <Grid IsHitTestVisible="False">
              <Border Classes="faderGrip" Width="14" Height="1" Margin="0,-3,0,0" VerticalAlignment="Center" Background="{DynamicResource md3.surface-container}"/>
              <Border Classes="faderGrip" Width="14" Height="1" Margin="0,3,0,0" VerticalAlignment="Center" Background="{DynamicResource md3.surface-container}"/>
            </Grid>
          </Border>
          <Border Name="FaderTick1" Width="8" Height="1" Canvas.Left="52" Canvas.Top="10" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick2" Width="8" Height="1" Canvas.Left="52" Canvas.Top="90" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick3" Width="8" Height="1" Canvas.Left="52" Canvas.Top="170" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick4" Width="8" Height="1" Canvas.Left="52" Canvas.Top="250" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick5" Width="8" Height="1" Canvas.Left="52" Canvas.Top="330" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick6" Width="8" Height="1" Canvas.Left="52" Canvas.Top="410" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick7" Width="8" Height="1" Canvas.Left="52" Canvas.Top="490" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick8" Width="4" Height="1" Canvas.Left="52" Canvas.Top="130" Background="{DynamicResource md3.outline-variant}"/>
          <Border Name="FaderTick9" Width="4" Height="1" Canvas.Left="52" Canvas.Top="370" Background="{DynamicResource md3.outline-variant}"/>
          <TextBlock Text="+12" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False" Canvas.Left="63" Canvas.Top="4" Name="FaderLabel1" LineHeight="12"/>
          <TextBlock Text="+6" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False" Canvas.Left="63" Canvas.Top="84" Name="FaderLabel2" LineHeight="12"/>
          <TextBlock Text="0" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False" Canvas.Left="63" Canvas.Top="164" Name="FaderLabel3" LineHeight="12"/>
          <TextBlock Text="−6" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False" Canvas.Left="63" Canvas.Top="244" Name="FaderLabel4" LineHeight="12"/>
          <TextBlock Text="−12" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False" Canvas.Left="63" Canvas.Top="324" Name="FaderLabel5" LineHeight="12"/>
          <TextBlock Text="−18" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False" Canvas.Left="63" Canvas.Top="404" Name="FaderLabel6" LineHeight="12"/>
          <TextBlock Text="−24" FontSize="9" FontFamily="{DynamicResource PlusFontFamilyMono}" Foreground="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False" Canvas.Left="63" Canvas.Top="484" Name="FaderLabel7" LineHeight="12"/>
        </c:DawFader>
      </Border>
      <Border Name="ReadoutWell" CornerRadius="8" Background="{DynamicResource md3.surface-container-highest}" Grid.Row="2">
        <Viewbox Height="24" Stretch="Uniform">
          <c:DawValueField Name="VolumeField" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource controls.volume}" ToolTip.Tip="{DynamicResource controls.value.tip}" Width="64" Height="16"/>
        </Viewbox>
      </Border>
    </Grid>
  </Border>
</UserControl>