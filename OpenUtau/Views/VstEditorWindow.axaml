<controls:WindowEx xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenUtau.App.Controls"
        x:Class="OpenUtau.App.Views.VstEditorWindow"
        Icon="/Assets/brand/utvtu.ico"
        Title="{DynamicResource vsteditor.title}" Width="420" Height="500"
        WindowStartupLocation="CenterOwner">
  <DockPanel LastChildFill="True">
    <Border>
    <DockPanel Margin="14" LastChildFill="True">
      <!-- Plugin info header -->
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Spacing="{DynamicResource Md3Spacing1}">
        <TextBlock FontWeight="SemiBold" FontSize="{DynamicResource Md3TypeTitleMedium}" Name="TitleLabel"/>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Name="TypeBadge" CornerRadius="{DynamicResource Md3DawCornerRadius}" Padding="5,1"
                  Background="{DynamicResource AccentBrush1Semi}">
            <TextBlock Name="TypeLabel" FontSize="{DynamicResource Md3TypeLabelTiny}" Foreground="{DynamicResource AccentBrush1}" FontWeight="SemiBold"/>
          </Border>
          <TextBlock Name="VendorLabel" FontSize="{DynamicResource Md3TypeLabelSmall}" Opacity="0.6" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>

      <!-- Metadata -->
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="2">
        <TextBlock Name="SubsLabel" FontSize="{DynamicResource Md3TypeLabelSmall}" Opacity="0.5" TextWrapping="Wrap"/>
        <TextBlock Name="PathLabel" FontSize="{DynamicResource Md3DawTypeReadout}" Opacity="0.3" TextWrapping="Wrap"/>
      </StackPanel>

      <!-- Parameter list area -->
      <Border DockPanel.Dock="Bottom" BorderThickness="0"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              CornerRadius="{DynamicResource Md3ShapeSmall}" Margin="0,4,0,4"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <DockPanel Margin="8" LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" FontSize="{DynamicResource Md3DawTypeReadout}" Opacity="0.4"
                     Text="{DynamicResource vsteditor.pluginparams}" Margin="0,0,0,4"/>
          <ScrollViewer Height="160" VerticalScrollBarVisibility="Auto">
            <TextBlock Name="NativeStatus" FontSize="{DynamicResource Md3TypeLabelTiny}" Opacity="0.6"
                       FontFamily="{DynamicResource PlusFontFamilyMono}" Text="{DynamicResource vsteditor.loading}"
                       TextWrapping="NoWrap"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Action buttons -->
      <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,6,0,0">
        <TextBlock Name="ParamInfo" FontSize="{DynamicResource Md3TypeLabelTiny}" Opacity="0.4" TextAlignment="Center"/>
        <Button Name="OpenEditorBtn" Content="{DynamicResource vsteditor.opengui}"
                Height="32" MinHeight="32" FontSize="{DynamicResource Md3TypeBodySmall}" FontWeight="SemiBold"
                Click="OnOpenEditorClick"
                IsEnabled="False"/>
        <Button Content="{DynamicResource vsteditor.close}" Height="28" MinHeight="28" FontSize="{DynamicResource Md3TypeLabelSmall}"
                Click="OnCloseClick"/>
      </StackPanel>
    </DockPanel>
  </Border>
  </DockPanel>
</controls:WindowEx>
