<controls:WindowEx xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:OpenUtau.App.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" MinWidth="260" MinHeight="240" Width="380" Height="340"
        x:Class="OpenUtau.App.Views.PasteParamDialog"
        Icon="/Assets/brand/utvtu.ico"
        Title="{DynamicResource context.note.pasteparameters}"
        WindowStartupLocation="CenterOwner">
<DockPanel LastChildFill="True">
      <Border>
  <Grid RowDefinitions="*, 40" >
    <ListBox SelectionMode="Multiple,Toggle" ItemsSource="{Binding Params}"
             Grid.Row="0" Margin="10" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" >
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="IsSelected" Value="{Binding IsSelected}"/>
          <Setter Property="Focusable" Value="False"/>
        </Style>
      </ListBox.Styles>
    </ListBox>

    <Button Content="{DynamicResource button.ok}" Click="OkButtonClick" Grid.Row="1" Width="100" HorizontalAlignment="Center"/>
  </Grid>
      </Border>
    </DockPanel>
</controls:WindowEx>
