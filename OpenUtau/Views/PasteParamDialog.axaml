<controls:WorkspaceToolView xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:OpenUtau.App.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="OpenUtau.App.Views.PasteParamDialog"
        Title="{DynamicResource context.note.pasteparameters}" Focusable="True">
<DockPanel LastChildFill="True">
      <Border>
  <Grid RowDefinitions="*, 40" >
    <ListBox SelectionMode="Multiple,Toggle" ItemsSource="{Binding Params}"
             Grid.Row="0" Margin="10" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" >
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="IsSelected" Value="{Binding IsSelected}"/>
          <Setter Property="Focusable" Value="False"/>
        </Style>
      </ListBox.Styles>
    </ListBox>

    <Button Classes="primary dialogAction" Content="{DynamicResource button.ok}" Click="OkButtonClick" Grid.Row="1" HorizontalAlignment="Right" Margin="16,0"/>
  </Grid>
      </Border>
    </DockPanel>
</controls:WorkspaceToolView>
