<controls:WindowEx xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OpenUtau.App.ViewModels"
        xmlns:c="clr-namespace:OpenUtau.App.Controls"
        xmlns:controls="clr-namespace:OpenUtau.App.Controls"
        xmlns:views="using:OpenUtau.App.Views"
        xmlns:motion="using:OpenUtau.Theming"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="OpenUtau.App.Views.MainWindow"
        Icon="/Assets/open-utau.ico"
        Title="{Binding Title}" MinWidth="300" MinHeight="200" Width="{Binding Width}" Height="{Binding Height}"
        Focusable="True" KeyDown="OnKeyDown" PointerPressed="OnPointerPressed" Closing="WindowClosing"
        SizeChanged="OnWindowSizeChanged"
        DragDrop.AllowDrop="True">
  <!-- 主窗骨架（对齐设计稿 2-Main-Window）：
       顶栏 56（品牌=菜单 · 运输条 40 胶囊 · 时间/速度 40 圆角块 · 右侧图标组）
       / 工作区：左 轨道头 264（表头 34）· 中 编排区 · 右 素材库 296（表头 44 / 页签 40）
       / 状态条 32。颜色一律取 md3 角色键；编排区、卷帘、混音台的内部绘制仍走旧画笔，按 S2–S5 逐步迁。 -->
  <Window.Styles>
    <Style Selector="Button,ToggleButton">
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <!-- 顶栏：圆形图标按钮 36（稿：36×36 圆角 999） -->
    <Style Selector="Button.topBtn">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.topBtn:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>
    <!-- 顶栏：品牌=菜单触发器（无边框、hover 提亮） -->
    <Style Selector="Button.brandBtn">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.brandBtn:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>
    <!-- 顶栏：运输条按钮（40 胶囊内的 36 圆钮） -->
    <Style Selector="Button.tpBtn">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.tpBtn:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
    </Style>
    <Style Selector="ToggleButton.tpBtn">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton.tpBtn:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
    </Style>
    <Style Selector="ToggleButton.tpBtn:checked">
      <Setter Property="Background" Value="{DynamicResource md3.primary}"/>
    </Style>
    <!-- 顶栏：播放键 = primary 实底圆钮 -->
    <Style Selector="Button.tpPlay">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource md3.primary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.tpPlay:pointerover">
      <Setter Property="Opacity" Value="0.92"/>
    </Style>
    <!-- 顶栏：时间 / 速度圆角块（面板之上提一档 = 控件层） -->
    <Style Selector="Border.tpChip">
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 顶栏：视图胶囊（决策 A4 / 设计稿 VST-Plugin Tab Bar 同源规格）
         容器 高 36 / 内边距 3 / 圆角 full；选项 高 30 / 左右 18 / 文字 11px semibold；同组间距 3 -->
    <Style Selector="Border.viewSwitch">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="3"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.viewTab">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.viewTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
    </Style>
    <Style Selector="Button.viewTab.selected">
      <Setter Property="Background" Value="{DynamicResource md3.secondary-container}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-secondary-container}"/>
    </Style>
    <!-- 素材库：页签胶囊（稿：高 28 / 文字 10） -->
    <Style Selector="Button.libTab">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.libTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>
    <Style Selector="Button.libTab.selected">
      <Setter Property="Background" Value="{DynamicResource md3.secondary-container}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-secondary-container}"/>
    </Style>
    <!-- 素材库：内容区小图标按钮 -->
    <Style Selector="Button.iconBtn">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.iconBtn:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>
    <!-- 素材库：列表项 / 卡片 / 小标题（内容细化留 S4，先沿用结构） -->
    <Style Selector="Border.sideItem">
      <Setter Property="Height" Value="44"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.sideItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>
    <Style Selector="Border.sideItem.small">
      <Setter Property="Height" Value="38"/>
    </Style>
    <Style Selector="Border.sideItem.singer">
      <Setter Property="Height" Value="62"/>
    </Style>
    <Style Selector="TextBlock.sideHeading">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
      <Setter Property="Margin" Value="2,4,0,4"/>
    </Style>
    <Style Selector="Border.sideCard">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline-variant}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Styles>
  <!-- 窗口装饰已交还系统（原生标题栏），内容不再为自绘标题栏留白 -->
  <Border Padding="0">
  <Grid>
    <!-- MainGrid：主内容（overlay 时模糊目标） -->
    <Grid x:Name="MainGrid" RowDefinitions="56,*,32">
      <!-- ══════════ 顶栏 56：品牌(=菜单) · 运输条 · 时间/速度 · 右侧图标 ══════════ -->
      <Border Grid.Row="0" Background="{DynamicResource md3.surface-container}"
              BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,0">
          <!-- 品牌 = 菜单按钮（稿：36 标记 + UTVTU + 分隔线 + 屏名） -->
          <Button Grid.Column="0" x:Name="AppMenuButton" Classes="brandBtn" Click="OnAppMenuClicked">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="{DynamicResource menu.file}">
                  <MenuItem Header="{DynamicResource menu.file.new}" InputGesture="Ctrl+N" Click="OnMenuNew"/>
                  <MenuItem Header="{DynamicResource menu.file.newfromtemplate}" ItemsSource="{Binding OpenTemplatesMenuItems}" Classes="MenuItemWithSubMenu"/>
                  <MenuItem Header="{DynamicResource menu.file.savetemplate}" Click="OnMenuSaveTemplate"/>
                  <MenuItem Header="-" Height="1"/>
                  <MenuItem Header="{DynamicResource menu.file.open}" InputGesture="Ctrl+O" Click="OnMenuOpen"/>
                  <MenuItem Header="{DynamicResource menu.file.openrecent}" ItemsSource="{Binding OpenRecentMenuItems}" Classes="MenuItemWithSubMenu"/>
                  <MenuItem Header="{DynamicResource menu.file.openprojectlocation}" Click="OnMenuOpenProjectLocation"/>
                  <MenuItem Header="-" Height="1"/>
                  <MenuItem Header="{DynamicResource menu.file.save}" InputGesture="Ctrl+S" Click="OnMenuSave"/>
                  <MenuItem Header="{DynamicResource menu.file.saveas}"  InputGesture="Ctrl+Shift+S" Click="OnMenuSaveAs"/>
                  <MenuItem Header="-" Height="1"/>
                  <MenuItem Header="{DynamicResource menu.file.importtracks}" Click="OnMenuImportTracks"/>
                  <MenuItem Header="{DynamicResource menu.file.importaudio}" Click="OnMenuImportAudio"/>
                  <MenuItem Header="-" Height="1"/>
                  <MenuItem Header="{DynamicResource menu.file.exportaudio}">
                    <MenuItem Header="{DynamicResource menu.file.render}" InputGesture="Ctrl+Shift+R" Click="OnMenuRender"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource menu.file.exportwav}" Click="OnMenuExportWav"/>
                    <MenuItem Header="{DynamicResource menu.file.exportwavto}" Click="OnMenuExportWavTo"/>
                    <MenuItem Header="{DynamicResource menu.file.exportmixdown}" Click="OnMenuExportMixdown"/>
                  </MenuItem>
                  <MenuItem Header="{DynamicResource menu.file.exportproject}">
                    <MenuItem Header="{DynamicResource menu.file.exportust}" Click="OnMenuExportUst"/>
                    <MenuItem Header="{DynamicResource menu.file.exportustto}" Click="OnMenuExportUstTo"/>
                    <MenuItem Header="{DynamicResource menu.file.exportmidi}" Click="OnMenuExportMidi"/>
                    <MenuItem Header="{DynamicResource menu.file.exportds}" Click="OnMenuExportDsTo"/>
                  </MenuItem>
                  <MenuItem Header="{DynamicResource menu.file.openexportlocation}" Click="OnMenuOpenProjectLocation"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource menu.edit}">
                  <MenuItem Header="{Binding UndoText}" InputGesture="Ctrl+Z" Command="{Binding Undo}" IsEnabled="{Binding CanUndo}"/>
                  <MenuItem Header="{Binding RedoText}" InputGesture="Ctrl+Y" Command="{Binding Redo}" IsEnabled="{Binding CanRedo}"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource menu.project}">
                  <MenuItem Header="{DynamicResource menu.project.expressions}" Click="OnMenuExpressionss"/>
                  <MenuItem Header="{DynamicResource menu.project.remaptimeaxis}" Click="OnMenuRemapTimeaxis"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource menu.tools}">
                  <MenuItem Header="{DynamicResource menu.tools.layout}">
                    <MenuItem Header="{DynamicResource menu.tools.layout.reset}" Click="OnMenuLayoutReset"/>
                    <MenuItem Header="{DynamicResource menu.tools.layout.vsplit11}" Click="OnMenuLayoutVSplit11"/>
                    <MenuItem Header="{DynamicResource menu.tools.layout.vsplit12}" Click="OnMenuLayoutVSplit12"/>
                    <MenuItem Header="{DynamicResource menu.tools.layout.vsplit13}" Click="OnMenuLayoutVSplit13"/>
                    <MenuItem Header="{DynamicResource menu.tools.layout.hsplit11}" Click="OnMenuLayoutHSplit11"/>
                    <MenuItem Header="{DynamicResource menu.tools.layout.hsplit12}" Click="OnMenuLayoutHSplit12"/>
                    <MenuItem Header="{DynamicResource menu.tools.layout.hsplit13}" Click="OnMenuLayoutHSplit13"/>
                  </MenuItem>
                  <MenuItem Header="{DynamicResource menu.tools.fullscreen}" InputGesture="F11" Click="OnMenuFullScreen"/>
                  <MenuItem Header="{Binding ClearCacheHeader}" Click="OnMenuClearCache"/>
                  <MenuItem Header="{DynamicResource menu.tools.debugwindow}" Click="OnMenuDebugWindow"/>
                  <!-- fx-rack：控件陈列室（MD3 机架控件家族审阅入口） -->
                  <MenuItem Header="{DynamicResource menu.tools.controlgallery}" Click="OnMenuControlGallery"/>
                  <MenuItem Header="{DynamicResource menu.tools.mixer}" InputGesture="Ctrl+M" Click="OnMenuMixer"/>
                  <MenuItem Header="{DynamicResource phoneticassistant.caption}" Click="OnMenuPhoneticAssistant"/>
                  <MenuItem Header="{DynamicResource menu.tools.singers}" Click="OnMenuSingers"/>
                  <MenuItem Header="{DynamicResource menu.tools.singer.install}" Click="OnMenuInstallSinger"/>
                  <MenuItem Header="{DynamicResource menu.tools.wavtoolresampler.install}" Click="OnMenuInstallWavtoolResampler"/>
                  <MenuItem Header="{DynamicResource menu.tools.packages}" Click="OnMenuPackageManager"/>
                  <MenuItem Header="{DynamicResource menu.tools.prefs}" Click="OnMenuPreferences"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource menu.help}">
                  <MenuItem Header="{DynamicResource menu.help.wiki}" Click="OnMenuWiki"/>
                  <MenuItem Header="{DynamicResource menu.help.checkupdate}" Click="OnMenuCheckUpdate"/>
                  <MenuItem Header="{DynamicResource menu.help.reportissue}" Click="OnMenuReportIssue"/>
                  <MenuItem Header="{DynamicResource menu.help.logslocation}" Click="OnMenuLogsLocation"/>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Width="36" Height="36" CornerRadius="8" VerticalAlignment="Center"
                      Background="{DynamicResource md3.primary-container}">
                <Path Data="{StaticResource icon-music}" Width="18" Height="18" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Fill="{DynamicResource md3.on-primary-container}"/>
              </Border>
              <TextBlock Text="UTvTU" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                         Foreground="{DynamicResource md3.on-surface}"/>
              <Border Width="1" Height="20" VerticalAlignment="Center"
                      Background="{DynamicResource md3.outline-variant}"/>
              <TextBlock x:Name="ScreenTitle" Text="{DynamicResource view.workspace}" FontSize="11" VerticalAlignment="Center"
                         Foreground="{DynamicResource md3.on-surface-variant}"/>
            </StackPanel>
          </Button>

          <!-- 运输组（运输条 + 播放位置 + 速度/拍号）：仅工作台视图显示（欢迎页/偏好页的稿子顶栏没有它） -->
          <StackPanel x:Name="TransportGroup" Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <!-- 运输条（稿：40 胶囊，内边距 0/10，按钮 36） -->
          <Border Classes="tpChip" Height="40"
                  CornerRadius="999" Padding="10,0">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Classes="tpBtn" Command="{Binding PlaybackViewModel.SeekStart}">
                <Path Data="{StaticResource icon-skip-back}" Width="16" Height="16" Stretch="Uniform"
                      Fill="{DynamicResource md3.on-surface}"/>
              </Button>
              <Button Classes="tpPlay" Click="OnPlayOrPause">
                <Path Data="{StaticResource icon-play}" Width="16" Height="16" Stretch="Uniform"
                      Fill="{DynamicResource md3.on-primary}"/>
              </Button>
              <Button Classes="tpBtn" Command="{Binding PlaybackViewModel.Pause}">
                <Path Data="{StaticResource icon-pause}" Width="16" Height="16" Stretch="Uniform"
                      Fill="{DynamicResource md3.on-surface}"/>
              </Button>
              <Button Classes="tpBtn" Command="{Binding PlaybackViewModel.SeekEnd}">
                <Path Data="{StaticResource icon-skip-forward}" Width="16" Height="16" Stretch="Uniform"
                      Fill="{DynamicResource md3.on-surface}"/>
              </Button>
              <ToggleButton Classes="tpBtn" IsChecked="{Binding PlaybackViewModel.Metronome}"
                            ToolTip.Tip="{DynamicResource prefs.playback.metronome}">
                <Path Data="{StaticResource icon-metronome}" Width="16" Height="16" Stretch="Uniform"
                      Fill="{DynamicResource md3.on-surface}"/>
              </ToggleButton>
            </StackPanel>
          </Border>

          <!-- 播放位置（稿：40 圆角块，内边距 0/14，14px） -->
          <Border Classes="tpChip" Padding="14,0">
            <TextBlock Text="{Binding Path=PlaybackViewModel.PlayPosTime, StringFormat={}{0:mm\\:ss\\.fff}}"
                       FontSize="14" VerticalAlignment="Center"
                       Foreground="{DynamicResource md3.on-surface}"/>
          </Border>

          <!-- 速度 / 拍号（稿：同款圆角块，14px） -->
          <Border Classes="tpChip" Padding="14,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Background="Transparent" PointerPressed="OnEditBpm" Cursor="Hand"
                         FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                         Foreground="{DynamicResource md3.primary}">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0:#0.00}">
                    <Binding Path="PlaybackViewModel.Bpm"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <TextBlock Background="Transparent" PointerPressed="OnEditTimeSignature" Cursor="Hand"
                         FontSize="14" VerticalAlignment="Center"
                         Foreground="{DynamicResource md3.on-surface}">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} / {1}">
                    <Binding Path="PlaybackViewModel.BeatPerBar"/>
                    <Binding Path="PlaybackViewModel.BeatUnit"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </Border>

          </StackPanel>

          <!-- 视图胶囊（A1/A4/S5）：工作台 / 钢琴卷帘 / 混音台 —— 同一工作区里互斥显示的三个视图。
               欢迎页与偏好设置保持 overlay 行为，不进胶囊（ShowViewSwitcher=false）。
               「分离」是视图级动作（A2/A5：稿里的最小化·最大化·关闭三钮收敛成一个分离按钮）。 -->
          <StackPanel x:Name="ViewSwitcherGroup" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="ViewSwitcher" Classes="viewSwitch">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Button x:Name="ViewTabWorkspace" Classes="viewTab" Tag="workspace"
                        Classes.selected="{Binding ViewSwitcher.ShowWorkspace}"
                        Click="OnViewTabClicked" Content="{DynamicResource view.workspace}"/>
                <Button x:Name="ViewTabPianoRoll" Classes="viewTab" Tag="pianoroll"
                        Classes.selected="{Binding ViewSwitcher.ShowPianoRoll}"
                        Click="OnViewTabClicked" Content="{DynamicResource view.pianoroll}"/>
                <Button x:Name="ViewTabMixer" Classes="viewTab" Tag="mixer"
                        Classes.selected="{Binding ViewSwitcher.ShowMixer}"
                        Click="OnViewTabClicked" Content="{DynamicResource view.mixer}"/>
              </StackPanel>
            </Border>
            <Button x:Name="DetachViewButton" Classes="topBtn" Click="OnDetachViewClicked"
                    ToolTip.Tip="{DynamicResource view.detach}">
              <Path Data="{StaticResource icon-external-link}" Width="16" Height="16" Stretch="Uniform"
                    Fill="{DynamicResource md3.on-surface-variant}"/>
            </Button>
          </StackPanel>

          <!-- 右侧：撤销/重做 · 布局 · 混音台 · 设置 · 轨道高度（三个工作视图都显示；欢迎/偏好不显示） -->
          <StackPanel x:Name="TopRightCluster" Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Classes="topBtn" Command="{Binding Undo}" IsEnabled="{Binding CanUndo}"
                    ToolTip.Tip="{DynamicResource menu.edit.undo}">
              <Path Data="{StaticResource icon-undo}" Width="16" Height="16" Stretch="Uniform"
                    Fill="{DynamicResource md3.on-surface}"/>
            </Button>
            <Button Classes="topBtn" Command="{Binding Redo}" IsEnabled="{Binding CanRedo}"
                    ToolTip.Tip="{DynamicResource menu.edit.redo}">
              <Path Data="{StaticResource icon-redo}" Width="16" Height="16" Stretch="Uniform"
                    Fill="{DynamicResource md3.on-surface}"/>
            </Button>
            <Border Width="1" Height="20" Margin="6,0" VerticalAlignment="Center"
                    Background="{DynamicResource md3.outline-variant}"/>
            <Button Classes="topBtn" ToolTip.Tip="{DynamicResource menu.tools.layout}">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="{DynamicResource menu.tools.layout.reset}" Click="OnMenuLayoutReset"/>
                  <MenuItem Header="{DynamicResource menu.tools.layout.vsplit11}" Click="OnMenuLayoutVSplit11"/>
                  <MenuItem Header="{DynamicResource menu.tools.layout.vsplit12}" Click="OnMenuLayoutVSplit12"/>
                  <MenuItem Header="{DynamicResource menu.tools.layout.vsplit13}" Click="OnMenuLayoutVSplit13"/>
                  <MenuItem Header="{DynamicResource menu.tools.layout.hsplit11}" Click="OnMenuLayoutHSplit11"/>
                  <MenuItem Header="{DynamicResource menu.tools.layout.hsplit12}" Click="OnMenuLayoutHSplit12"/>
                  <MenuItem Header="{DynamicResource menu.tools.layout.hsplit13}" Click="OnMenuLayoutHSplit13"/>
                </MenuFlyout>
              </Button.Flyout>
              <Path Data="{StaticResource icon-layout}" Width="16" Height="16" Stretch="Uniform"
                    Fill="{DynamicResource md3.on-surface}"/>
            </Button>
            <Button Classes="topBtn" Click="OnMenuMixer" ToolTip.Tip="{DynamicResource menu.tools.mixer}">
              <Path Data="{StaticResource icon-sliders}" Width="16" Height="16" Stretch="Uniform"
                    Fill="{DynamicResource md3.on-surface}"/>
            </Button>
            <Button Classes="topBtn" Click="OnMenuPreferences" ToolTip.Tip="{DynamicResource menu.tools.prefs}">
              <Path Data="{StaticResource icon-settings}" Width="16" Height="16" Stretch="Uniform"
                    Fill="{DynamicResource md3.on-surface}"/>
            </Button>
            <Border Width="1" Height="20" Margin="6,0" VerticalAlignment="Center"
                    Background="{DynamicResource md3.outline-variant}"/>
            <Border Height="24" VerticalAlignment="Center" PointerWheelChanged="ViewScalerPointerWheelChanged">
              <c:ViewScaler Name="VScaler" DataContext="{Binding TracksViewModel}"
                            Value="{Binding TrackHeight}"
                            Min="{Binding TrackHeightMin}" Max="{Binding TrackHeightMax}"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ══════════ 工作区：左 轨道头 264 · 中 编排区 · 右 素材库 296 ══════════
           工作台视图 = 这三列；**钢琴卷帘 / 混音台是铺满整行的视图**（设计稿里两者都是整屏，
           混音台区还是「满宽」，且 W1 的链面板要占 280）→ 覆盖列而非挤在编排区里。
           三列的列宽固定、视图宿主只翻 IsVisible ⇒ 切换不参与布局、无抖动。 -->
      <Grid Grid.Row="1" x:Name="MainLayout" ColumnDefinitions="264,*,296">
        <!-- ── 左：轨道头（面板层；仅工作台视图） ── -->
        <Border Grid.Column="0" Background="{DynamicResource md3.surface-container}"
                IsVisible="{Binding ViewSwitcher.ShowWorkspace}"
                BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="0,0,1,0">
          <Grid RowDefinitions="34,16,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,0">
              <TextBlock Text="{DynamicResource command.import.track}" FontSize="11" FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource md3.on-surface-variant}"/>
              <Button Grid.Column="1" Classes="topBtn" Width="22" Height="22" Click="OnAddTrack"
                      ToolTip.Tip="{DynamicResource command.track.add}">
                <Path Data="{StaticResource icon-plus}" Width="12" Height="12" Stretch="Uniform"
                      Fill="{DynamicResource md3.on-surface-variant}"/>
              </Button>
            </Grid>
            <c:TrackHeaderCanvas Grid.Row="2" ClipToBounds="True" Background="Transparent"
                                DataContext="{Binding TracksViewModel}"
                                TrackHeight="{Binding TrackHeight}"
                                TrackOffset="{Binding TrackOffset}"
                                Items="{Binding Tracks}"
                                PointerWheelChanged="MainPagePointerWheelChanged"/>
          </Grid>
        </Border>

        <!-- ── 中：编排区（工作台视图：标尺 34 / 横向滚动 16 / 轨道区）── -->
        <Grid Grid.Column="1" ColumnDefinitions="*,8" Background="{DynamicResource md3.surface}"
              IsVisible="{Binding ViewSwitcher.ShowWorkspace}">
          <Grid Grid.Row="0" Grid.Column="0" x:Name="ArrangementArea">
            <!-- 标尺 34 / 横向滚动 16 / 轨道区（与外壳契约 MainWindowShellTests 同形） -->
            <Grid.RowDefinitions>
              <RowDefinition Height="34"/>
              <RowDefinition Height="16"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollBar Name="HScrollBar" Classes="music" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Margin="0,2,0,2" Orientation="Horizontal" AllowAutoHide="False"
                      DataContext="{Binding TracksViewModel}"
                      Maximum="{Binding HScrollBarMax, Mode=OneWay}"
                      Value="{Binding TickOffset}"
                      ViewportSize="{Binding ViewportTicks}"
                      LargeChange="{Binding ViewportTicks}"
                      SmallChange="{Binding SmallChangeX}" PointerWheelChanged="HScrollPointerWheelChanged"/>
            <Canvas Name="TimelineCanvas" Grid.Row="0" Grid.Column="0"
                    Background="Transparent" ClipToBounds="True"
                    PointerWheelChanged="TimelinePointerWheelChanged"
                    PointerPressed="TimelinePointerPressed"
                    PointerMoved="TimelinePointerMoved"
                    PointerReleased="TimelinePointerReleased"
                    DoubleTapped="TimelineDoubleTapped">
              <Path Name="PlayPos"
                    Canvas.Left="{Binding TracksViewModel.PlayPosX}"
                    Canvas.Top="0" ZIndex="100" IsHitTestVisible="False"
                    Fill="{DynamicResource NeutralAccentBrushSemi}"
                    Data="M -6.5 0 L 6.5 0 L 6.5 3 L 0 9 L -6.5 3 Z"/>
              <Canvas.ContextMenu>
                <ContextMenu Name="TimelineContextMenu" ItemsSource="{Binding TimelineContextMenuItems}">
                  <ContextMenu.Styles>
                    <Style Selector="MenuItem">
                      <Setter Property="Header" Value="{Binding Header}"/>
                      <Setter Property="Command" Value="{Binding Command}"/>
                      <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
                      <Setter Property="ItemsSource" Value="{Binding Items}"/>
                    </Style>
                  </ContextMenu.Styles>
                </ContextMenu>
              </Canvas.ContextMenu>
            </Canvas>
            <c:TrackBackground Grid.Row="2" Grid.Column="0" Margin="0" IsHitTestVisible="False"
                              Foreground="{DynamicResource TrackBackgroundAltBrush}"
                              DataContext="{Binding TracksViewModel}"
                              Bounds="{Binding Bounds, Mode=OneWayToSource}"
                              TrackHeight="{Binding TrackHeight}"
                              TrackOffset="{Binding TrackOffset}"/>
            <c:TickBackground Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Margin="0" IsHitTestVisible="False"
                              Foreground="{DynamicResource TickLineBrush}"
                              Background="{DynamicResource TickLineBrushLow}"
                              Resolution="{Binding PlaybackViewModel.Resolution}"
                              TickWidth="{Binding TracksViewModel.TickWidth}"
                              TickOffset="{Binding TracksViewModel.TickOffset}"
                              SnapDiv="{Binding TracksViewModel.SnapDiv}"
                              SnapTicks="{Binding TracksViewModel.SnapTicks}"
                              ShowBar="True"/>
            <c:PartsCanvas x:Name="partsCanvas" Grid.Row="2" Grid.Column="0" ClipToBounds="True" Background="Transparent"
                          DataContext="{Binding TracksViewModel}"
                          TickWidth="{Binding TickWidth}"
                          TrackHeight="{Binding TrackHeight}"
                          TickOffset="{Binding TickOffset}"
                          TrackOffset="{Binding TrackOffset}"
                          PianoRollOpenPart="{Binding PianoRollOpenPart}"
                          PianoRollViewTickOffset="{Binding PianoRollViewTickOffset}"
                          PianoRollViewViewportTicks="{Binding PianoRollViewViewportTicks}"
                          Items="{Binding Parts}"
                          PointerPressed="PartsCanvasPointerPressed"
                          PointerMoved="PartsCanvasPointerMoved"
                          PointerReleased="PartsCanvasPointerReleased"
                          DoubleTapped="PartsCanvasDoubleTapped"
                          PointerWheelChanged="MainPagePointerWheelChanged">
              <Rectangle Name="PlayPosHighlight"
                        Width="{Binding PlayPosHighlightWidth, Mode=OneWay}"
                        Height="{Binding $parent.Bounds.Height, Mode=OneWay}"
                        Canvas.Left="{Binding PlayPosHighlightX, Mode=OneWay}"
                        Canvas.Top="0"
                        Fill="{DynamicResource NeutralAccentBrushSemi2}"
                        IsVisible="{Binding $parent[Window].DataContext.PlaybackViewModel.ShowPlayPosHighlight}"
                        IsHitTestVisible="False"/>
              <Rectangle Name="PlayPosLine"
                         Canvas.Left="{Binding PlayPosX}"
                         Canvas.Top="0" Width="1"
                         Height="{Binding $parent.Bounds.Height, Mode=OneWay}"
                         ZIndex="99" IsHitTestVisible="False"
                         IsVisible="{Binding $parent[Window].DataContext.PlaybackViewModel.IsPlaying}"
                         Fill="{DynamicResource AccentBrush2}"/>
              <Rectangle Name="SelectionBox" StrokeThickness="2"
                         Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                         Fill="{DynamicResource TickLineBrushLow}" ZIndex="1000"
                         IsHitTestVisible="False" IsVisible="False"/>
              <c:PartsCanvas.ContextMenu>
                <ContextMenu Name="PartsContextMenu"
                            Opening="PartsContextMenuOpening"
                            Closing="PartsContextMenuClosing">
                  <MenuItem Header="{DynamicResource context.part.delete}"
                            Command="{Binding PartDeleteCommand}"
                            CommandParameter="{Binding Part}"/>
                  <MenuItem Header="{DynamicResource context.part.gotofile}"
                            IsVisible="{Binding IsWavePart}"
                            Command="{Binding PartGotoFileCommand}"
                            CommandParameter="{Binding Part}"/>
                  <MenuItem Header="{DynamicResource context.part.replaceaudio}"
                            IsVisible="{Binding IsWavePart}"
                            Command="{Binding PartReplaceAudioCommand}"
                            CommandParameter="{Binding Part}"/>
                  <MenuItem Header="{DynamicResource context.part.transcribe}"
                            IsVisible="{Binding IsWavePart}"
                            Command="{Binding PartTranscribeCommand}"
                            CommandParameter="{Binding Part}"/>
                  <MenuItem Header="{DynamicResource context.part.rename}"
                            IsVisible="{Binding IsVoicePart}"
                            Command="{Binding PartRenameCommand}"
                            CommandParameter="{Binding Part}"/>
                  <MenuItem Header="{DynamicResource context.part.merge}"
                            IsVisible="{Binding IsVoicePart}"
                            Command="{Binding PartMergeCommand}"
                            CommandParameter="{Binding Part}"/>
                  <MenuItem Header="{DynamicResource context.part.split}"
                            IsVisible="{Binding IsVoicePart}"
                            Command="{Binding PartSplitCommand}"
                            CommandParameter="{Binding Part}"/>
                  <MenuItem Header="{DynamicResource context.part.applypitch}"
                            IsVisible="{Binding IsVoicePart}"
                            ItemsSource="{Binding PartApplyPitchMenuItems}"
                            Classes="MenuItemWithSubMenu"/>
                </ContextMenu>
              </c:PartsCanvas.ContextMenu>
            </c:PartsCanvas>
            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                    ClipToBounds="True" IsHitTestVisible="False">
              <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10,5"
                      IsVisible="{Binding TracksViewModel.PlayPosWaitingRendering}" Background="{DynamicResource BackgroundBrushSemi}">
                <TextBlock Text="{DynamicResource progress.waitingrendering}" FontSize="15"/>
              </Border>
            </Border>
          </Grid>

          <!-- 轨道区纵向滚动条 -->
          <ScrollBar Name="VScrollBar" Grid.Column="1" Classes="music" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Margin="0,50,0,0" Orientation="Vertical" AllowAutoHide="False"
                    DataContext="{Binding TracksViewModel}"
                    Maximum="{Binding VScrollBarMax, Mode=OneWay}"
                    Value="{Binding TrackOffset}"
                    ViewportSize="{Binding ViewportTracks}"
                    LargeChange="{Binding ViewportTracks}"
                    SmallChange="{Binding SmallChangeY}" PointerWheelChanged="VScrollPointerWheelChanged"/>
        </Grid>

        <!-- ── 右：素材库 296（表头 44 / 页签 40 / 内容；工作台与混音台可见 —— 混音台里要能拖插件进链面板）── -->
        <Border Grid.Column="2" Background="{DynamicResource md3.surface-container}"
                IsVisible="{Binding ViewSwitcher.ShowLibrary}"
                BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="1,0,0,0">
          <Grid RowDefinitions="44,40,*">
            <!-- 表头 -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto" Margin="12,0">
              <TextBlock Text="{DynamicResource sidebar.library}" FontSize="11" FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource md3.on-surface-variant}"/>
              <Button Grid.Column="1" Classes="topBtn" Width="26" Height="26" VerticalAlignment="Center"
                      ToolTip.Tip="{DynamicResource sidebar.refresh}">
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="{DynamicResource sidebar.refresh}" Click="OnRefreshSingers"/>
                    <MenuItem Header="{DynamicResource sidebar.refresh}" Click="OnRefreshSamples"/>
                    <MenuItem Header="{DynamicResource menu.tools.singer.install}" Click="OnMenuInstallSinger"/>
                    <MenuItem Header="{DynamicResource menu.tools.packages}" Click="OnMenuPackageManager"/>
                  </MenuFlyout>
                </Button.Flyout>
                <Path Data="{StaticResource icon-list}" Width="14" Height="14" Stretch="Uniform"
                      Fill="{DynamicResource md3.on-surface-variant}"/>
              </Button>
              </Grid>
            </Border>

            <!-- 页签：音源 / 音频 / MIDI / 效果器 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="12,0"
                        VerticalAlignment="Center">
              <Button x:Name="SingersTab" Classes="libTab selected" Click="OnShowSingers"
                      Content="{DynamicResource sidebar.singers}"/>
              <Button x:Name="SamplesTab" Classes="libTab" Click="OnShowSamples"
                      Content="{DynamicResource sidebar.samples}"/>
              <Button x:Name="MidiTab" Classes="libTab" Click="OnShowMidi"
                      Content="{DynamicResource sidebar.midi}"/>
              <Button x:Name="EffectsTab" Classes="libTab" Click="OnShowVst"
                      Content="{DynamicResource sidebar.effects}"/>
            </StackPanel>

            <!-- 内容：音源 / 音频 / MIDI / 效果器 -->
            <Grid Grid.Row="2" Margin="12,0,12,0">
              <!-- 音源（歌手） -->
              <Grid x:Name="SingersPanel" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                  <TextBlock Classes="sideHeading" Text="{DynamicResource sidebar.singers}"/>
                  <Button Grid.Column="1" Classes="iconBtn" Width="24" Height="24" Click="OnRefreshSingers"
                          ToolTip.Tip="{DynamicResource sidebar.refresh}">
                    <Path Data="{StaticResource icon-refresh-cw}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource md3.on-surface-variant}"/>
                  </Button>
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Singers}" Background="Transparent"
                         BorderThickness="0" IsVisible="{Binding HasSingers}">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="MinHeight" Value="64"/>
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SingerItem">
                      <Border Classes="sideItem singer" DoubleTapped="OnSingerDoubleTap"
                              PointerPressed="OnSidebarPointerPressed" PointerMoved="OnSidebarPointerMoved">
                        <Grid RowDefinitions="*,Auto" Background="Transparent">
                          <Grid Grid.Row="0" ColumnDefinitions="34,8,*" Background="Transparent">
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                    ClipToBounds="True" Background="{DynamicResource md3.surface-container-high}"
                                    VerticalAlignment="Center">
                              <Panel>
                                <Image Source="{Binding Avatar}" Width="34" Height="34" Stretch="UniformToFill"/>
                                <TextBlock Text="{Binding AvatarFallback}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource md3.on-surface-variant}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding ShowAvatarFallback}"/>
                              </Panel>
                            </Border>
                            <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource md3.on-surface}"
                                       Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                          </Grid>
                          <TextBlock Grid.Row="1" FontSize="10" Margin="42,0,0,0"
                                     Foreground="{DynamicResource md3.on-surface-variant}"
                                     Text="{Binding SingerTypeText}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" IsVisible="{Binding !HasSingers}">
                  <Border Classes="sideCard">
                    <StackPanel>
                      <Path Data="{StaticResource icon-mic}" Width="14" Height="14" Stretch="Uniform"
                            Fill="{DynamicResource md3.on-surface-variant}"
                            HorizontalAlignment="Left" Margin="0,0,0,6"/>
                      <TextBlock FontSize="11" TextWrapping="Wrap"
                                 Foreground="{DynamicResource md3.on-surface-variant}"
                                 Text="{DynamicResource sidebar.singers.empty}"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>

              <!-- 音频（伴奏库） -->
              <Grid x:Name="SamplesPanel" IsVisible="False" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                  <TextBlock Classes="sideHeading" Text="{DynamicResource sidebar.samples}"/>
                  <Button Grid.Column="1" Classes="iconBtn" Width="24" Height="24" Click="OnRefreshSamples"
                          ToolTip.Tip="{DynamicResource sidebar.refresh}">
                    <Path Data="{StaticResource icon-refresh-cw}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource md3.on-surface-variant}"/>
                  </Button>
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Samples}" Background="Transparent"
                         BorderThickness="0" IsVisible="{Binding HasSamples}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SampleItem">
                      <Border Classes="sideItem small" DoubleTapped="OnSampleDoubleTap"
                              PointerPressed="OnSidebarPointerPressed" PointerMoved="OnSidebarPointerMoved">
                        <Grid ColumnDefinitions="26,8,*,Auto,4,Auto" Background="Transparent">
                          <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                                  Background="{DynamicResource md3.surface-container-high}" HorizontalAlignment="Left">
                            <Path Data="{StaticResource icon-music}" Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource md3.on-surface-variant}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                     Foreground="{DynamicResource md3.on-surface}"
                                     Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                          <Border Grid.Column="3" Background="{DynamicResource md3.secondary-container}"
                                  CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                            <TextBlock FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource md3.on-secondary-container}"
                                       Text="{Binding Format}"/>
                          </Border>
                          <Button Grid.Column="5" Classes="iconBtn" Width="26" Height="26" Margin="4,0,0,0"
                                  Click="OnSamplePlay" ToolTip.Tip="{DynamicResource sidebar.play}">
                            <Panel>
                              <Path Data="{StaticResource icon-play}" Width="11" Height="11" Stretch="Uniform"
                                    Fill="{DynamicResource md3.on-surface}"
                                    IsVisible="{Binding !IsPreviewing}"/>
                              <Path Data="{StaticResource icon-stop}" Width="11" Height="11" Stretch="Uniform"
                                    Fill="{DynamicResource md3.primary}"
                                    IsVisible="{Binding IsPreviewing}"/>
                            </Panel>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" IsVisible="{Binding !HasSamples}">
                  <Border Classes="sideCard">
                    <StackPanel>
                      <Path Data="{StaticResource icon-music}" Width="14" Height="14" Stretch="Uniform"
                            Fill="{DynamicResource md3.on-surface-variant}"
                            HorizontalAlignment="Left" Margin="0,0,0,6"/>
                      <TextBlock FontSize="11" TextWrapping="Wrap"
                                 Foreground="{DynamicResource md3.on-surface-variant}"
                                 Text="{DynamicResource sidebar.samples.empty}"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>

              <!-- MIDI（占位：本页尚未实现） -->
              <StackPanel x:Name="MidiPanel" IsVisible="False" Spacing="8">
                <Border Classes="sideCard">
                  <StackPanel>
                    <Path Data="{StaticResource icon-music}" Width="14" Height="14" Stretch="Uniform"
                          Fill="{DynamicResource md3.on-surface-variant}"
                          HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource md3.on-surface-variant}"
                               Text="{DynamicResource sidebar.library.empty}"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- 效果器（W4 / 决策 B6：插件浏览器 = 扫描结果 + 搜索 + 拖入效果链面板
                   + 插件扫描路径管理（与「偏好设置 → VST」共用同一份 Preferences 字段，即时同步）） -->
              <Grid x:Name="VstPanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*"
                    DataContext="{Binding PluginBrowser}">
                <!-- 搜索框 36 胶囊 + 重新扫描 -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,2,0,6">
                  <Panel Grid.Column="0" Height="36">
                    <TextBox x:Name="PluginSearchBox" Height="36" CornerRadius="999" Padding="30,0,10,0"
                             FontSize="11" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             Watermark="{DynamicResource sidebar.effects.search}"/>
                    <Path Data="{StaticResource icon-search}" Width="13" Height="13" Stretch="Uniform"
                          Fill="{DynamicResource md3.on-surface-variant}" IsHitTestVisible="False"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0"/>
                  </Panel>
                  <Button Grid.Column="1" Classes="iconBtn" Width="36" Height="36" Margin="6,0,0,0"
                          Click="OnRescanVstFromLibrary" ToolTip.Tip="{DynamicResource prefs.vst.rescan}">
                    <Path Data="{StaticResource icon-refresh-cw}" Width="13" Height="13" Stretch="Uniform"
                          Fill="{DynamicResource md3.on-surface-variant}"/>
                  </Button>
                </Grid>

                <!-- 计数 / 扫描中 + 路径管理开关 -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                              IsVisible="{Binding ShowCount}">
                    <TextBlock Classes="sideHeading" Text="{Binding PluginCount}"/>
                    <TextBlock Classes="sideHeading" Text="{DynamicResource sidebar.effects.countlabel}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="0" Classes="sideHeading" IsVisible="{Binding IsScanning}"
                             Text="{DynamicResource sidebar.effects.scanning}"/>
                  <Button Grid.Column="1" Classes="iconBtn" Width="24" Height="24"
                          Click="OnToggleVstPathManager"
                          ToolTip.Tip="{DynamicResource sidebar.effects.paths.manage}">
                    <Path Data="{StaticResource icon-folder}" Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource md3.on-surface-variant}"/>
                  </Button>
                </Grid>

                <!-- 插件扫描路径（折叠面板；与偏好设置同一份数据） -->
                <Border Grid.Row="2" x:Name="VstPathManager" Classes="sideCard" IsVisible="False"
                        Margin="0,0,0,6">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="sideHeading" Margin="0"
                               Text="{DynamicResource sidebar.effects.paths}"/>
                    <ListBox x:Name="VstPathsList" Height="72" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding ScanPaths}"/>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBox Grid.Column="0" x:Name="LibraryNewVstPath" Height="28" FontSize="11"
                               VerticalContentAlignment="Center"
                               Text="{Binding NewPath, Mode=TwoWay}"
                               Watermark="{DynamicResource sidebar.effects.paths.watermark}"/>
                      <Button Grid.Column="1" Height="28" Padding="10,0" FontSize="11" Margin="6,0,0,0"
                              Content="{DynamicResource prefs.vst.add}"
                              Click="OnAddVstPathFromLibrary"/>
                      <Button Grid.Column="2" Height="28" Padding="10,0" FontSize="11" Margin="6,0,0,0"
                              Content="{DynamicResource prefs.vst.remove}"
                              Click="OnRemoveVstPathFromLibrary"/>
                    </Grid>
                    <TextBlock FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource md3.on-surface-variant}"
                               Text="{DynamicResource sidebar.effects.paths.hint}"/>
                  </StackPanel>
                </Border>

                <!-- 插件列表 + 空态 / 未找到 -->
                <Grid Grid.Row="3">
                  <ListBox x:Name="VstPluginList" ItemsSource="{Binding Plugins}" Background="Transparent"
                           BorderThickness="0" IsVisible="{Binding HasPlugins}">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="46"/>
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:VstPluginItem">
                        <!-- 拖拽源：PointerPressed/Moved → FxChainDragData（格式 OpenUtau.FxChainItem） -->
                        <Border Classes="sideItem" Height="46" ToolTip.Tip="{Binding Path}"
                                PointerPressed="OnPluginPointerPressed"
                                PointerMoved="OnPluginPointerMoved">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                         Foreground="{DynamicResource md3.on-surface}"/>
                              <TextBlock Text="{Binding Vendor}" FontSize="10" Margin="0,1,0,0"
                                         TextTrimming="CharacterEllipsis"
                                         IsVisible="{Binding HasVendor}"
                                         Foreground="{DynamicResource md3.on-surface-variant}"/>
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="6" Padding="6,2" Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource md3.surface-container-high}">
                              <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="SemiBold"
                                         Foreground="{DynamicResource md3.on-surface-variant}"/>
                            </Border>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <!-- 空态：一个效果器也没扫到 -->
                  <StackPanel IsVisible="{Binding ShowNoPlugins}">
                    <Border Classes="sideCard">
                      <StackPanel>
                        <Path Data="{StaticResource icon-sliders}" Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource md3.on-surface-variant}"
                              HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource md3.on-surface-variant}"
                                   Text="{DynamicResource sidebar.effects.empty}"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- 未找到：有插件但没匹配上搜索词 -->
                  <StackPanel IsVisible="{Binding ShowNoMatch}">
                    <Border Classes="sideCard">
                      <StackPanel>
                        <Path Data="{StaticResource icon-search}" Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource md3.on-surface-variant}"
                              HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource md3.on-surface-variant}"
                                   Text="{DynamicResource sidebar.effects.nomatch}"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </Grid>
            </Grid>
          </Grid>
        </Border>

        <!-- ── 视图 2/3：钢琴卷帘（铺满工作区行；进入仍是双击片段 A5，返回走顶栏胶囊「工作台」）──
             宿主 Border 只负责「不透明底 + 可见性」；内层 ContentControl 走一次淡入（不参与布局）。 -->
        <Border Grid.Column="0" Grid.ColumnSpan="3" ZIndex="10"
                Background="{DynamicResource md3.surface}"
                IsVisible="{Binding ViewSwitcher.ShowPianoRoll}">
          <ContentControl x:Name="PianoRollContainer" Classes="md3-fade"/>
        </Border>
        <!-- ── 视图 3/3：混音台（不再停靠在编排区下方；Ctrl+M / 胶囊进入）──
             overlay 只铺前两列：第 3 列留给素材库列，让「素材库 → 效果器 → 拖入链面板」可达（B3/B6）。 -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" ZIndex="10"
                Background="{DynamicResource md3.surface}"
                IsVisible="{Binding ViewSwitcher.ShowMixer}">
          <ContentControl x:Name="MixerContainer" Classes="md3-fade"/>
        </Border>
      </Grid>

      <!-- ══════════ 状态条 32：左侧引擎/进度 · 右侧版本 ══════════ -->
      <Border Grid.Row="2" Background="{DynamicResource md3.surface-container}"
              BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Width="7" Height="7" CornerRadius="999" VerticalAlignment="Center"
                    Background="{DynamicResource md3.primary}"/>
            <TextBlock VerticalAlignment="Center" FontSize="10"
                       Foreground="{DynamicResource md3.on-surface-variant}"
                       Text="{Binding ProgressText}"/>
          </StackPanel>
          <ProgressBar Grid.Column="1" Height="4" VerticalAlignment="Center" Margin="16,0"
                       Minimum="0" Maximum="100" Value="{Binding Progress}"
                       Background="Transparent"/>
          <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10"
                     Foreground="{DynamicResource md3.on-surface-variant}"
                     Text="{Binding AppVersion}"/>
        </Grid>
      </Border>
    </Grid>

    <!-- ══════════ 欢迎视图（初始视图，内嵌于主窗口）══════════
         打开 / 新建工程后隐藏；模态覆盖层（ZIndex 1000）仍位于其之上 -->
    <!-- 欢迎视图：内嵌工作区行（与偏好视图同一层，靠 ZIndex 分先后） -->
    <views:WelcomeView x:Name="WelcomeHost" Classes="md3-fade" IsVisible="False" ZIndex="900"/>

    <!-- 偏好设置：窗口级最上层（欢迎页之上；模态对话框层 1000 仍压在其上）。自带 56px 顶栏，故覆盖共享顶栏也没问题 -->
    <views:PreferencesView x:Name="PreferencesHost" Classes="md3-fade" IsVisible="False" ZIndex="990"/>

    <!-- 偏好设置（全屏视图；模态覆盖层仍在其上） -->


    <!-- Overlay layer: in-window modal dialog host -->
    <Grid Name="OverlayLayer" IsVisible="False" ZIndex="1000" Background="Transparent">
      <Border Name="OverlayBackdrop" Classes="md3-fade" Background="#A0000000" PointerPressed="OnOverlayBackdropPressed"/>
      <Border Name="OverlayCard" Classes="md3-pop"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              MinWidth="340"
              ClipToBounds="True"
              Background="{DynamicResource PlusBrushDialogCard}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="0" CornerRadius="14"
              BoxShadow="0 8 32 0 #3F000000">
        <Grid RowDefinitions="Auto,*">
          <!-- Optional dialog header (e.g. Preferences) -->
          <Border Name="OverlayHeader" Grid.Row="0" IsVisible="False"
                  Padding="16,10" CornerRadius="11.5,11.5,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Name="OverlayHeaderTitle" Grid.Column="0"
                         VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
              <Button Name="OverlayHeaderClose" Grid.Column="1" Content="✕"
                      Click="OnOverlayCloseClicked"
                      Margin="8,0,0,0" Padding="6,0" MinWidth="24" MinHeight="24"
                      FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ContentControl Grid.Row="1" Name="OverlayContent"/>
          <!-- Floating close for non-header overlays (Updater) -->
          <Button Name="OverlayCloseButton" Content="✕"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,10,12,0" Padding="6,0" MinWidth="24" MinHeight="24"
                  FontSize="12" Opacity="0.7"
                  Click="OnOverlayCloseClicked"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  </Border>
</controls:WindowEx>
