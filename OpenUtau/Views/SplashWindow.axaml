<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="400" Height="180"
        x:Class="OpenUtau.App.Views.SplashWindow"
        Title="UTvTU"
        Icon="/Assets/open-utau.ico"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
  <!-- ══ W40：启动徽标 = 品牌锁定 `{ 脸 UTvTU }` ══
       · 底色/描边按 UI 标准走 md3.* 令牌（原为 Suki 时代键 SystemRegionBrush / PlusBrushBorderDefault）
       · 标志与括号用**矢量**（`brand-mark` / `brand-brace`，见 Assets/Icons.axaml；64 网格、描边 = 尺寸÷8），
         96px 级尺寸下比位图锐；字标暂用文字（Roboto 字标轮廓由 W39 重出后替换为几何）
       · **几何当前是占位**：W39 正在按源几何重出（括号尖部、笔画与墨迹高），就绪后只替换 Icons.axaml 里两条 Data
       · 视觉尺寸按 W39 实测阶梯：启动窗用完整锁定、cap=28（括号墨迹 ≈1.2×cap，标志墨迹高 = cap）
       · 颜色：应用内变体 —— 括号 md3.primary（跟随色池）、字标 md3.on-surface；
         品牌物料（图标/闪屏/安装包）用固定 brand.primary 的切换待 W39 的 brand.* 令牌落地后一行改动 -->
  <Border CornerRadius="12" Background="{DynamicResource md3.surface-container}"
          BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="1">
    <Grid RowDefinitions="*,Auto">
      <!-- 锁定行：{ 脸 UTvTU }（Viewbox 里按 64 单位网格摆放，缩放到目标墨迹高） -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <Viewbox Width="49" Height="49" Stretch="Uniform">
          <Path Name="BraceLeft" Data="{StaticResource brand-brace}"
                Stroke="{DynamicResource md3.primary}" StrokeThickness="7.3"
                StrokeLineCap="Round" StrokeJoin="Round" Width="64" Height="64"/>
        </Viewbox>
        <Viewbox Width="43" Height="43" Stretch="Uniform">
          <Path Name="BrandMark" Data="{StaticResource brand-mark}"
                Stroke="{DynamicResource md3.primary}" StrokeThickness="8"
                StrokeLineCap="Round" StrokeJoin="Round" Width="64" Height="64"/>
        </Viewbox>
        <TextBlock Name="Wordmark" Text="UTvTU" FontSize="39" FontWeight="Bold"
                   Foreground="{DynamicResource md3.on-surface}"
                   VerticalAlignment="Center" Margin="4,0,4,2"/>
        <Viewbox Width="49" Height="49" Stretch="Uniform">
          <Path Name="BraceRight" Data="{StaticResource brand-brace}"
                Stroke="{DynamicResource md3.primary}" StrokeThickness="7.3"
                StrokeLineCap="Round" StrokeJoin="Round" Width="64" Height="64"
                RenderTransform="scale(-1,1)" RenderTransformOrigin="50%,50%"/>
        </Viewbox>
      </StackPanel>
      <ProgressBar Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                   IsIndeterminate="True"/>
    </Grid>
  </Border>
</Window>
