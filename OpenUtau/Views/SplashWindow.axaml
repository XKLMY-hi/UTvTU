<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="400" Height="180"
        x:Class="OpenUtau.App.Views.SplashWindow"
        Title="UTvTU"
        Icon="/Assets/brand/utvtu.ico"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
  <!-- ══ W40：启动窗 = 签名锁定 { 脸 UTvTU }（cap 28，舒适档） ══
       · 底色/描边改 md3.* 令牌（原为 Suki 时代键 SystemRegionBrush / PlusBrushBorderDefault）
       · 三件全用**冻结版源几何、描边渲染**（见 Assets/Icons.axaml）：
         括号 brand-brace / brand-brace-flipx（程序化镜像，不手绘）、标志 brand-mark（描边 = 尺寸÷8）、
         字标 brand-wordmark-interim-monoline（描边 = cap×0.125）
       · 尺寸按 W39f 对齐规则：括号墨迹高 = 1.2×cap、标志墨迹高 = cap、部件间距 = 0.42×cap
         （此处 cap = 28 ⇒ 括号墨迹高 33.6、标志墨迹高 28、间距 11.8；括号按实测下沉 2.3px 对齐 cap 带）
       · 取色：应用内 —— 括号 md3.primary（跟随色池）、标志与字标 md3.on-surface
       · ⚠ 字标暂用单线替代：冻结版 brand-wordmark 的切角 v 坐标错位（已报 fx-rack 重出），
         重出后把下面 Wordmark 的 Data 换成 brand-wordmark（Fill）即可，布局不用动 -->
  <Border CornerRadius="12" Background="{DynamicResource md3.surface-container}"
          BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="1">
    <Grid RowDefinitions="*,Auto">
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <!-- { 括号：路径 28×48、墨迹高 36 ⇒ 描边=6；缩放到墨迹高 1.2×28 = 33.6 -->
        <Viewbox Width="23.5" Height="40.3" Stretch="Uniform" Margin="0,2.3,0,0">
          <Path Name="BraceLeft" Data="{StaticResource brand-brace}"
                Stroke="{DynamicResource md3.primary}" StrokeThickness="6"
                StrokeLineCap="Round" StrokeJoin="Round" Width="28" Height="48"/>
        </Viewbox>
        <!-- 脸：64 网格、描边=8；缩放到墨迹高 = cap = 28；间距 0.42×cap = 11.8 -->
        <Viewbox Width="41.7" Height="41.7" Stretch="Uniform" Margin="11.8,0,11.8,0">
          <Path Name="BrandMark" Data="{StaticResource brand-mark}"
                Stroke="{DynamicResource md3.on-surface}" StrokeThickness="8"
                StrokeLineCap="Round" StrokeJoin="Round" Width="64" Height="64"/>
        </Viewbox>
        <!-- 字标：单线替代（大写高 93.8、宽 401.8）；缩放到 cap=28 -->
        <Viewbox Width="126" Height="30" Stretch="Uniform" Margin="0,0,11.8,0">
          <Path Name="Wordmark" Data="{StaticResource brand-wordmark-interim-monoline}"
                Stroke="{DynamicResource md3.on-surface}" StrokeThickness="11.725"
                StrokeLineCap="Round" StrokeJoin="Round" Width="401.8" Height="93.8"/>
        </Viewbox>
        <!-- } ：冻结版程序化镜像几何（brand-brace-flipx），不要 RenderTransform、不要手绘 -->
        <Viewbox Width="23.5" Height="40.3" Stretch="Uniform" Margin="0,2.3,0,0">
          <Path Name="BraceRight" Data="{StaticResource brand-brace-flipx}"
                Stroke="{DynamicResource md3.primary}" StrokeThickness="6"
                StrokeLineCap="Round" StrokeJoin="Round" Width="28" Height="48"/>
        </Viewbox>
      </StackPanel>
      <ProgressBar Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                   IsIndeterminate="True"/>
    </Grid>
  </Border>
</Window>
