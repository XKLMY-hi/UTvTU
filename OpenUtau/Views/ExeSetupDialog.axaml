<controls:WorkspaceToolView xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:OpenUtau.App.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="OpenUtau.App.Views.ExeSetupDialog"
        Title="{DynamicResource exesetup.title}" Focusable="True">
<DockPanel LastChildFill="True">
      <Border>
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="50"/>
    </Grid.RowDefinitions>
    <TextBlock Margin="20" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Name="Text" TextWrapping="Wrap" MaxWidth="560" Text="{Binding message}"/>
    <TextBox Margin="30,0,30,20" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{OnPlatform False, macOS=True}" TextWrapping="Wrap" Height="36"
             Text="% brew tap gcenx/wine&#x0a;% brew install --cask --no-quarantine wine-crossover" />
    <StackPanel Grid.Row="2" Classes="dialogActions" Margin="20,0" Name="Buttons">
      <Button Classes="tonal dialogAction" Click="InstallAsResampler" Content="{DynamicResource exesetup.resampler}"/>
      <Button Classes="tonal dialogAction" Click="InstallAsWavtool" Content="{DynamicResource exesetup.wavtool}"/>
    </StackPanel>
  </Grid>
      </Border>
    </DockPanel>
</controls:WorkspaceToolView>
