<controls:WorkspaceToolView xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:OpenUtau.App.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="OpenUtau.App.Views.TrackColorDialog"
        Title="{DynamicResource tracks.trackcolor}"
        KeyDown="OnKeyDown" Focusable="True">
<DockPanel LastChildFill="True">
      <Border>
  <Grid RowDefinitions="*,50" >
    <ListBox ItemsSource="{Binding TrackColors}" SelectedValue="{Binding SelectedColor}"
             Grid.Row="0" VerticalAlignment="Center" Background="Transparent" Height="50" Margin="20,0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="{Binding AccentColor}" CornerRadius="2" Width="25"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="2" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="ToolTip.Tip" Value="{Binding Name}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
          <Setter Property="Background" Value="{Binding AccentColorLightSemi}"/>
        </Style>
      </ListBox.Styles>
    </ListBox>
    <StackPanel Grid.Row="1" Classes="dialogActions" Margin="16,0">
      <Button Classes="text dialogAction" Content="{DynamicResource button.cancel}" Click="OnCancel"/>
      <Button Classes="primary dialogAction" Content="{DynamicResource button.apply}" Click="OnFinish"/>
    </StackPanel>
  </Grid>
      </Border>
    </DockPanel>
</controls:WorkspaceToolView>
