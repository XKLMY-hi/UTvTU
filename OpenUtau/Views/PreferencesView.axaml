<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenUtau.App.ViewModels"
             xmlns:c="clr-namespace:OpenUtau.App.Controls"
             xmlns:core="using:OpenUtau.Core"
             xmlns:motion="using:OpenUtau.Theming"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
             x:Class="OpenUtau.App.Views.PreferencesView" Classes="professionalPage">
  <!-- Workspace configuration: 232 DIP navigation, shared 40 DIP fields and typography.
       Groups use adaptive columns; narrow windows retain the same control instances
       in reading order. Shared workspace chrome is supplied by MainWindow. -->
  <UserControl.Resources>
    <vm:CultureNameConverter x:Key="cultureNameConverter"/>
    <!-- Settings have external labels. Keep the established switch part names and
         state styles, while omitting the extra content rows of the general template. -->
    <ControlTheme x:Key="PreferencesSwitchTheme" TargetType="ToggleSwitch" BasedOn="{StaticResource Md3ToggleSwitchTheme}">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="PART_Root" Width="52" Height="32">
            <Border Name="OuterBorder" Width="52" Height="32" BorderThickness="2" CornerRadius="{DynamicResource Md3ShapeFull}"/>
            <Border Name="SwitchKnobBounds" Width="52" Height="32" CornerRadius="{DynamicResource Md3ShapeFull}"/>
            <Canvas Name="PART_SwitchKnob" Width="20" Height="32" HorizontalAlignment="Left">
              <Grid Name="PART_MovingKnobs" Width="32" Height="32">
                <Ellipse Name="SwitchKnobOn" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Name="SwitchKnobOff" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Canvas>
            <Border Name="PART_FocusRing" Margin="-3" BorderThickness="2" CornerRadius="{DynamicResource Md3ShapeFull}" IsHitTestVisible="False"/>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <!-- A full-width horizontal track for settings. Value/keyboard/drag behavior stays
         on the native Slider; the general theme's automatic column is not reused. -->
    <ControlTheme x:Key="PreferencesSliderTheme" TargetType="Slider" BasedOn="{StaticResource Md3SliderTheme}">
      <Setter Property="Template">
        <ControlTemplate>
          <DataValidationErrors>
            <Grid Name="SliderContainer" MinHeight="40">
              <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                     Orientation="Horizontal" Height="32" VerticalAlignment="Center">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_DecreaseButton" Focusable="False" MinHeight="0" MinWidth="0" Margin="0" Padding="0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="{TemplateBinding Foreground}">
                    <RepeatButton.Template>
                      <ControlTemplate><Border Height="6" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="3"/></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_IncreaseButton" Focusable="False" MinHeight="0" MinWidth="0" Margin="0" Padding="0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="{TemplateBinding Background}">
                    <RepeatButton.Template>
                      <ControlTemplate><Border Height="6" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="3"/></ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseButton>
                <Thumb Name="thumb" Width="16" Height="32" MinWidth="0" MinHeight="0" Margin="0" Padding="0"
                       Background="{TemplateBinding Foreground}" BorderThickness="0">
                  <Thumb.Template>
                    <ControlTemplate><Border Width="4" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="2"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track>
              <Border Name="PART_FocusRing" BorderThickness="2" CornerRadius="{DynamicResource Md3ShapeSmall}" IsHitTestVisible="False"/>
            </Grid>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <!-- Fluent 开关的配色改走颜色池（MD3：开 = primary 轨道 + on-primary 圆钮） -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource md3.color.primary}"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource md3.color.primary}"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{DynamicResource md3.color.surface-container-highest}"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{DynamicResource md3.color.outline}"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{DynamicResource md3.color.on-primary}"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{DynamicResource md3.color.outline}"/>
    <!-- Fluent 滑条的配色改走颜色池（MD3：已选 primary，未选 surface-container-highest） -->
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource md3.color.primary}"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource md3.color.primary}"/>
    <SolidColorBrush x:Key="SliderTrackFill" Color="{DynamicResource md3.color.surface-container-highest}"/>
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{DynamicResource md3.color.surface-container-highest}"/>
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource md3.color.primary}"/>
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource md3.color.primary}"/>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- 左导航项样式（基础态/悬停/选中/图标色/焦点环）已全部提取到应用级 Styles/Md3Controls.axaml 的
         `Button.navItem` 一族（欢迎页共用同一套词汇）——本页不再本地定义，避免两处漂移。 -->

    <!-- ══ 卡片与字段 ══ -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline-variant}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeExtraLarge}"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeTitleMedium}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.cardSub">
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodyMedium}"/>
      <Setter Property="LineHeight" Value="18"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodyMedium}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Grid.settingRow">
      <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="Grid.settingRow TextBlock.fieldLabel">
      <Setter Property="Margin" Value="0,0,16,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Grid.settingRow ToggleSwitch">
      <Setter Property="Theme" Value="{StaticResource PreferencesSwitchTheme}"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.helpText">
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodySmall}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.valueText">
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodyMedium}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.primary}"/>
    </Style>

    <Style Selector="Border.segmented">
      <Setter Property="Height" Value="{DynamicResource Md3WorkspaceControlHeight}"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeFull}"/>
      <Setter Property="Padding" Value="3"/>
    </Style>
    <Style Selector="RadioButton.chip">
      <Setter Property="Theme" Value="{StaticResource WorkspaceSegmentTheme}"/>
      <Setter Property="ToolTip.Tip" Value="{Binding $self.Content}"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodySmall}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ══ 文件夹行 / 描边胶囊按钮 ══ -->
    <Style Selector="Border.folderRow">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeMedium}"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector="Border.folderIcon">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeSmall}"/>
      <Setter Property="Background" Value="{DynamicResource md3.tertiary-container}"/>
    </Style>
    <Style Selector="Button.outlinePill">
      <Setter Property="Theme" Value="{StaticResource DawTextButtonTheme}"/>
      <Setter Property="Height" Value="{DynamicResource Md3WorkspaceControlHeight}"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeFull}"/>
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodyMedium}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.primary}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.filledPill">
      <Setter Property="Theme" Value="{StaticResource DawTextButtonTheme}"/>
      <Setter Property="Height" Value="{DynamicResource Md3WorkspaceControlHeight}"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource md3.primary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeFull}"/>
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodyMedium}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-primary}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ══ 色板 ══ -->
    <Style Selector="Button.swatch">
      <Setter Property="Theme" Value="{StaticResource DawButtonTheme}"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeFull}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ══ 选择行（设备）与滑条：把 Fluent 控件收敛成稿子的样子 ══ -->
    <Style Selector="ComboBox.selectField">
      <Setter Property="Height" Value="{DynamicResource Md3WorkspaceControlHeight}"/>
      <Setter Property="MinHeight" Value="{DynamicResource Md3WorkspaceControlHeight}"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodyMedium}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeSmall}"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline-variant}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Slider.rowSlider">
      <Setter Property="Theme" Value="{StaticResource PreferencesSliderTheme}"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Height" Value="40"/>
    </Style>
    <!-- 文本框 / 列表：与选择行同款（高 36 / 圆角 8 / surface-container-high） -->
    <Style Selector="TextBox.field">
      <Setter Property="Height" Value="{DynamicResource Md3WorkspaceControlHeight}"/>
      <Setter Property="MinHeight" Value="{DynamicResource Md3WorkspaceControlHeight}"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodyMedium}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeSmall}"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline-variant}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ListBox.field">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodySmall}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeSmall}"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline-variant}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ListBox.field ListBoxItem">
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3DawCornerRadius}"/>
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="OnContent" Value=""/>
      <Setter Property="OffContent" Value=""/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*" Background="{DynamicResource md3.surface}">
    <Grid ColumnDefinitions="232,*">
    <!-- ══════════ 左导航 232 ══════════ -->
    <Border Grid.Column="0" Background="{DynamicResource md3.surface-container-low}"
            BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="*,Auto" Margin="12,20,12,16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{DynamicResource Md3Spacing4}">
          <!-- 分类导航 -->
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing2}" Margin="12,0">
            <c:DawIcon Data="{StaticResource icon-settings}" Width="16" Height="16"
                  VerticalAlignment="Center" Fill="{DynamicResource md3.on-surface-variant}"/>
            <TextBlock Text="{DynamicResource prefs.caption}" FontSize="{DynamicResource Md3TypeBodySmall}" FontWeight="Medium"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource md3.on-surface-variant}"/>
          </StackPanel>
          <!-- 导航项 -->
          <StackPanel Spacing="{DynamicResource Md3Spacing1}">
            <Button x:Name="NavAudio" Classes="navItem selected" Click="OnNavClicked" Tag="audio">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}">
                <c:DawIcon Data="{StaticResource icon-volume-x}" Width="16" Height="16" VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource prefs.nav.audio}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavLibrary" Classes="navItem" Click="OnNavClicked" Tag="library">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}">
                <c:DawIcon Data="{StaticResource icon-book-open}" Width="16" Height="16" VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource prefs.nav.library}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavPlayback" Classes="navItem" Click="OnNavClicked" Tag="playback">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}">
                <c:DawIcon Data="{StaticResource icon-play}" Width="16" Height="16" VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource prefs.playback}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavAppearance" Classes="navItem" Click="OnNavClicked" Tag="appearance">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}">
                <c:DawIcon Data="{StaticResource icon-palette}" Width="16" Height="16" VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource prefs.appearance}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavEditor" Classes="navItem" Click="OnNavClicked" Tag="editor">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}">
                <c:DawIcon Data="{StaticResource icon-pencil}" Width="16" Height="16" VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource prefs.editing}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavMidi" Classes="navItem" Click="OnNavClicked" Tag="midi">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}">
                <c:DawIcon Data="{StaticResource icon-music}" Width="16" Height="16" VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource prefs.nav.midi}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavGeneral" Classes="navItem" Click="OnNavClicked" Tag="general">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}">
                <c:DawIcon Data="{StaticResource icon-sliders}" Width="16" Height="16" VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource prefs.general}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Border Height="1" Margin="0,8" Background="{DynamicResource md3.outline-variant}"/>
            <Button Name="NavShortcuts" Classes="navItem" Click="OnNavClicked" Tag="shortcuts">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}">
                <c:DawIcon Data="{StaticResource icon-list}" Width="16" Height="16" VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource shortcut.caption}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavAbout" Classes="navItem" Click="OnNavClicked" Tag="about">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}">
                <c:DawIcon Data="{StaticResource icon-info}" Width="16" Height="16" VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource prefs.nav.about}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        </ScrollViewer>

        <!-- 底部：恢复默认 + 版本 -->
        <StackPanel Grid.Row="1" Spacing="{DynamicResource Md3Spacing3}">
          <Border Height="1" Background="{DynamicResource md3.outline-variant}"/>
          <Button x:Name="ResetButton" Classes="navItem" Click="OnResetAll">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}">
              <c:DawIcon Data="{StaticResource icon-refresh-cw}" Width="16" Height="16" VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
              <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource prefs.reset.all}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock Text="{x:Static core:PlusInfo.VersionString}" FontSize="{DynamicResource Md3TypeLabelSmall}" Margin="16,0,0,0"
                     Foreground="{DynamicResource md3.on-surface-variant}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ══════════ 内容区（行 0 滚动内容 / 行 1 吸底操作条） ══════════ -->
    <Grid Grid.Column="1" RowDefinitions="*,Auto">
    <ScrollViewer x:Name="SettingsScroll" Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="SettingsContent" Margin="24" Spacing="20" MaxWidth="1120" HorizontalAlignment="Stretch">
        <!-- Compact category header: native source geometry, with the same motion contract as WelcomeView. -->
        <Border x:Name="SettingsHeader" Background="{DynamicResource md3.surface-container-high}"
                CornerRadius="{DynamicResource Md3ShapeExtraLarge}" Padding="20" ClipToBounds="True">
          <Grid ColumnDefinitions="*,Auto" MinHeight="64">
            <!-- Native source outlines occupy the open area without intercepting input. -->
            <Grid x:Name="SettingsContours" Grid.ColumnSpan="2" Margin="360,-20,-20,-20"
                  Height="104" VerticalAlignment="Center" ClipToBounds="True"
                  IsHitTestVisible="False" Opacity="0.42">
              <Path Data="{x:Static c:MaterialShape.ArchPath}" Stretch="Uniform"
                    Width="240" Height="240" Margin="0,0,340,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Stroke="{DynamicResource md3.primary}" StrokeThickness="1.5"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><RotateTransform Angle="-22"/></Path.RenderTransform>
              </Path>
              <Path Data="{x:Static c:MaterialShape.SquarePath}" Stretch="Uniform"
                    Width="280" Height="280" Margin="0,0,140,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Stroke="{DynamicResource md3.primary}" StrokeThickness="1.5"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><RotateTransform Angle="24"/></Path.RenderTransform>
              </Path>
              <Ellipse Width="240" Height="240" Margin="0,0,-80,0"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Stroke="{DynamicResource md3.primary}" StrokeThickness="1.5"/>
            </Grid>
            <StackPanel Spacing="{DynamicResource Md3Spacing1}" VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock x:Name="PageHeading" Text="{DynamicResource prefs.nav.audio}" FontSize="{DynamicResource Md3TypeDisplaySmall}" FontWeight="SemiBold"
                         TextWrapping="Wrap" Foreground="{DynamicResource md3.on-surface}"/>
              <TextBlock x:Name="PageDescription" Text="{DynamicResource prefs.description.audio}" FontSize="{DynamicResource Md3TypeBodyMedium}" TextWrapping="Wrap"
                         Foreground="{DynamicResource md3.on-surface-variant}"/>
            </StackPanel>
            <Grid Grid.Column="1" Width="80" Height="64" IsHitTestVisible="False">
              <c:MaterialMorph x:Name="SettingsShape" Kind="Arch" Width="64" Height="64" Fill="{DynamicResource md3.primary}"/>
              <c:DawIcon x:Name="SettingsIcon" Data="{StaticResource icon-volume-x}" Width="26" Height="26"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource md3.on-primary}"/>
            </Grid>
          </Grid>
        </Border>

        <!-- ══ 音频页 ══ -->
        <c:AdaptiveColumns x:Name="PageAudio">
          <StackPanel Spacing="{DynamicResource Md3Spacing3}">
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <StackPanel Spacing="{DynamicResource Md3Spacing1}">
                  <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.card.audioout}"/>
                  <TextBlock Classes="cardSub" Text="{DynamicResource prefs.card.audioout.sub}"/>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.playback.device}"/>
                  <ComboBox Classes="selectField" ItemsSource="{Binding AudioOutputDevices}"
                            SelectedItem="{Binding AudioOutputDevice}"
                            IsEnabled="{Binding !UseSystemDefaultDevice}"/>
                </StackPanel>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center"
                             Text="{DynamicResource prefs.playback.systemdefault}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseSystemDefaultDevice}"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Spacing="{DynamicResource Md3Spacing3}">
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <StackPanel Spacing="{DynamicResource Md3Spacing1}">
                  <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.card.backend}"/>
                  <TextBlock Classes="cardSub" Text="{DynamicResource prefs.card.backend.sub}"/>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.playback.backend}"/>
                  <Border Classes="segmented">
                    <UniformGrid Columns="2">
                      <RadioButton Classes="chip" Content="{DynamicResource prefs.playback.backend.auto}"
                                   IsChecked="{Binding PreferPortAudio, Converter={x:Static vm:ValueEqualsConverter.Instance}, ConverterParameter=0}"/>
                      <RadioButton Classes="chip" Content="{DynamicResource prefs.playback.backend.mini}"
                                   IsChecked="{Binding PreferPortAudio, Converter={x:Static vm:ValueEqualsConverter.Instance}, ConverterParameter=1}"/>
                    </UniformGrid>
                  </Border>
                </StackPanel>
                <Button Classes="filledPill" HorizontalAlignment="Left" MinWidth="112"
                        Content="{DynamicResource prefs.playback.test}"
                        Command="{Binding TestAudioOutputDevice}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </c:AdaptiveColumns>

        <!-- ══ 播放页 ══ -->
        <c:AdaptiveColumns x:Name="PagePlayback" IsVisible="False">
          <StackPanel Grid.Column="0" Spacing="{DynamicResource Md3Spacing3}">
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <StackPanel Spacing="{DynamicResource Md3Spacing1}">
                  <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.card.playback}"/>
                  <TextBlock Classes="cardSub" Text="{DynamicResource prefs.card.playback.sub}"/>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{DynamicResource prefs.playback.cursorposition}"/>
                    <TextBlock Grid.Column="1" Classes="valueText">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:#0.0}"><Binding Path="PlayPosMarkerMargin"/></MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </Grid>
                  <Slider Classes="rowSlider" Minimum="0" Maximum="1" TickFrequency="0.1"
                          IsSnapToTickEnabled="True" Value="{Binding PlayPosMarkerMargin}"/>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.playback.autoscroll}"/>
                  <Border Classes="segmented">
                    <UniformGrid Columns="3">
                      <RadioButton Classes="chip" Content="{DynamicResource prefs.playback.autoscrollmode.off}"
                                   IsChecked="{Binding PlaybackAutoScroll, Converter={x:Static vm:ValueEqualsConverter.Instance}, ConverterParameter=0}"/>
                      <RadioButton Classes="chip" Content="{DynamicResource prefs.playback.autoscrollmode.stationarycursor}"
                                   IsChecked="{Binding PlaybackAutoScroll, Converter={x:Static vm:ValueEqualsConverter.Instance}, ConverterParameter=1}"/>
                      <RadioButton Classes="chip" Content="{DynamicResource prefs.playback.autoscrollmode.pagescroll}"
                                   IsChecked="{Binding PlaybackAutoScroll, Converter={x:Static vm:ValueEqualsConverter.Instance}, ConverterParameter=2}"/>
                    </UniformGrid>
                  </Border>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.playback.lockstarttime}"/>
                  <Border Classes="segmented">
                    <UniformGrid Columns="3">
                      <RadioButton Classes="chip" Content="{DynamicResource prefs.option.pause.keep}" ToolTip.Tip="{DynamicResource prefs.playback.lockstarttime.off}"
                                   IsChecked="{Binding LockStartTime, Converter={x:Static vm:ValueEqualsConverter.Instance}, ConverterParameter=0}"/>
                      <RadioButton Classes="chip" Content="{DynamicResource prefs.option.pause.reset}" ToolTip.Tip="{DynamicResource prefs.playback.lockstarttime.on}"
                                   IsChecked="{Binding LockStartTime, Converter={x:Static vm:ValueEqualsConverter.Instance}, ConverterParameter=1}"/>
                      <RadioButton Classes="chip" Content="{DynamicResource prefs.option.pause.cursor}" ToolTip.Tip="{DynamicResource prefs.playback.lockstarttime.onlycursor}"
                                   IsChecked="{Binding LockStartTime, Converter={x:Static vm:ValueEqualsConverter.Instance}, ConverterParameter=2}"/>
                    </UniformGrid>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="{DynamicResource Md3Spacing3}">
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.playback.metronome}"/>
                <StackPanel Spacing="{DynamicResource Md3Spacing1}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.playback.metronome.volume}"/>
                    <TextBlock Grid.Column="1" Classes="valueText">
                      <TextBlock.Text><MultiBinding StringFormat="{}{0:#0}"><Binding Path="MetronomeVolume"/></MultiBinding></TextBlock.Text>
                    </TextBlock>
                  </Grid>
                  <Slider Classes="rowSlider" Minimum="0" Maximum="100" Value="{Binding MetronomeVolume}"/>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing1}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.playback.metronome.highfrequency}"/>
                    <TextBlock Grid.Column="1" Classes="valueText">
                      <TextBlock.Text><MultiBinding StringFormat="{}{0:#0}"><Binding Path="MetronomeHighFrequency"/></MultiBinding></TextBlock.Text>
                    </TextBlock>
                  </Grid>
                  <Slider Classes="rowSlider" Minimum="20" Maximum="5000" Value="{Binding MetronomeHighFrequency}"/>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing1}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.playback.metronome.lowfrequency}"/>
                    <TextBlock Grid.Column="1" Classes="valueText">
                      <TextBlock.Text><MultiBinding StringFormat="{}{0:#0}"><Binding Path="MetronomeLowFrequency"/></MultiBinding></TextBlock.Text>
                    </TextBlock>
                  </Grid>
                  <Slider Classes="rowSlider" Minimum="20" Maximum="3000" Value="{Binding MetronomeLowFrequency}"/>
                </StackPanel>
                <Button Classes="outlinePill" HorizontalAlignment="Stretch"
                        Content="{DynamicResource prefs.playback.test}" Command="{Binding TestMetronome}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </c:AdaptiveColumns>

        <!-- ══ 音源与素材库页 ══ -->
        <c:AdaptiveColumns x:Name="PageLibrary" IsVisible="False">
          <StackPanel Grid.Column="0" Spacing="{DynamicResource Md3Spacing3}">
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <StackPanel Spacing="{DynamicResource Md3Spacing1}">
                  <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.card.voicebank}"/>
                  <TextBlock Classes="cardSub" Text="{DynamicResource prefs.card.voicebank.sub}"/>
                </StackPanel>
                <Border Classes="folderRow">
                  <Grid ColumnDefinitions="Auto,12,*,Auto">
                    <Border Grid.Column="0" Classes="folderIcon">
                      <c:DawIcon Data="{StaticResource icon-folder-open}" Width="20" Height="20"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource md3.on-tertiary-container}"/>
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="{DynamicResource Md3Spacing1}" VerticalAlignment="Center">
                      <TextBlock Classes="fieldLabel" Foreground="{DynamicResource md3.on-surface}" Text="{DynamicResource prefs.paths.singer}"/>
                      <TextBlock FontSize="{DynamicResource Md3TypeLabelSmall}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource md3.on-surface-variant}" Text="{Binding SingerPath}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Classes="outlinePill" VerticalAlignment="Center"
                            Content="{DynamicResource button.open}" Click="OnOpenSingerFolder"/>
                  </Grid>
                </Border>
                <Border Classes="folderRow">
                  <Grid ColumnDefinitions="Auto,12,*,Auto">
                    <Border Grid.Column="0" Classes="folderIcon">
                      <c:DawIcon Data="{StaticResource icon-folder-open}" Width="20" Height="20"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource md3.on-tertiary-container}"/>
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="{DynamicResource Md3Spacing1}" VerticalAlignment="Center">
                      <TextBlock Classes="fieldLabel" Foreground="{DynamicResource md3.on-surface}" Text="{DynamicResource prefs.paths.addlsinger}"/>
                      <TextBlock FontSize="{DynamicResource Md3TypeLabelSmall}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource md3.on-surface-variant}" Text="{Binding AdditionalSingersPath}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Classes="outlinePill" VerticalAlignment="Center"
                            Content="{DynamicResource prefs.change}" Click="OnChangeSingerFolder"/>
                  </Grid>
                </Border>
                <UniformGrid Columns="2">
                  <Button Classes="outlinePill" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                          Content="{DynamicResource button.reset}" Click="OnResetAddlSingersPath"/>
                  <Button Classes="outlinePill" Margin="4,0,0,0" HorizontalAlignment="Stretch"
                          Content="{DynamicResource singers.refresh}" Click="OnReloadSingers"/>
                </UniformGrid>
                <Border Classes="folderRow">
                  <Grid ColumnDefinitions="Auto,12,*,Auto">
                    <Border Grid.Column="0" Classes="folderIcon">
                      <c:DawIcon Data="{StaticResource icon-music}" Width="20" Height="20"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource md3.on-tertiary-container}"/>
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="{DynamicResource Md3Spacing1}" VerticalAlignment="Center">
                      <TextBlock Classes="fieldLabel" Foreground="{DynamicResource md3.on-surface}" Text="{DynamicResource prefs.paths.samples}"/>
                      <TextBlock FontSize="{DynamicResource Md3TypeLabelSmall}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource md3.on-surface-variant}" Text="{Binding SamplesPath}"/>
                    </StackPanel>
                    <Button Grid.Column="3" Classes="outlinePill" VerticalAlignment="Center"
                            Content="{DynamicResource prefs.change}" Click="OnChangeSamplesFolder"/>
                  </Grid>
                </Border>
                <UniformGrid Columns="2">
                  <Button Classes="outlinePill" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                          Content="{DynamicResource button.reset}" Click="OnResetSamplesPath"/>
                  <Button Classes="outlinePill" Margin="4,0,0,0" HorizontalAlignment="Stretch"
                          Content="{DynamicResource button.open}" Click="OnOpenSamplesFolder"/>
                </UniformGrid>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.paths.loaddeepfolders}"/>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center"
                             Text="{DynamicResource prefs.paths.addlsinger.install}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding InstallToAdditionalSingersPath}"/>
                </Grid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center"
                             Text="{DynamicResource prefs.paths.loaddeepfolders}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding LoadDeepFolders}"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="{DynamicResource Md3Spacing3}">
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.card.detected}"/>
                <ItemsControl x:Name="SingerListHost" ItemsSource="{Binding Singers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SingerItem">
                      <Grid ColumnDefinitions="Auto,12,*,Auto" Margin="0,0,0,8">
                        <Border Grid.Column="0" Width="8" Height="8" CornerRadius="{DynamicResource Md3ShapeFull}" VerticalAlignment="Center"
                                Background="{DynamicResource md3.primary}"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock FontSize="{DynamicResource Md3TypeBodyMedium}" Text="{Binding Name}" Foreground="{DynamicResource md3.on-surface}"/>
                          <TextBlock FontSize="{DynamicResource Md3TypeLabelSmall}" Text="{Binding SingerTypeText}" Foreground="{DynamicResource md3.on-surface-variant}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" FontSize="{DynamicResource Md3TypeLabelSmall}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource md3.on-surface-variant}"
                                   Text="{DynamicResource prefs.status.installed}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel DataContext="{Binding #SingerListHost.DataContext}" IsVisible="{Binding !HasSingers}"
                            Spacing="12" Margin="0,12,0,8" HorizontalAlignment="Center" MaxWidth="360">
                  <Grid Width="64" Height="64" HorizontalAlignment="Center">
                    <c:MaterialShape Kind="Sunny" Fill="{DynamicResource md3.secondary-container}"/>
                    <c:DawIcon Data="{StaticResource icon-mic}" Width="24" Height="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource md3.on-secondary-container}"/>
                  </Grid>
                  <TextBlock Classes="cardSub" TextAlignment="Center" Text="{DynamicResource prefs.singers.empty}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </c:AdaptiveColumns>

        <!-- ══ 外观页 ══ -->
        <c:AdaptiveColumns x:Name="PageAppearance" IsVisible="False">
          <StackPanel Grid.Column="0" Spacing="{DynamicResource Md3Spacing3}">
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <StackPanel Spacing="{DynamicResource Md3Spacing1}">
                  <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.card.appearance}"/>
                  <TextBlock Classes="cardSub" Text="{DynamicResource prefs.card.appearance.sub}"/>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.appearance.theme}"/>
                  <!-- Legacy theme authoring is retired; existing themes remain selectable. -->
                  <ComboBox Classes="selectField" ItemsSource="{Binding ThemeItems}" SelectedItem="{Binding ThemeName}"/>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.color.source}"/>
                  <ComboBox Classes="selectField" ItemsSource="{Binding ThemeSourceItems}" SelectedIndex="{Binding ThemeSourceIndex}"/>
                  <TextBlock Classes="helpText" Text="{DynamicResource prefs.color.source.hint}"/>
                  <Grid ColumnDefinitions="*,8,Auto">
                    <TextBox Classes="field" Text="{Binding CustomThemeSeed}" PlaceholderText="{DynamicResource prefs.color.seed.placeholder}" MaxLength="7"/>
                    <Button Grid.Column="2" Classes="tonal" Content="{DynamicResource button.apply}" Command="{Binding ApplyCustomAccentCommand}"/>
                  </Grid>
                  <Button Classes="text" Content="{DynamicResource prefs.color.source.refresh}" Command="{Binding RefreshSystemAccentCommand}"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,12,*">
                  <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                    <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.color.scheme}"/>
                    <ComboBox Classes="selectField" ItemsSource="{Binding ThemeSchemeItems}" SelectedIndex="{Binding ThemeSchemeIndex}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="{DynamicResource Md3Spacing2}">
                    <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.color.contrast}"/>
                    <ComboBox Classes="selectField" ItemsSource="{Binding ThemeContrastItems}" SelectedIndex="{Binding ThemeContrastIndex}"/>
                  </StackPanel>
                </Grid>
                <UniformGrid Columns="3">
                  <Border Background="{DynamicResource md3.primary-container}" CornerRadius="{DynamicResource Md3ShapeMedium}" Padding="12" Margin="0,0,4,0"><TextBlock Text="{DynamicResource prefs.color.role.primary}" Foreground="{DynamicResource md3.on-primary-container}" TextAlignment="Center"/></Border>
                  <Border Background="{DynamicResource md3.secondary-container}" CornerRadius="{DynamicResource Md3ShapeMedium}" Padding="12" Margin="4,0"><TextBlock Text="{DynamicResource prefs.color.role.secondary}" Foreground="{DynamicResource md3.on-secondary-container}" TextAlignment="Center"/></Border>
                  <Border Background="{DynamicResource md3.tertiary-container}" CornerRadius="{DynamicResource Md3ShapeMedium}" Padding="12" Margin="4,0,0,0"><TextBlock Text="{DynamicResource prefs.color.role.tertiary}" Foreground="{DynamicResource md3.on-tertiary-container}" TextAlignment="Center"/></Border>
                </UniformGrid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.motion.reduce}" VerticalAlignment="Center"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding ReduceMotion}"/>
                </Grid>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.field.accent}"/>
                  <ItemsControl ItemsSource="{Binding AccentSwatches}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AccentSwatchViewModel">
                        <Button Classes="swatch"
                                Command="{Binding $parent[ItemsControl].DataContext.SelectAccentCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="{Binding Tooltip}" Background="{Binding Brush}">
                          <c:DawIcon Data="{StaticResource icon-check}" Width="16" Height="16"
                                Fill="{DynamicResource md3.on-primary}" IsVisible="{Binding IsSelected}"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="{DynamicResource Md3Spacing3}">
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.appearance.degree}"/>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.appearance.degree}"/>
                  <Border Classes="segmented">
                    <UniformGrid Columns="3">
                      <RadioButton Classes="chip" Content="{DynamicResource prefs.appearance.degree.off}"
                                   IsChecked="{Binding DegreeStyle, Converter={x:Static vm:ValueEqualsConverter.Instance}, ConverterParameter=0}"/>
                      <RadioButton Classes="chip" Content="{DynamicResource prefs.option.degree.solfege}" ToolTip.Tip="{DynamicResource prefs.appearance.degree.solfege}"
                                   IsChecked="{Binding DegreeStyle, Converter={x:Static vm:ValueEqualsConverter.Instance}, ConverterParameter=1}"/>
                      <RadioButton Classes="chip" Content="{DynamicResource prefs.option.degree.numbered}" ToolTip.Tip="{DynamicResource prefs.appearance.degree.numbered}"
                                   IsChecked="{Binding DegreeStyle, Converter={x:Static vm:ValueEqualsConverter.Instance}, ConverterParameter=2}"/>
                    </UniformGrid>
                  </Border>
                </StackPanel>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.appearance.trackcolor}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseTrackColor}"/>
                </Grid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.appearance.showportrait}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowPortrait}"/>
                </Grid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.appearance.showicon}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowIcon}"/>
                </Grid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.appearance.showghostnotes}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowGhostNotes}"/>
                </Grid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.appearance.notehoverglow}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding NoteHoverGlow}"/>
                </Grid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.appearance.playbacknotehighlight}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowPlaybackNoteHighlight}"/>
                </Grid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.appearance.playbacknotebounce}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowPlaybackNoteBounce}"/>
                </Grid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.appearance.detachpianoroll}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding DetachPianoRoll}"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.card.language}"/>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.appearance.lang}"/>
                  <ComboBox Classes="selectField" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Converter={StaticResource cultureNameConverter}}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.appearance.sortorder}"/>
                  <ComboBox Classes="selectField" ItemsSource="{Binding SortingOrders}" SelectedItem="{Binding SortingOrder}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Converter={StaticResource cultureNameConverter}}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <TextBlock Classes="helpText" Text="{DynamicResource prefs.note.restart}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </c:AdaptiveColumns>

        <!-- ══ 编辑器页 ══ -->
        <c:AdaptiveColumns x:Name="PageEditor" IsVisible="False">
          <StackPanel Grid.Column="0" Spacing="{DynamicResource Md3Spacing3}">
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.editing}"/>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.advanced.lyricshelper}"/>
                  <ComboBox Classes="selectField" ItemsSource="{Binding LyricsHelpers}" SelectedItem="{Binding LyricsHelper}"/>
                </StackPanel>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.advanced.lyricshelper.brackets}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding LyricsHelperBrackets}"/>
                </Grid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.advanced.defaultsnapcurve}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding DefaultSnapCurve}"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.advanced.rememberfiletypes}"/>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text=".mid"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding RememberMid}"/>
                </Grid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text=".ust"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding RememberUst}"/>
                </Grid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text=".vsqx"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding RememberVsqx}"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="{DynamicResource Md3Spacing3}">
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.rendering}"/>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.rendering.prerender}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding PreRender}"/>
                </Grid>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{DynamicResource prefs.rendering.threads.numthreads}"/>
                    <TextBlock Grid.Column="1" Classes="valueText">
                      <TextBlock.Text><MultiBinding StringFormat="{}{0:#0}"><Binding Path="NumRenderThreads"/></MultiBinding></TextBlock.Text>
                    </TextBlock>
                  </Grid>
                  <Slider Classes="rowSlider" Minimum="1" Maximum="{Binding LogicalCoreCount, Mode=OneTime}"
                          TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NumRenderThreads}"/>
                  <TextBlock Classes="helpText" IsVisible="{Binding HighThreads}"
                             Text="{DynamicResource prefs.rendering.threads.cpuwarn}"/>
                </StackPanel>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.rendering.skipmuted}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding SkipRenderingMutedTracks}"/>
                </Grid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.cache.clearonquit}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding ClearCacheOnQuit}"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.rendering.onnxrunner}"/>
                <ComboBox Classes="selectField" ItemsSource="{Binding OnnxRunnerOptions}" SelectedItem="{Binding OnnxRunner}"/>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}" IsVisible="{Binding ShowOnnxGpu}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.rendering.onnxgpu}"/>
                  <ComboBox Classes="selectField" ItemsSource="{Binding OnnxGpuOptions}" SelectedItem="{Binding OnnxGpu}"/>
                  <TextBlock Classes="helpText" Text="{DynamicResource prefs.note.restart}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </c:AdaptiveColumns>

        <!-- ══ 通用页 ══ -->
        <c:AdaptiveColumns x:Name="PageGeneral" IsVisible="False">
          <StackPanel Grid.Column="0" Spacing="{DynamicResource Md3Spacing3}">
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.utau}"/>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.rendering.defaultrenderer}"/>
                  <ComboBox Classes="selectField" ItemsSource="{Binding DefaultRendererOptions}" SelectedItem="{Binding DefaultRenderer}"/>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.otoeditor.select}"/>
                  <Border Classes="segmented">
                    <UniformGrid Columns="3">
                      <RadioButton Classes="chip" Content="OpenUtau"
                                   IsChecked="{Binding OtoEditor, Converter={x:Static vm:ValueEqualsConverter.Instance}, ConverterParameter=0}"/>
                      <RadioButton Classes="chip" Content="vLabeler"
                                   IsChecked="{Binding OtoEditor, Converter={x:Static vm:ValueEqualsConverter.Instance}, ConverterParameter=1}"/>
                      <RadioButton Classes="chip" Content="setParam"
                                   IsChecked="{Binding OtoEditor, Converter={x:Static vm:ValueEqualsConverter.Instance}, ConverterParameter=2}"/>
                    </UniformGrid>
                  </Border>
                </StackPanel>
                <Border Classes="folderRow">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Md3Spacing1}" VerticalAlignment="Center">
                      <TextBlock Classes="fieldLabel" Foreground="{DynamicResource md3.on-surface}" Text="{DynamicResource prefs.advanced.vlabelerpath}"/>
                      <TextBlock FontSize="{DynamicResource Md3TypeLabelSmall}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource md3.on-surface-variant}" Text="{Binding VLabelerPath}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing2}" VerticalAlignment="Center">
                      <Button Classes="outlinePill" Content="{DynamicResource button.reset}" Click="OnResetVLabelerPath"/>
                      <Button Classes="outlinePill" Content="{DynamicResource button.select}" Click="OnSelectVLabelerPath"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="folderRow">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Md3Spacing1}" VerticalAlignment="Center">
                      <TextBlock Classes="fieldLabel" Foreground="{DynamicResource md3.on-surface}" Text="{DynamicResource prefs.otoeditor.setparampath}"/>
                      <TextBlock FontSize="{DynamicResource Md3TypeLabelSmall}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource md3.on-surface-variant}" Text="{Binding SetParamPath}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing2}" VerticalAlignment="Center">
                      <Button Classes="outlinePill" Content="{DynamicResource button.reset}" Click="OnResetSetParamPath"/>
                      <Button Classes="outlinePill" Content="{DynamicResource button.select}" Click="OnSelectSetParamPath"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Classes="folderRow" IsVisible="{OnPlatform Windows=False, Default=True}">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Md3Spacing1}" VerticalAlignment="Center">
                      <TextBlock Classes="fieldLabel" Foreground="{DynamicResource md3.on-surface}" Text="{DynamicResource prefs.advanced.winepath}"/>
                      <TextBlock FontSize="{DynamicResource Md3TypeLabelSmall}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource md3.on-surface-variant}" Text="{Binding WinePath}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing2}" VerticalAlignment="Center">
                      <Button Classes="outlinePill" Content="{DynamicResource button.reset}" Click="OnResetWinePath"/>
                      <Button Classes="outlinePill" Content="{DynamicResource button.select}" Click="OnSelectWinePath"/>
                      <Button Classes="outlinePill" Content="{DynamicResource prefs.paths.detect}" Click="OnDetectWinePath"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.diffsinger}"/>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.rendering.diffsingersteps}"/>
                  <ComboBox Classes="selectField" ItemsSource="{Binding DiffSingerStepsOptions}" SelectedItem="{Binding DiffSingerSteps}"/>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.rendering.diffsingerstepsvariance}"/>
                  <ComboBox Classes="selectField" ItemsSource="{Binding DiffSingerStepsVarianceOptions}" SelectedItem="{Binding DiffSingerStepsVariance}"/>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <TextBlock Classes="fieldLabel" Text="{DynamicResource prefs.rendering.diffsingerstepspitch}"/>
                  <ComboBox Classes="selectField" ItemsSource="{Binding DiffSingerStepsPitchOptions}" SelectedItem="{Binding DiffSingerStepsPitch}"/>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing2}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="fieldLabel" Text="{DynamicResource prefs.rendering.diffsingerdepth}"/>
                    <TextBlock Grid.Column="1" Classes="valueText">
                      <TextBlock.Text><MultiBinding StringFormat="{}{0:#0}%"><Binding Path="DiffSingerDepth"/></MultiBinding></TextBlock.Text>
                    </TextBlock>
                  </Grid>
                  <Slider Classes="rowSlider" Minimum="0" Maximum="100" TickFrequency="1"
                          IsSnapToTickEnabled="True" Value="{Binding DiffSingerDepth}"/>
                </StackPanel>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.cache.diffsingertensorcache}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiffSingerTensorCache}"/>
                </Grid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.rendering.diffsingervariancelocalpitchpatch}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiffSingerVarianceLocalPitchPatch}" IsEnabled="{Binding DiffSingerTensorCache}"/>
                </Grid>
                <Grid Classes="settingRow" ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center" Text="{DynamicResource prefs.appearance.diffsingerlangcodehide}"/>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiffSingerLangCodeHide}"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="{DynamicResource Md3Spacing3}">
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}">
                <StackPanel Spacing="{DynamicResource Md3Spacing1}">
                  <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.vst.title}"/>
                  <TextBlock Classes="cardSub" Text="{DynamicResource prefs.vst.scanpaths}"/>
                </StackPanel>
                <ListBox Classes="field" Name="VstPathsList" Height="88" ItemsSource="{Binding VstScanPaths}"/>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBox Grid.Column="0" Classes="field" Name="NewVstPath" PlaceholderText="C:\Path\To\VST\Plugins"/>
                  <Button Grid.Column="1" Classes="outlinePill" Margin="8,0,0,0" Content="{DynamicResource prefs.vst.add}" Click="OnAddVstPath"/>
                  <Button Grid.Column="2" Classes="outlinePill" Margin="8,0,0,0" Content="{DynamicResource prefs.vst.remove}" Click="OnRemoveVstPath"/>
                </Grid>
                <!-- W11：一键补齐平台标准 VST3 目录（与素材库「效果器」空态同一命令），随后自动重扫 -->
                <Button Classes="outlinePill" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Content="{DynamicResource sidebar.effects.addstandard}"
                        Click="OnAddStandardVstPaths"/>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" VerticalAlignment="Center"
                             Text="{Binding VstPluginCount, StringFormat={}{0} plugin(s) found}"/>
                  <Button Grid.Column="1" Classes="outlinePill" Content="{DynamicResource prefs.vst.rescan}" Click="OnRescanVstPlugins"/>
                </Grid>
                <ListBox Classes="field" Height="120" ItemsSource="{Binding VstKnownPlugins}"/>
                <Border Height="1" Background="{DynamicResource md3.outline-variant}"/>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing2}">
                  <Button Classes="outlinePill" Content="README" Click="OnOpenReadme"/>
                  <Button Classes="outlinePill" Content="GitHub" Click="OnOpenGithub"/>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </c:AdaptiveColumns>

        <!-- ══ MIDI 设备页（应用暂无 MIDI 设备设置） ══ -->
        <!-- ══ 关于页（徽标 + 版本说明 + 仓库链接 + 页尾署名） ══ -->
        <ContentControl Name="PageShortcuts" IsVisible="False" Height="540"/>
        <Grid x:Name="PageAbout" IsVisible="False">
          <StackPanel x:Name="AboutContent" Spacing="{DynamicResource Md3Spacing3}">
            <Border Classes="card">
              <StackPanel x:Name="AboutDetails" Spacing="{DynamicResource Md3Spacing4}">
                <!-- 关于页品牌锁定：与主窗顶栏同一套件，按 cap 24 放大（主窗数值 × 1.6 = 24/15）
                     —— 旧的 96 圆角瓦片 + 音符图标是 W40 前的品牌，已退役。 -->
                <StackPanel x:Name="AboutBrand" Orientation="Horizontal" Spacing="10.08" HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                  <Viewbox Width="33.4" Height="33.4" Stretch="Uniform">
                    <Path Data="{StaticResource brand-mark}"
                          Stroke="{DynamicResource md3.primary}" StrokeThickness="8"
                          StrokeLineCap="Round" StrokeJoin="Round" Width="64" Height="64"/>
                  </Viewbox>
                  <Canvas Width="89.28" Height="24" VerticalAlignment="Center">
                    <Path Data="{StaticResource brand-wordmark}"
                          Fill="{DynamicResource md3.on-surface}"
                          Width="89.28" Height="24" Stretch="Uniform"/>
                    <Path Data="{StaticResource brand-v-chevron}"
                          Stroke="{DynamicResource md3.on-surface}" StrokeThickness="5.28"
                          StrokeLineCap="Round" StrokeJoin="Round"
                          Width="7.87" Height="12.29" Stretch="Uniform"
                          Canvas.Left="40.05" Canvas.Top="8.70"/>
                  </Canvas>
                </StackPanel>
                <StackPanel Spacing="{DynamicResource Md3Spacing1}" HorizontalAlignment="Left">
                  <TextBlock Text="{DynamicResource prefs.about.version}" FontSize="{DynamicResource Md3TypeLabelSmall}" HorizontalAlignment="Left"
                             Foreground="{DynamicResource md3.on-surface-variant}"/>
                  <TextBlock Text="{x:Static core:PlusInfo.VersionString}" FontSize="{DynamicResource Md3TypeBodyMedium}" HorizontalAlignment="Left"
                             Foreground="{DynamicResource md3.on-surface}"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource dialogs.about.message}" FontSize="{DynamicResource Md3TypeBodyMedium}" LineHeight="20"
                           TextWrapping="Wrap" TextAlignment="Left" MaxWidth="720" HorizontalAlignment="Left"
                           Foreground="{DynamicResource md3.on-surface-variant}"/>
                <TextBlock Text="{DynamicResource prefs.about.basedon}" FontSize="{DynamicResource Md3TypeLabelSmall}" HorizontalAlignment="Left"
                           Foreground="{DynamicResource md3.on-surface-variant}"/>
                <StackPanel x:Name="AboutLinks" Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}" HorizontalAlignment="Left">
                  <Button Classes="filledPill" MinWidth="96" Content="GitHub" Click="OnOpenGithub"
                          ToolTip.Tip="{DynamicResource prefs.about.repo}"/>
                  <Button Classes="outlinePill" MinWidth="96" Content="README" Click="OnOpenReadme"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <TextBlock x:Name="AboutCredit" Text="{DynamicResource prefs.about.credit}" FontSize="{DynamicResource Md3TypeLabelSmall}" TextAlignment="Left"
                         TextWrapping="Wrap" HorizontalAlignment="Left"
                         Foreground="{DynamicResource md3.on-surface-variant}"/>
            </Border>
          </StackPanel>
        </Grid>

        <c:AdaptiveColumns x:Name="PageMidi" IsVisible="False">
          <StackPanel Grid.Column="0" Spacing="{DynamicResource Md3Spacing3}">
            <Border Classes="card">
              <StackPanel Spacing="{DynamicResource Md3Spacing3}" Margin="0,12" MaxWidth="400" HorizontalAlignment="Center">
                <Grid Width="64" Height="64" HorizontalAlignment="Center">
                  <c:MaterialShape Kind="Square" Fill="{DynamicResource md3.secondary-container}"/>
                  <c:DawIcon Data="{StaticResource icon-music}" Width="24" Height="24"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource md3.on-secondary-container}"/>
                </Grid>
                <TextBlock Classes="cardTitle" Text="{DynamicResource prefs.nav.midi}"/>
                <TextBlock Classes="cardSub" Text="{DynamicResource prefs.midi.empty}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </c:AdaptiveColumns>

      </StackPanel>
    </ScrollViewer>

    <!-- 吸底操作条：关闭（落盘并重套主题后退出），右下角对齐 -->
    <Border Grid.Row="1" Padding="24,12" Background="{DynamicResource md3.surface}"
            BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="helpText" VerticalAlignment="Center" Margin="0,0,16,0"
                 Text="{DynamicResource prefs.save.hint}"/>
      <Button Grid.Column="1" Classes="filledPill" MinWidth="88" HorizontalAlignment="Right"
              Content="{DynamicResource prefs.close}" Click="OnCloseClicked"/>
      </Grid>
    </Border>
    </Grid>
  </Grid>
  </Grid>
</UserControl>
