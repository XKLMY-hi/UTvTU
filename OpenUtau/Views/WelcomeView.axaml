<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenUtau.App.ViewModels"
             xmlns:motion="using:OpenUtau.Theming"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
             x:Class="OpenUtau.App.Views.WelcomeView">
  <UserControl.Resources>
    <!-- 弹层外框：把 Fluent/Flyout 自带的内边距与边框去掉，只留 md3 容器（旧主题键不进新界面） -->
    <ControlTheme x:Key="Md3FlyoutPresenter" TargetType="FlyoutPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
    </ControlTheme>
  </UserControl.Resources>
  <!-- 欢迎视图（内嵌主窗口）· 结构对齐设计稿 1-Welcome：
       .opencode/design/UTVTU-设计交付/{png/1-Welcome.png,spec/Welcome.txt}
       左侧品牌面板 480（primary-container 实底）+ 右侧启动器；颜色一律取 md3 角色键，文案一律取现有字符串键。
       设计稿自带的 56px 顶栏与 32px 状态条属于窗口级 chrome，待主窗统一时做（本轮不做）。 -->
  <UserControl.Styles>
    <!-- ══ 左栏：快捷入口行（14px 图标 + 文案；hover 走状态层底色，过渡由动效令牌给） ══ -->
    <Style Selector="Border.linkRow">
      <Setter Property="Height" Value="32"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.linkRow Path">
      <Setter Property="Fill" Value="{DynamicResource md3.on-surface}"/>
    </Style>
    <Style Selector="Border.linkRow TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
    </Style>
    <Style Selector="Border.linkRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>

    <!-- ══ 启动器：动作卡（稿：高 104 / 圆角 16 / 内边距 24 / 图标圆 48） ══ -->
    <Style Selector="Border.actionCard">
      <Setter Property="Height" Value="104"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="24"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline-variant}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.actionCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
    </Style>
    <!-- 主行动（新建）：primary 实底 + on-primary 圆 + primary 字形（稿：6FDBCB / 00382F / 00382F） -->
    <Style Selector="Border.actionCard.primary">
      <Setter Property="Background" Value="{DynamicResource md3.primary}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.actionCard.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.primary}"/>
      <Setter Property="Opacity" Value="0.94"/>
    </Style>
    <Style Selector="Border.cardIcon">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Background" Value="{DynamicResource md3.secondary-container}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.cardIcon.primary">
      <Setter Property="Background" Value="{DynamicResource md3.on-primary}"/>
    </Style>

    <!-- ══ 启动器：最近工程行（稿：内边距 10 / 圆角 12 / 缩略图 48 圆角 8）
         注意：不用 ListBox——Styles.axaml 里有全局隐式 ListBoxItem{Height=28}（旧密度覆盖），
         会把 68px 的行夹扁；新界面自己定尺寸，不吃旧全局样式。 ══ -->
    <Style Selector="Border.recentRow">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.recentRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>

    <!-- ══ 模板下拉（稿里没有的形态：卡片飞行弹层） ══ -->
    <Style Selector="Border.flyoutRow">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.flyoutRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="352,*" Background="{DynamicResource md3.surface}">
    <!-- ══════════ 品牌面板（稿：内边距 48 上下分栏）
         悬浮卡片形态：外缩 16 + 内边距 32 = 内容仍在 48 基准线；卡片实宽 320，圆角 r-lg(16)
         卡片底色 = surface-container（与最近工程行同色，用户裁定；稿子原为 primary-container） ══════════ -->
    <Border Grid.Column="0" Margin="16" CornerRadius="16" ClipToBounds="True"
            Background="{DynamicResource md3.surface-container}">
      <Grid RowDefinitions="Auto,*,Auto" Margin="32">
        <!-- 标识：52 圆角 12 primary 底 + mic 字形（卡片中性化后，主色只留在这一处做点睛） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
          <Border Width="52" Height="52" CornerRadius="12"
                  Background="{DynamicResource md3.primary}">
            <Path Data="{StaticResource icon-mic}" Width="26" Height="26" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Fill="{DynamicResource md3.on-primary}"/>
          </Border>
          <TextBlock Text="UTvTU" FontSize="26" FontWeight="Medium"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource md3.on-surface}"/>
        </StackPanel>

        <!-- 快捷入口 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,32,0,0" Spacing="12">
          <TextBlock Text="{DynamicResource welcome.quicklinks}" FontSize="11"
                     Foreground="{DynamicResource md3.on-surface-variant}"/>
          <StackPanel Spacing="2">
            <Border Classes="linkRow" motion:Motion.Hover="True" PointerPressed="OnWiki">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{StaticResource icon-book-open}" Width="18" Height="18" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource welcome.wiki}" FontSize="14" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Classes="linkRow" motion:Motion.Hover="True" PointerPressed="OnReleases">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{StaticResource icon-download}" Width="18" Height="18" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource welcome.releases}" FontSize="14" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Classes="linkRow" motion:Motion.Hover="True" PointerPressed="OnDiffsinger">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{StaticResource icon-sparkles}" Width="18" Height="18" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource welcome.diffsinger}" FontSize="14" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Classes="linkRow" motion:Motion.Hover="True" PointerPressed="OnTeto">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{StaticResource icon-globe}" Width="18" Height="18" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource welcome.teto}" FontSize="14" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Classes="linkRow" motion:Motion.Hover="True" PointerPressed="OnPackages">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{StaticResource icon-package}" Width="18" Height="18" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource welcome.packages}" FontSize="14" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Classes="linkRow" motion:Motion.Hover="True" PointerPressed="OnPreferences">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{StaticResource icon-settings}" Width="18" Height="18" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource welcome.prefs}" FontSize="14" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- 版本行 -->
        <StackPanel Grid.Row="2" Spacing="12">
          <Border Height="1" Background="{DynamicResource md3.outline-variant}"/>
          <TextBlock Text="{Binding AppVersion}" FontSize="11"
                     Foreground="{DynamicResource md3.on-surface-variant}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ══════════ 启动器（稿：内边距 48 / 纵向间距 16） ══════════ -->
    <Grid Grid.Column="1" Margin="48" RowDefinitions="Auto,Auto,*">
      <TextBlock Grid.Row="0" Text="{DynamicResource welcome.start}" FontSize="30"
                 Foreground="{DynamicResource md3.on-surface}"/>

      <!-- 动作卡 2×2（稿里是「新建 / 打开」两个，Plus 另有两个入口沿用同一卡片几何）；hover 过渡走动效令牌 -->
      <Grid Grid.Row="1" Margin="0,16,0,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
        <Border Grid.Row="0" Grid.Column="0" Classes="actionCard primary" Margin="0,0,8,0"
                motion:Motion.Hover="True" PointerPressed="OnNewProject">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Border Classes="cardIcon primary">
              <Path Data="{StaticResource icon-plus}" Width="26" Height="26" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource md3.primary}"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="{DynamicResource welcome.new}" FontSize="18" FontWeight="Medium"
                         Foreground="{DynamicResource md3.on-primary}"/>
              <TextBlock Text="{DynamicResource welcome.new.description}" FontSize="13"
                         Foreground="{DynamicResource md3.on-primary}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Classes="actionCard" Margin="8,0,0,0"
                motion:Motion.Hover="True" PointerPressed="OnOpenProject">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Border Classes="cardIcon">
              <Path Data="{StaticResource icon-folder-open}" Width="24" Height="24" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource md3.on-secondary-container}"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="{DynamicResource welcome.open}" FontSize="18" FontWeight="Medium"
                         Foreground="{DynamicResource md3.on-surface}"/>
              <TextBlock Text="{DynamicResource welcome.open.description}" FontSize="13"
                         Foreground="{DynamicResource md3.on-surface-variant}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Classes="actionCard" Margin="0,16,8,0"
                motion:Motion.Hover="True" PointerPressed="OnImportAudio">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Border Classes="cardIcon">
              <Path Data="{StaticResource icon-music}" Width="24" Height="24" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource md3.on-secondary-container}"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="{DynamicResource menu.file.importtracks}" FontSize="18" FontWeight="Medium"
                         Foreground="{DynamicResource md3.on-surface}"/>
              <TextBlock Text="{DynamicResource menu.file.importaudio}" FontSize="13"
                         Foreground="{DynamicResource md3.on-surface-variant}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Classes="actionCard" Margin="8,16,0,0"
                IsVisible="{Binding TemplateFiles.Count}"
                motion:Motion.Hover="True"
                PointerPressed="OnShowTemplates">
          <FlyoutBase.AttachedFlyout>
            <Flyout Placement="BottomEdgeAlignedLeft"
                    FlyoutPresenterTheme="{StaticResource Md3FlyoutPresenter}">
              <Border Background="{DynamicResource md3.surface-container-high}"
                      BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="1"
                      CornerRadius="12" Padding="6" MinWidth="240" MaxHeight="320"
                      motion:Motion.Popup="True">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding TemplateFiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RecentFileInfo">
                        <Border Classes="flyoutRow" PointerPressed="OnOpenTemplate">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource icon-file-plus}" Width="16" Height="16"
                                  Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{DynamicResource md3.on-surface-variant}"/>
                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource md3.on-surface}"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </Flyout>
          </FlyoutBase.AttachedFlyout>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Border Classes="cardIcon">
              <Path Data="{StaticResource icon-file-plus}" Width="24" Height="24" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource md3.on-secondary-container}"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="{DynamicResource welcome.template}" FontSize="18" FontWeight="Medium"
                         Foreground="{DynamicResource md3.on-surface}"/>
              <TextBlock Text="{DynamicResource menu.file.newfromtemplate}" FontSize="13"
                         Foreground="{DynamicResource md3.on-surface-variant}"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 最近工程 -->
      <Grid Grid.Row="2" Margin="0,16,0,0" RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="{DynamicResource welcome.recent}" FontSize="18" FontWeight="Medium"
                   Margin="0,0,0,16"
                   Foreground="{DynamicResource md3.on-surface}"/>

        <!-- 恢复条（原版能力：未保存会话的恢复入口） -->
        <Border Grid.Row="1" IsVisible="{Binding HasRecovery}" PointerPressed="OnRecovery"
                CornerRadius="12" Padding="12,10" Margin="0,0,0,12" Cursor="Hand"
                Background="{DynamicResource md3.error-container}">
          <TextBlock Text="{Binding RecoveryString}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{DynamicResource md3.on-error-container}"/>
        </Border>

        <ScrollViewer Grid.Row="2" AllowAutoHide="False"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding RecentFiles.Count}">
          <ItemsControl ItemsSource="{Binding RecentFiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecentFileInfo">
                <Border Classes="recentRow" Margin="0,0,0,12" motion:Motion.Hover="True"
                        PointerPressed="OnOpenRecent">
                  <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                    <Border Width="48" Height="48" CornerRadius="8"
                            Background="{DynamicResource md3.secondary-container}">
                      <Path Data="{StaticResource icon-file}" Width="24" Height="24" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Fill="{DynamicResource md3.on-secondary-container}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource md3.on-surface}"/>
                      <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource md3.on-surface-variant}">
                        <TextBlock.Text>
                          <MultiBinding StringFormat="{}{0} · {1}">
                            <Binding Path="Format"/>
                            <Binding Path="Directory"/>
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding LastWriteTimeStr}" FontSize="12" VerticalAlignment="Center"
                                 Foreground="{DynamicResource md3.on-surface-variant}"/>
                      <Path Data="{StaticResource icon-chevron-right}" Width="20" Height="20"
                            Stretch="Uniform" VerticalAlignment="Center"
                            Fill="{DynamicResource md3.on-surface-variant}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="4,4,0,0" FontSize="12"
                   Text="{DynamicResource welcome.open.description}"
                   Foreground="{DynamicResource md3.on-surface-variant}"
                   IsVisible="{Binding !RecentFiles.Count}"/>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
