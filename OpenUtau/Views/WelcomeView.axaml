<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenUtau.App.ViewModels"
             xmlns:c="clr-namespace:OpenUtau.App.Controls"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
             x:Class="OpenUtau.App.Views.WelcomeView" Classes="professionalPage">
  <!-- Pen U4 project hub: real project commands and shared dynamic color roles.
       Hero rings/bars use the supplied HTML; existing brand paths remain unchanged. -->
  <UserControl.Styles>
    <Style Selector="Button.primary,Button.tonal,Button.outline">
      <Setter Property="Theme" Value="{StaticResource DawButtonTheme}"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Height" Value="{DynamicResource Md3ControlHeight}"/>
      <Setter Property="MinHeight" Value="{DynamicResource Md3ControlHeight}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeFull}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.primary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource md3.primary}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-primary}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.tonal">
      <Setter Property="Background" Value="{DynamicResource md3.secondary-container}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-secondary-container}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.pageAction">
      <Setter Property="Height" Value="{DynamicResource Md3ControlHeight}"/>
      <Setter Property="MinHeight" Value="{DynamicResource Md3ControlHeight}"/>
    </Style>
    <Style Selector="Button.startCard">
      <Setter Property="Theme" Value="{StaticResource DawButtonTheme}"/>
      <Setter Property="Height" Value="196"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeExtraLarge}"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.startCard.featured">
      <Setter Property="Padding" Value="24"/>
      <Setter Property="Background" Value="{DynamicResource md3.primary-container}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-primary-container}"/>
    </Style>
    <Style Selector="Button.startCard TextBlock">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Button.primary TextBlock,Button.tonal TextBlock,Button.outline TextBlock">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
    </Style>
    <Style Selector="Viewbox.heroArt"><Setter Property="Width" Value="360"/><Setter Property="Height" Value="168"/></Style>
    <Style Selector=":is(UserControl).compact Viewbox.heroArt"><Setter Property="Width" Value="144"/><Setter Property="Height" Value="96"/></Style>
    <Style Selector=":is(UserControl).compact TextBlock.pageTitle"><Setter Property="FontSize" Value="28"/><Setter Property="LineHeight" Value="36"/></Style>
    <Style Selector=":is(UserControl).compact Button.startCard"><Setter Property="Height" Value="164"/><Setter Property="Padding" Value="16"/></Style>
    <Style Selector="Button.startCard:not(.featured)"><Setter Property="CornerRadius" Value="16"/></Style>
    <!-- Shared semantic typography: title 22, body 13/12, label 12/11. -->
    <Style Selector="TextBlock.groupLabel">
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeLabelMedium}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="36"/>
      <Setter Property="LineHeight" Value="40"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
    </Style>
    <Style Selector="TextBlock.pageSub">
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodyMedium}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodySmall}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>

    <!-- ══ 左栏"帮助链接"行（低频动作：12px 小字，仍是 Button ⇒ Tab 可达）
         主导航项不在这里 —— 它们用应用级共享的 `Button.navItem`。 ══ -->
    <Style Selector="Button.railLink">
      <Setter Property="Theme" Value="{StaticResource DawButtonTheme}"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeFull}"/>
      <!-- 常驻 1px 透明描边：焦点态只换颜色 ⇒ **零布局位移** -->
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeLabelMedium}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.railLink:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
    </Style>
    <Style Selector="Button.railLink Path">
      <Setter Property="Fill" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>
    <!-- ⚠ 与共享层同一条陷阱：应用级 `TextBlock{FontSize 13}` 压过继承 ⇒ 必须显式声明，
         否则"12px 小字行"实际渲染成 13px（fx-ui 复核第 3 条实测命中）。 -->
    <Style Selector="Button.railLink TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeLabelMedium}"/>
    </Style>
    <Style Selector="Button.railLink:focus-visible">
      <!-- 只换颜色：厚度已由基础态定为 1px ⇒ 聚焦零布局位移 -->
      <Setter Property="BorderBrush" Value="{DynamicResource md3.primary}"/>
    </Style>

    <!-- ══ 最近工程行（56 / 圆角 12；图标容器 40）
         ⚠ 不用 ListBox：全局隐式 `ListBoxItem{Height=28}` 会把 56 行夹扁。 ══ -->
    <Style Selector="Button.recentRow">
      <Setter Property="Theme" Value="{StaticResource DawButtonTheme}"/>
      <Setter Property="Height" Value="64"/>
      <Setter Property="MinHeight" Value="56"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeMedium}"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.recentRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>
    <Style Selector="Button.recentRow:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource md3.primary}"/>
    </Style>
    <Style Selector="Border.fileIcon">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeSmall}"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>

    <!-- ══ 格式徽标 = assist chip（高 24 / 圆角 8 / label 11） ══ -->
    <Style Selector="Border.badge">
      <Setter Property="Height" Value="24"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeSmall}"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeLabelSmall}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>

    <!-- ══ 音源 chip（高 28 / 圆角 999） ══ -->
    <Style Selector="Border.chip">
      <Setter Property="Height" Value="28"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeFull}"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Source-derived Square empty state: 72 shape, 26 icon, title 16. -->
    <Style Selector="Grid.emptyIcon">
      <Setter Property="Width" Value="72"/>
      <Setter Property="Height" Value="72"/>
    </Style>
    <Style Selector="TextBlock.emptyTitle">
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeTitleMedium}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
    </Style>

    <!-- Template rows retain 240x64 geometry and shared medium shape. -->
    <Style Selector="Button.templateCard">
      <Setter Property="Theme" Value="{StaticResource DawButtonTheme}"/>
      <Setter Property="Width" Value="240"/>
      <Setter Property="Height" Value="64"/>
      <Setter Property="MinHeight" Value="64"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeMedium}"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline-variant}"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.templateCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>

    <!-- Existing drop hint: 32 high, one-pixel separator. -->
    <Style Selector="Border.dropStrip">
      <Setter Property="Height" Value="32"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline-variant}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="240,*" Background="{DynamicResource md3.surface}">
    <Border Grid.ColumnSpan="2" Height="24" VerticalAlignment="Top" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar"/>

    <!-- ══════════ 左：导航栏（232 / surface-container-low，与偏好设置同构） ══════════ -->
    <Border Grid.Column="0" Background="{DynamicResource md3.surface-container-low}"
            BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="0,20,0,16">

        <!-- 品牌锁定（cap 20 = 旧版 cap 24 的 0.8333 倍，比例逐项同源；几何取 Icons.axaml 冻结键） -->
        <StackPanel Grid.Row="0" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar" Margin="24,0,24,20" Spacing="{DynamicResource Md3Spacing1}">
          <Canvas IsHitTestVisible="False" Width="118.43" Height="24.00" HorizontalAlignment="Left">
            <Path Canvas.Left="2.18" Canvas.Top="2.18" Width="8.73" Height="19.63" Stretch="Uniform"
                  Data="{StaticResource brand-brace}" Stroke="{DynamicResource md3.primary}"
                  StrokeThickness="4.37" StrokeLineCap="Round" StrokeJoin="Round"/>
            <Path Canvas.Left="21.49" Canvas.Top="1.63" Width="75.44" Height="20" Stretch="Uniform"
                  Data="{StaticResource brand-wordmark}" Fill="{DynamicResource md3.on-surface}"/>
            <Path Canvas.Left="55.33" Canvas.Top="13.51" Width="6.65" Height="10.38" Stretch="Uniform"
                  Data="{StaticResource brand-v-chevron}" Stroke="{DynamicResource md3.on-surface}"
                  StrokeThickness="4.46" StrokeLineCap="Round" StrokeJoin="Round"/>
            <Path Canvas.Left="107.52" Canvas.Top="2.18" Width="8.73" Height="19.63" Stretch="Uniform"
                  Data="{StaticResource brand-brace}" Stroke="{DynamicResource md3.primary}"
                  StrokeThickness="4.37" StrokeLineCap="Round" StrokeJoin="Round"
                  RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform>
                <ScaleTransform ScaleX="-1"/>
              </Path.RenderTransform>
            </Path>
          </Canvas>
          <TextBlock Classes="caption" IsHitTestVisible="False" Text="{DynamicResource welcome.brand.tagline}"/>
        </StackPanel>

        <!-- 分组导航（主轴 = 共享 Button.navItem；选中态类 .selected 由 code-behind 切换） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Classes="groupLabel" Margin="24,0,24,6" Text="{DynamicResource welcome.nav.start}"/>
            <StackPanel Margin="12,0" Spacing="2">
              <Button x:Name="NavRecent" Classes="navItem selected" Click="OnNavRecent">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}" VerticalAlignment="Center">
                  <c:DawIcon Data="{StaticResource icon-clock}" Width="18" Height="18"
                        VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                  <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource welcome.recent}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavNew" Classes="navItem" Click="OnNavNew">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}" VerticalAlignment="Center">
                  <c:DawIcon Data="{StaticResource icon-file-plus}" Width="18" Height="18"
                        VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                  <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource welcome.new}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavOpen" Classes="navItem" Click="OnNavOpen">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}" VerticalAlignment="Center">
                  <c:DawIcon Data="{StaticResource icon-folder-open}" Width="18" Height="18"
                        VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                  <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource welcome.open}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavTemplates" Classes="navItem" Click="OnNavTemplates">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}" VerticalAlignment="Center">
                  <c:DawIcon Data="{StaticResource icon-layout}" Width="18" Height="18"
                        VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                  <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource welcome.template}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <TextBlock Classes="groupLabel" Margin="24,20,24,6" Text="{DynamicResource welcome.nav.other}"/>
            <StackPanel Margin="12,0" Spacing="2">
              <Button Classes="navItem" Click="OnPreferences">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}" VerticalAlignment="Center">
                  <c:DawIcon Data="{StaticResource icon-settings}" Width="18" Height="18"
                        VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                  <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource welcome.prefs}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Classes="navItem" Click="OnPackages">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}" VerticalAlignment="Center">
                  <c:DawIcon Data="{StaticResource icon-package}" Width="18" Height="18"
                        VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                  <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource welcome.packages}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <TextBlock Classes="groupLabel" Margin="24,20,24,6" Text="{DynamicResource welcome.nav.links}"/>
            <StackPanel Margin="12,0" Spacing="2">
              <Button Classes="railLink" Click="OnWiki">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}" VerticalAlignment="Center">
                  <c:DawIcon Data="{StaticResource icon-book-open}" Width="15" Height="15"
                        VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                  <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource welcome.wiki}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Classes="railLink" Click="OnReleases">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}" VerticalAlignment="Center">
                  <c:DawIcon Data="{StaticResource icon-download}" Width="15" Height="15"
                        VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                  <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource welcome.releases}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Classes="railLink" Click="OnDiffsinger">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}" VerticalAlignment="Center">
                  <c:DawIcon Data="{StaticResource icon-sparkles}" Width="15" Height="15"
                        VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                  <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource welcome.diffsinger}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Classes="railLink" Click="OnTeto">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}" VerticalAlignment="Center">
                  <c:DawIcon Data="{StaticResource icon-globe}" Width="15" Height="15"
                        VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
                  <TextBlock FontSize="{Binding $parent[Button].FontSize}" Foreground="{Binding $parent[Button].Foreground}" UseLayoutRounding="False" Text="{DynamicResource welcome.teto}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- 版本行（构建时刻版本号） -->
        <TextBlock Grid.Row="2" Classes="caption" Margin="24,12,24,0" Text="{Binding AppVersion}"/>
      </Grid>
    </Border>

    <!-- U4 HTML: 240 rail, 32 content inset, 40 search, 168 hero, 196 action cards.
         The window owns its chrome; all displayed project information comes from the existing VM. -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="32,24,32,0">
      <Grid Margin="0,0,0,24" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar">
        <Border Margin="{DynamicResource Md3WorkspaceCaptionInset}" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar">
        <Grid x:Name="WelcomeSearchArea">
        <TextBox x:Name="SearchBox" chrome:WindowDecorationProperties.ElementRole="User" Height="40" MinHeight="40" MaxWidth="400" HorizontalAlignment="Left"
                 HorizontalContentAlignment="Stretch" Width="{Binding #WelcomeSearchArea.Bounds.Width}" CornerRadius="20" Padding="40,0,12,0"
                 Text="{Binding WelcomeSearch, Mode=TwoWay}" TextChanged="OnSearchChanged"
                 PlaceholderText="{DynamicResource welcome.search.placeholder}"/>
        <c:DawIcon Data="{StaticResource icon-search}" Width="18" Height="18" Margin="14,0,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                   Fill="{DynamicResource md3.on-surface-variant}"/>
        </Grid>
        </Border>
      </Grid>
      <ScrollViewer x:Name="WelcomeScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="24">
      <Border Background="Transparent" Padding="0" MinHeight="168">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="12" VerticalAlignment="Center" Margin="0,0,24,0">
            <TextBlock Classes="groupLabel" Text="{DynamicResource welcome.hero.eyebrow}" Foreground="{DynamicResource md3.primary}"/>
            <TextBlock x:Name="PageTitle" Classes="pageTitle" TextWrapping="Wrap"/>
            <TextBlock x:Name="PageSubtitle" Classes="pageSub" MaxWidth="580" HorizontalAlignment="Left"/>
          </StackPanel>
          <!-- Filled ring contours are copied verbatim from HTML clip-paths, not traced from PNG. -->
          <Viewbox x:Name="HeroIllustration" Classes="heroArt" Grid.Column="1" IsHitTestVisible="False" Stretch="Uniform" VerticalAlignment="Center">
          <Canvas x:Name="HeroArt" Width="360" Height="168" IsHitTestVisible="False">
            <Path Canvas.Left="186" Canvas.Top="2" Width="152" Height="152" Data="M76 0 C117.974 0 152 34.026 152 76 C152 117.974 117.974 152 76 152 C34.026 152 0 117.974 0 76 C0 34.026 34.026 0 76 0 Z M76 13.68 C41.582 13.68 13.68 41.582 13.68 76 C13.68 110.418 41.582 138.32 76 138.32 C110.418 138.32 138.32 110.418 138.32 76 C138.32 41.582 110.418 13.68 76 13.68 Z" Fill="{DynamicResource md3.primary-container}"/>
            <Path Canvas.Left="268" Canvas.Top="84" Width="68" Height="68" Data="M34 0 C52.778 0 68 15.222 68 34 C68 52.778 52.778 68 34 68 C15.222 68 0 52.778 0 34 C0 15.222 15.222 0 34 0 Z M34 4.76 C17.851 4.76 4.76 17.851 4.76 34 C4.76 50.149 17.851 63.24 34 63.24 C50.149 63.24 63.24 50.149 63.24 34 C63.24 17.851 50.149 4.76 34 4.76 Z" Fill="{DynamicResource md3.outline-variant}"/>
            <Path Canvas.Left="14" Canvas.Top="92" Width="64" Height="64" Data="M32 0 C49.673 0 64 14.327 64 32 C64 49.673 49.673 64 32 64 C14.327 64 0 49.673 0 32 C0 14.327 14.327 0 32 0 Z M32 8.32 C18.922 8.32 8.32 18.922 8.32 32 C8.32 45.078 18.922 55.68 32 55.68 C45.078 55.68 55.68 45.078 55.68 32 C55.68 18.922 45.078 8.32 32 8.32 Z" Fill="{DynamicResource md3.tertiary-container}"/>
            <Ellipse Canvas.Left="312" Canvas.Top="24" Width="24" Height="24" Fill="{DynamicResource md3.tertiary}"/>
            <Border Canvas.Left="64" Canvas.Top="36" Width="104" Height="104" CornerRadius="34"
                    Background="Transparent" RenderTransformOrigin="0,0">
              <Border.RenderTransform><RotateTransform Angle="-4"/></Border.RenderTransform>
              <Grid>
              <c:MaterialMorph x:Name="HeaderShape" Kind="Circle" Width="124" Height="124" Fill="{DynamicResource md3.primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="4" Height="12" CornerRadius="2" Background="{DynamicResource md3.on-primary}" VerticalAlignment="Center"/>
                <Border Width="4" Height="24" CornerRadius="2" Background="{DynamicResource md3.on-primary}" VerticalAlignment="Center"/>
                <Border Width="4" Height="36" CornerRadius="2" Background="{DynamicResource md3.on-primary}" VerticalAlignment="Center"/>
                <Border Width="4" Height="20" CornerRadius="2" Background="{DynamicResource md3.on-primary}" VerticalAlignment="Center"/>
                <Border Width="4" Height="10" CornerRadius="2" Background="{DynamicResource md3.on-primary}" VerticalAlignment="Center"/>
              </StackPanel>
              </Grid>
            </Border>
          </Canvas>
          </Viewbox>
        </Grid>
      </Border>

      <Grid>


        <!-- ── 页 1：最近（搜索 + 恢复条 + 列表 + 双空态） ── -->
        <Grid x:Name="PageRecent" RowDefinitions="Auto,*">
          <Grid x:Name="RecentActions" Grid.Row="0" ColumnDefinitions="1.75*,*,*" Margin="0,0,0,24">
            <Button x:Name="QuickNew" Classes="startCard featured" Margin="0,0,16,0" Click="OnNewProject"
                    AutomationProperties.Name="{DynamicResource welcome.new.blank}">
              <Grid RowDefinitions="Auto,*,Auto">
                <Grid Width="44" Height="44" HorizontalAlignment="Left">
                  <c:MaterialShape Kind="Arch" Fill="{DynamicResource md3.primary}"/>
                  <c:DawIcon Data="{StaticResource icon-plus}" Width="20" Height="20"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource md3.on-primary}"/>
                </Grid>
                <TextBlock Grid.Row="1" Margin="0,12,0,0" FontSize="{DynamicResource Md3TypeTitleMedium}"
                           FontWeight="Medium" Text="{DynamicResource welcome.new.blank}"/>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                  <Border Background="{DynamicResource md3.primary}" CornerRadius="20" Padding="16,8">
                    <TextBlock Text="{DynamicResource welcome.new}" Foreground="{DynamicResource md3.on-primary}"/>
                  </Border>
                  <TextBlock Grid.Column="1" Classes="caption" Text="{DynamicResource welcome.new.shortcut}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
              </Grid>
            </Button>
            <Button x:Name="QuickOpen" Grid.Column="1" Classes="startCard" Margin="0,0,16,0" Click="OnOpenProject"
                    AutomationProperties.Name="{DynamicResource welcome.open}">
              <Grid RowDefinitions="Auto,*,Auto">
                <Grid Width="44" Height="44" HorizontalAlignment="Left">
                  <c:MaterialShape Kind="Sunny" Fill="{DynamicResource md3.tertiary-container}"/>
                  <c:DawIcon Data="{StaticResource icon-folder-open}" Width="20" Height="20"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource md3.on-tertiary-container}"/>
                </Grid>
                <TextBlock Grid.Row="1" Margin="0,12,0,0" FontSize="{DynamicResource Md3TypeTitleMedium}"
                           FontWeight="Medium" Text="{DynamicResource welcome.open}"/>
                <TextBlock Grid.Row="2" Classes="caption" Text="{DynamicResource welcome.open.description}"/>
              </Grid>
            </Button>
            <Button x:Name="QuickTemplates" Grid.Column="2" Classes="startCard" Click="OnShowTemplates"
                    AutomationProperties.Name="{DynamicResource welcome.template}">
              <Grid RowDefinitions="Auto,*,Auto">
                <Grid Width="44" Height="44" HorizontalAlignment="Left">
                  <c:MaterialShape Kind="Square" Fill="{DynamicResource md3.secondary-container}"/>
                  <c:DawIcon Data="{StaticResource icon-layout}" Width="20" Height="20"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource md3.on-secondary-container}"/>
                </Grid>
                <TextBlock Grid.Row="1" Margin="0,12,0,0" FontSize="{DynamicResource Md3TypeTitleMedium}"
                           FontWeight="Medium" Text="{DynamicResource welcome.template}"/>
                <TextBlock Grid.Row="2" Classes="caption" Text="{DynamicResource welcome.template.description}"/>
              </Grid>
            </Button>
          </Grid>
          <Border x:Name="RecentPanel" Grid.Row="1" Padding="0" MinHeight="180"
                  Background="Transparent"
                  BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="0,1,0,0"
                  CornerRadius="0">
          <Grid RowDefinitions="Auto,Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,16,0,16">
            <TextBlock Text="{DynamicResource welcome.recent}" FontSize="{DynamicResource Md3TypeTitleMedium}"
                       Foreground="{DynamicResource md3.on-surface}" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Classes="badge"><TextBlock Text="{Binding FilteredRecentFiles.Count}"/></Border>
          </Grid>

          <!-- 恢复条（原版能力；只在有恢复项时出现） -->
          <Button Grid.Row="1" IsVisible="{Binding HasRecovery}" Click="OnRecovery"
                  Margin="0,0,0,12" CornerRadius="{DynamicResource Md3ShapeMedium}" Padding="16,12" MinHeight="0"
                  HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                  Background="{DynamicResource md3.error-container}" Cursor="Hand">
            <TextBlock Text="{Binding RecoveryString}" TextWrapping="Wrap" FontSize="{DynamicResource Md3TypeLabelMedium}"
                       Foreground="{DynamicResource md3.on-error-container}"/>
          </Button>

          <ScrollViewer x:Name="RecentList" Grid.Row="2" MaxHeight="360" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding FilteredRecentFiles.Count}">
            <ItemsControl ItemsSource="{Binding FilteredRecentFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentFileInfo">
                  <Button Classes="recentRow" Click="OnOpenRecent">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent">
                      <Border Classes="fileIcon">
                        <c:DawIcon Data="{StaticResource icon-file}" Width="20" Height="20"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource md3.on-surface-variant}"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Md3TypeBodyMedium}" FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource md3.on-surface}"/>
                        <TextBlock Text="{Binding Directory}" FontSize="{DynamicResource Md3TypeBodySmall}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource md3.on-surface-variant}"/>
                      </StackPanel>
                      <Border Grid.Column="2" Classes="badge" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Format}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      </Border>
                      <TextBlock Grid.Column="3" Classes="caption" Text="{Binding LastWriteTimeStr}"
                                 VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- 空态 A：一个工程都没有 -->
          <StackPanel x:Name="EmptyRecent" Grid.Row="2" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                      MaxWidth="440" IsVisible="{Binding WelcomeNoRecent}">
            <Grid Classes="emptyIcon" HorizontalAlignment="Center">
              <c:MaterialShape Kind="Sunny" Fill="{DynamicResource md3.secondary-container}"/>
              <c:DawIcon Data="{StaticResource icon-file-plus}" Width="26" Height="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource md3.on-secondary-container}"/>
            </Grid>
            <TextBlock Classes="emptyTitle" HorizontalAlignment="Center" TextWrapping="Wrap"
                       Text="{DynamicResource welcome.recent.empty}"/>
            <TextBlock Classes="caption" FontSize="{DynamicResource Md3TypeBodyMedium}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Text="{DynamicResource welcome.empty.folder}"/>
          </StackPanel>

          <!-- 空态 B：有工程但搜索无匹配（必须与 A 区分，否则用户以为工程丢了） -->
          <StackPanel x:Name="EmptySearch" Grid.Row="2" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                      MaxWidth="360" IsVisible="{Binding WelcomeNoMatch}">
            <Grid Classes="emptyIcon" HorizontalAlignment="Center">
              <c:MaterialShape Kind="Square" Fill="{DynamicResource md3.secondary-container}"/>
              <c:DawIcon Data="{StaticResource icon-search}" Width="26" Height="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource md3.on-secondary-container}"/>
            </Grid>
            <TextBlock Classes="emptyTitle" HorizontalAlignment="Center" TextWrapping="Wrap"
                       Text="{DynamicResource welcome.search.noresult}"/>
          </StackPanel>
          </Grid>
          </Border>
        </Grid>

        <!-- ── 页 2：新建 ── -->
        <StackPanel x:Name="PageNew" IsVisible="False" Spacing="{DynamicResource Md3Spacing4}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}">
            <Button Classes="primary" Click="OnNewProject" MinHeight="{DynamicResource Md3ControlHeight}" Padding="20,0">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing2}" VerticalAlignment="Center">
                <c:DawIcon Data="{StaticResource icon-plus}" Width="16" Height="16"
                      VerticalAlignment="Center" Fill="{DynamicResource md3.on-primary}"/>
                <TextBlock Text="{DynamicResource welcome.new.blank}" FontSize="{DynamicResource Md3TypeBodyMedium}"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Classes="tonal" Click="OnShowTemplates" MinHeight="{DynamicResource Md3ControlHeight}" Padding="20,0"
                    ToolTip.Tip="{DynamicResource welcome.template.tip}">
              <TextBlock Text="{DynamicResource welcome.template}" FontSize="{DynamicResource Md3TypeBodyMedium}" VerticalAlignment="Center"/>
            </Button>
            <TextBlock Classes="caption" Text="{DynamicResource welcome.new.shortcut}"
                       VerticalAlignment="Center" Margin="4,0,0,0"/>
          </StackPanel>

          <Button Classes="tonal" HorizontalAlignment="Left" Click="OnImportAudio"
                  MinHeight="{DynamicResource Md3ControlHeight}" Padding="20,0">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing2}" VerticalAlignment="Center">
              <c:DawIcon Data="{StaticResource icon-music}" Width="16" Height="16"
                    VerticalAlignment="Center" Fill="{Binding $parent[Button].Foreground}"/>
              <TextBlock Text="{DynamicResource menu.file.importaudio}" FontSize="{DynamicResource Md3TypeBodyMedium}"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- 已安装音源（真实数据；取不到就整段隐藏，不编数） -->
          <StackPanel x:Name="SingersSection" Margin="0,8,0,0" IsVisible="False" Spacing="{DynamicResource Md3Spacing2}">
            <TextBlock Classes="groupLabel" Text="{DynamicResource welcome.singers.installed}"/>
            <ItemsControl x:Name="SingerChips">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="chip" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing2}" VerticalAlignment="Center">
                      <Border Width="6" Height="6" CornerRadius="{DynamicResource Md3ShapeFull}"
                              Background="{DynamicResource md3.primary}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Md3TypeLabelMedium}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource md3.on-surface-variant}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <!-- ── 页 3：打开 ── -->
        <StackPanel x:Name="PageOpen" IsVisible="False" Spacing="14">
          <Button Classes="primary" HorizontalAlignment="Left" Click="OnOpenProject"
                  MinHeight="{DynamicResource Md3ControlHeight}" Padding="20,0">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing2}" VerticalAlignment="Center">
              <c:DawIcon Data="{StaticResource icon-folder-open}" Width="16" Height="16"
                    VerticalAlignment="Center" Fill="{DynamicResource md3.on-primary}"/>
              <TextBlock Text="{DynamicResource welcome.open.browse}" FontSize="{DynamicResource Md3TypeBodyMedium}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock Classes="caption" Text="{DynamicResource welcome.open.supported}"/>
          <TextBlock Classes="caption" Text="{DynamicResource welcome.drop.hint}"/>
        </StackPanel>

        <!-- ── 页 4：模板 ── -->
        <Grid x:Name="PageTemplates" IsVisible="False">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding TemplateFiles}" IsVisible="{Binding TemplateFiles.Count}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecentFileInfo">
                <Button Classes="templateCard" Click="OnOpenTemplate">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing3}" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="{DynamicResource Md3ShapeMedium}"
                            Background="{DynamicResource md3.secondary-container}">
                      <c:DawIcon Data="{StaticResource icon-layout}" Width="18" Height="18"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Fill="{DynamicResource md3.on-secondary-container}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2" MaxWidth="150">
                      <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Md3TypeBodyMedium}" FontWeight="Medium"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource md3.on-surface}"/>
                      <TextBlock Text="{Binding Directory}" FontSize="{DynamicResource Md3TypeBodySmall}"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource md3.on-surface-variant}"/>
                    </StackPanel>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>

          <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                      IsVisible="{Binding !TemplateFiles.Count}">
            <Grid Classes="emptyIcon" HorizontalAlignment="Center">
              <c:MaterialShape Kind="Square" Fill="{DynamicResource md3.secondary-container}"/>
              <c:DawIcon Data="{StaticResource icon-layout}" Width="26" Height="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource md3.on-secondary-container}"/>
            </Grid>
            <TextBlock Classes="emptyTitle" HorizontalAlignment="Center"
                       Text="{DynamicResource welcome.template.empty}"/>
          </StackPanel>
        </Grid>
      </Grid>

      </StackPanel>
      </ScrollViewer>

      <!-- 底部：拖放提示条（把主窗已有的拖放能力显性化） -->
      <Border Grid.Row="2" Classes="dropStrip" IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Md3Spacing2}" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <c:DawIcon Data="{StaticResource icon-download}" Width="16" Height="16"
                VerticalAlignment="Center" Fill="{DynamicResource md3.on-surface-variant}"/>
          <TextBlock Classes="caption" Text="{DynamicResource welcome.drop.hint}" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
