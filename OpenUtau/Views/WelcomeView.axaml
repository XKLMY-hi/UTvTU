<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenUtau.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
             x:Class="OpenUtau.App.Views.WelcomeView">
  <!-- ═══════════════════════════════════════════════════════════════════════════
       欢迎视图（内嵌主窗口）· W36 重设计 —— 几何 / 专业 / 克制
       权威输入：.opencode/design/spec/Welcome.txt + png/1-Welcome.png
       设计说明与差异清单：.opencode/plans/welcome-design.md

       结构语言照设计稿：432 品牌栏 + 启动器；几何波形；字号阶梯 34/30/26/18/15/14/13/12/11；
       间距 4px 基准（4/6/8/10/12/16/24/32/48）；圆角 8/12/16/999。
       **颜色一律落 md3.* 动态色池**（设计稿是独立色板，不搬色值）；**无阴影、无玻璃**。
       强调色只用在 4 处：新建卡实底 · 卡内字形 · 波形柱 · 焦点环。
       ═══════════════════════════════════════════════════════════════════════════ -->
  <UserControl.Resources>
    <!-- 弹层外框：去掉 Fluent/Flyout 自带内边距与边框，只留 md3 容器 -->
    <ControlTheme x:Key="Md3FlyoutPresenter" TargetType="FlyoutPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- ══ 可点元素统一走 Button 语义（键盘可达：Tab 聚焦 + Enter/Space 激活 + 焦点环）
         ⚠ 每个类都必须本地压 MinHeight 与 Margin：全局 Md3ButtonTheme 的 MinHeight=32
           会顶高 104 卡片（Arrange 尊重 MinHeight），应用级 Style 的 Margin=0,4 会撑开行距。
         ⚠ 类名刻意避开 Md3ButtonTheme 已有的 `.primary`（查看全部有意复用 `.linkButton`）。 ══ -->
    <Style Selector="Button.welcome">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <!-- 常驻 1px 透明描边：焦点态只换颜色 ⇒ **零布局位移**（Button 没有 BoxShadow 属性，不能用浮层焦点环） -->
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
    </Style>
    <!-- 焦点环（键盘可达的可见反馈）：只换描边颜色，不改变厚度 ⇒ 不产生布局位移 -->
    <Style Selector="Button.welcome:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource md3.primary}"/>
    </Style>

    <!-- ══ 动作卡（稿：高 104 / 圆角 16 / 内边距 24 / 图标圆 48） ══ -->
    <Style Selector="Button.actionCard">
      <Setter Property="Height" Value="104"/>
      <Setter Property="MinHeight" Value="104"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline-variant}"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
      <Setter Property="Padding" Value="24"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.actionCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
    </Style>
    <!-- 主行动（新建）：primary 实底（稿：实底 + 深字形） -->
    <Style Selector="Button.actionCard.cardMain">
      <Setter Property="Background" Value="{DynamicResource md3.primary}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.actionCard.cardMain:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.primary}"/>
      <Setter Property="Opacity" Value="0.94"/>
    </Style>
    <Style Selector="Border.cardIcon">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Background" Value="{DynamicResource md3.secondary-container}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.cardIcon.onMain">
      <Setter Property="Background" Value="{DynamicResource md3.on-primary}"/>
    </Style>

    <!-- ══ 最近工程行（稿：内边距 10 / 圆角 12 / 缩略图 48 圆角 8）
         ⚠ 刻意不用 ListBox：Styles.axaml 有全局隐式 ListBoxItem{Height=28}（旧密度覆盖），
           会把 68px 的行夹扁。后人"顺手换成 ListBox"就会踩这个坑。 ══ -->
    <Style Selector="Button.recentRow">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="MinHeight" Value="68"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container}"/>
    </Style>
    <Style Selector="Button.recentRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
    </Style>

    <!-- ══ 左侧快捷入口行（次要层级：32 高 / 14px 文案 / 18 图标） ══ -->
    <Style Selector="Button.linkRow">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="0,0,8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>
    <Style Selector="Button.linkRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
    </Style>
    <Style Selector="Button.linkRow Path">
      <Setter Property="Fill" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>

    <!-- ══ 音源 chip（稿：圆角 999 / 内边距 12,0 / 状态点 6 / 文案 12） ══ -->
    <Style Selector="Button.chip">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-high}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ══ 几何波形柱（稿：宽 6 / 圆角 999 / 底部对齐 / 透明度阶梯由数据给） ══ -->
    <Style Selector="Border.waveBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="Background" Value="{DynamicResource md3.primary}"/>
    </Style>

    <!-- ══ 文本层级 ══ -->
    <Style Selector="TextBlock.headline">
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="LineHeight" Value="41"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
    </Style>

    <!-- ══ 拖放提示条（稿：高 56 / 圆角 12 / 20 图标 + 13 文案 / 居中） ══ -->
    <Style Selector="Border.dropHint">
      <Setter Property="Height" Value="56"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline-variant}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ══ 模板下拉行 ══ -->
    <Style Selector="Button.flyoutRow">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.flyoutRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="432,*" Background="{DynamicResource md3.surface}">

    <!-- ══════════ 左：品牌面板（稿 480 teal 满高实底 → 我们 432 surface-container 满高实底 + 主色点睛） ══════════ -->
    <Border Grid.Column="0" Background="{DynamicResource md3.surface-container}"
            BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="32">
        <!-- 品牌头：52 图标 + UTVTU 26 + tagline 13（稿的 Brand Header / Wordmark） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
          <Border Width="52" Height="52" CornerRadius="12"
                  Background="{DynamicResource md3.primary}">
            <Path Data="{StaticResource icon-mic}" Width="26" Height="26" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Fill="{DynamicResource md3.on-primary}"/>
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="UTvTU" FontSize="26" FontWeight="Medium"
                       Foreground="{DynamicResource md3.on-surface}"/>
            <TextBlock Text="{DynamicResource welcome.brand.tagline}" FontSize="13"
                       Foreground="{DynamicResource md3.on-surface-variant}"/>
          </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Top" Margin="0,32,8,0">
          <!-- 几何波形：唯一的装饰（26 根柱，数据取自设计稿） -->
          <ItemsControl x:Name="WaveformBars" Height="132" VerticalAlignment="Bottom">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="waveBar" Height="{Binding Height}" Opacity="{Binding Opacity}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 标语 + 描述 -->
          <TextBlock Classes="headline" Margin="0,24,0,0" Text="{DynamicResource welcome.brand.headline}"/>
          <TextBlock Margin="0,12,0,0" FontSize="15" LineHeight="23" TextWrapping="Wrap"
                     Foreground="{DynamicResource md3.on-surface-variant}"
                     Text="{DynamicResource welcome.brand.description}"/>

          <!-- 能力行 ×3（稿的 Features：18 图标 + 14 文案） -->
          <StackPanel Margin="0,24,0,0" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Data="{StaticResource icon-equalizer}" Width="18" Height="18" Stretch="Uniform"
                    VerticalAlignment="Center" Fill="{DynamicResource md3.on-surface-variant}"/>
              <TextBlock FontSize="14" VerticalAlignment="Center"
                         Foreground="{DynamicResource md3.on-surface-variant}"
                         Text="{DynamicResource welcome.feature.voicebank}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Data="{StaticResource icon-pencil}" Width="18" Height="18" Stretch="Uniform"
                    VerticalAlignment="Center" Fill="{DynamicResource md3.on-surface-variant}"/>
              <TextBlock FontSize="14" VerticalAlignment="Center"
                         Foreground="{DynamicResource md3.on-surface-variant}"
                         Text="{DynamicResource welcome.feature.lyrics}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Data="{StaticResource icon-layout}" Width="18" Height="18" Stretch="Uniform"
                    VerticalAlignment="Center" Fill="{DynamicResource md3.on-surface-variant}"/>
              <TextBlock FontSize="14" VerticalAlignment="Center"
                         Foreground="{DynamicResource md3.on-surface-variant}"
                         Text="{DynamicResource welcome.feature.host}"/>
            </StackPanel>
          </StackPanel>

          <!-- Plus 保留：快捷入口（降级到第三层；10px 小标题 + 32 高行） -->
          <TextBlock Classes="caption" Margin="0,28,0,6" FontSize="10"
                     Text="{DynamicResource welcome.quicklinks}"/>
          <StackPanel>
            <Button Classes="welcome linkRow" Click="OnWiki">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{StaticResource icon-book-open}" Width="18" Height="18" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource welcome.wiki}" FontSize="14" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Classes="welcome linkRow" Click="OnReleases">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{StaticResource icon-download}" Width="18" Height="18" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource welcome.releases}" FontSize="14" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Classes="welcome linkRow" Click="OnDiffsinger">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{StaticResource icon-sparkles}" Width="18" Height="18" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource welcome.diffsinger}" FontSize="14" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Classes="welcome linkRow" Click="OnTeto">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{StaticResource icon-globe}" Width="18" Height="18" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource welcome.teto}" FontSize="14" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Classes="welcome linkRow" Click="OnPackages">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{StaticResource icon-package}" Width="18" Height="18" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource welcome.packages}" FontSize="14" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Classes="welcome linkRow" Click="OnPreferences">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Data="{StaticResource icon-settings}" Width="18" Height="18" Stretch="Uniform"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource welcome.prefs}" FontSize="14" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- 已安装音源（**真实数据**；取不到就整段隐藏，不编数） -->
          <StackPanel x:Name="SingersSection" Margin="0,24,0,0" IsVisible="False">
            <TextBlock Classes="caption" Margin="0,0,0,8" FontSize="10"
                       Text="{DynamicResource welcome.singers.installed}"/>
            <ItemsControl x:Name="SingerChips">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,8,8" Padding="12,0" Height="32" CornerRadius="999"
                          Background="{DynamicResource md3.surface-container-high}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Border Width="6" Height="6" CornerRadius="999"
                              Background="{DynamicResource md3.primary}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"
                                 Foreground="{DynamicResource md3.on-surface-variant}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- 版本行（稿：分隔线 + 11px 左版本 / 右版权） -->
        <StackPanel Grid.Row="2" Spacing="12">
          <Border Height="1" Background="{DynamicResource md3.outline-variant}"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="caption" Text="{Binding AppVersion}"/>
            <TextBlock Grid.Column="1" Classes="caption" Text="{DynamicResource welcome.copyright}"/>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ══════════ 右：启动器（稿：内边距 48 / 纵向间距 16） ══════════ -->
    <Grid Grid.Column="1" Margin="48" RowDefinitions="Auto,Auto,*,Auto">

      <!-- 问候 + 副标题（稿：30 / 15） -->
      <StackPanel Grid.Row="0" Spacing="6">
        <TextBlock Text="{DynamicResource welcome.start}" FontSize="30"
                   Foreground="{DynamicResource md3.on-surface}"/>
        <TextBlock Text="{DynamicResource welcome.greeting.sub}" FontSize="15"
                   Foreground="{DynamicResource md3.on-surface-variant}"/>
      </StackPanel>

      <!-- 动作卡 2×2（稿 2 张 + Plus 的 导入轨道 / 模板；同卡片几何） -->
      <Grid Grid.Row="1" Margin="0,16,0,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
        <Button Grid.Row="0" Grid.Column="0" Classes="welcome actionCard cardMain" Margin="0,0,8,0"
                Click="OnNewProject">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Border Classes="cardIcon onMain">
              <Path Data="{StaticResource icon-plus}" Width="26" Height="26" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource md3.primary}"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="{DynamicResource welcome.new}" FontSize="18" FontWeight="Medium"
                         Foreground="{DynamicResource md3.on-primary}"/>
              <TextBlock Text="{DynamicResource welcome.new.description}" FontSize="13"
                         Foreground="{DynamicResource md3.on-primary}"/>
            </StackPanel>
          </StackPanel>
        </Button>

        <Button Grid.Row="0" Grid.Column="1" Classes="welcome actionCard" Margin="8,0,0,0"
                Click="OnOpenProject">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Border Classes="cardIcon">
              <Path Data="{StaticResource icon-folder-open}" Width="24" Height="24" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource md3.on-secondary-container}"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="{DynamicResource welcome.open}" FontSize="18" FontWeight="Medium"
                         Foreground="{DynamicResource md3.on-surface}"/>
              <TextBlock Text="{DynamicResource welcome.open.description}" FontSize="13"
                         Foreground="{DynamicResource md3.on-surface-variant}"/>
            </StackPanel>
          </StackPanel>
        </Button>

        <Button Grid.Row="1" Grid.Column="0" Classes="welcome actionCard" Margin="0,16,8,0"
                Click="OnImportAudio">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Border Classes="cardIcon">
              <Path Data="{StaticResource icon-music}" Width="24" Height="24" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource md3.on-secondary-container}"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="{DynamicResource menu.file.importaudio}" FontSize="18" FontWeight="Medium"
                         Foreground="{DynamicResource md3.on-surface}"/>
              <TextBlock Text="{DynamicResource welcome.import.description}" FontSize="13"
                         Foreground="{DynamicResource md3.on-surface-variant}"/>
            </StackPanel>
          </StackPanel>
        </Button>

        <Button Grid.Row="1" Grid.Column="1" Classes="welcome actionCard" Margin="8,16,0,0"
                IsVisible="{Binding TemplateFiles.Count}" Click="OnShowTemplates"
                ToolTip.Tip="{DynamicResource welcome.template.tip}">
          <FlyoutBase.AttachedFlyout>
            <Flyout Placement="BottomEdgeAlignedLeft"
                    FlyoutPresenterTheme="{StaticResource Md3FlyoutPresenter}">
              <Border Background="{DynamicResource md3.surface-container-high}"
                      BorderBrush="{DynamicResource md3.outline-variant}" BorderThickness="1"
                      CornerRadius="12" Padding="6" MinWidth="240" MaxHeight="320">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding TemplateFiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RecentFileInfo">
                        <Button Classes="welcome flyoutRow" Click="OnOpenTemplate">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource icon-file-plus}" Width="16" Height="16"
                                  Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{DynamicResource md3.on-surface-variant}"/>
                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource md3.on-surface}"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </Flyout>
          </FlyoutBase.AttachedFlyout>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Border Classes="cardIcon">
              <Path Data="{StaticResource icon-file-plus}" Width="24" Height="24" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{DynamicResource md3.on-secondary-container}"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="{DynamicResource welcome.template}" FontSize="18" FontWeight="Medium"
                         Foreground="{DynamicResource md3.on-surface}"/>
              <TextBlock Text="{DynamicResource welcome.template.description}" FontSize="13"
                         Foreground="{DynamicResource md3.on-surface-variant}"/>
            </StackPanel>
          </StackPanel>
        </Button>
      </Grid>

      <!-- 最近工程 -->
      <Grid Grid.Row="2" Margin="0,16,0,0" RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <TextBlock Grid.Column="0" Classes="sectionTitle" Text="{DynamicResource welcome.recent}"/>
          <Button Grid.Column="1" Classes="linkButton" Click="OnOpenProject"
                  ToolTip.Tip="{DynamicResource welcome.open.description}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{DynamicResource welcome.recent.viewall}" FontSize="14" FontWeight="Medium"
                         VerticalAlignment="Center" Foreground="{DynamicResource md3.primary}"/>
              <Path Data="{StaticResource icon-chevron-right}" Width="18" Height="18" Stretch="Uniform"
                    VerticalAlignment="Center" Fill="{DynamicResource md3.primary}"/>
            </StackPanel>
          </Button>
        </Grid>

        <!-- 恢复条（原版能力 · 只在有恢复项时出现） -->
        <Button Grid.Row="1" Classes="welcome" IsVisible="{Binding HasRecovery}" Click="OnRecovery"
                Margin="0,0,0,12" CornerRadius="12" Padding="12,10" MinHeight="0"
                HorizontalContentAlignment="Stretch"
                Background="{DynamicResource md3.error-container}">
          <TextBlock Text="{Binding RecoveryString}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{DynamicResource md3.on-error-container}"/>
        </Button>

        <ScrollViewer Grid.Row="2" AllowAutoHide="False"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding RecentFiles.Count}">
          <ItemsControl ItemsSource="{Binding RecentFiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecentFileInfo">
                <Button Classes="welcome recentRow" Margin="0,0,0,12" Click="OnOpenRecent">
                  <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                    <Border Width="48" Height="48" CornerRadius="8"
                            Background="{DynamicResource md3.secondary-container}">
                      <Path Data="{StaticResource icon-file}" Width="24" Height="24" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Fill="{DynamicResource md3.on-secondary-container}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource md3.on-surface}"/>
                      <!-- meta：版式照稿（12px + 3px 圆点分隔），信息据实（格式 · 目录） -->
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Format}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource md3.on-surface-variant}"/>
                        <Border Width="3" Height="3" CornerRadius="999" VerticalAlignment="Center"
                                Background="{DynamicResource md3.on-surface-variant}"/>
                        <TextBlock Text="{Binding Directory}" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource md3.on-surface-variant}"/>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding LastWriteTimeStr}" FontSize="12" VerticalAlignment="Center"
                                 Foreground="{DynamicResource md3.on-surface-variant}"/>
                      <Path Data="{StaticResource icon-chevron-right}" Width="20" Height="20"
                            Stretch="Uniform" VerticalAlignment="Center"
                            Fill="{DynamicResource md3.on-surface-variant}"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="4,4,0,0" FontSize="12"
                   Text="{DynamicResource welcome.open.description}"
                   Foreground="{DynamicResource md3.on-surface-variant}"
                   IsVisible="{Binding !RecentFiles.Count}"/>
      </Grid>

      <!-- 拖放提示（稿的 Drop Hint；把主窗已有的拖放能力显性化） -->
      <Border Grid.Row="3" Classes="dropHint" Margin="0,16,0,0" IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <Path Data="{StaticResource icon-download}" Width="20" Height="20" Stretch="Uniform"
                VerticalAlignment="Center" Fill="{DynamicResource md3.on-surface-variant}"/>
          <TextBlock Text="{DynamicResource welcome.drop.hint}" FontSize="13" VerticalAlignment="Center"
                     Foreground="{DynamicResource md3.on-surface-variant}"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
