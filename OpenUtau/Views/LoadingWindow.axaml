<controls:WindowEx xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:OpenUtau.App.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="OpenUtau.App.Views.LoadingWindow" SizeToContent="WidthAndHeight" CanResize="False"
        Title="UTvTU" MinWidth="300" MinHeight="150"
        Icon="/Assets/open-utau.ico"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Image Margin="20" Width="80" Height="80"
           VerticalAlignment="Top" HorizontalAlignment="Center"
           Source="/Assets/OpenUtau.png"/>
        <TextBlock Margin="0,110,0,10" Grid.Row="0"  HorizontalAlignment="Center" VerticalAlignment="Center" Name="Text" TextWrapping="Wrap" MaxWidth="560"> Loading... </TextBlock>
    </Grid>
</controls:WindowEx>
