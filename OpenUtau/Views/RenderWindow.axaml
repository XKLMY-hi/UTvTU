<controls:WorkspaceToolView xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:OpenUtau.App.Controls"
                   x:Class="OpenUtau.App.Views.RenderWindow"
                   Title="{DynamicResource menu.file.render}"
                   Background="{DynamicResource md3.surface}" Focusable="True">
  <controls:WorkspaceToolView.Styles>
    <StyleInclude Source="/Styles/RenderWorkspace.axaml"/>
  </controls:WorkspaceToolView.Styles>
  <Grid RowDefinitions="Auto,*,Auto" MaxWidth="1040" HorizontalAlignment="Stretch">
    <StackPanel Grid.Row="0" Margin="24,20,24,16" Spacing="{DynamicResource Md3Spacing1}">
      <TextBlock Classes="renderTitle" Text="{DynamicResource render.page.title}"/>
      <TextBlock Classes="renderSubtitle" Text="{DynamicResource render.page.subtitle}"/>
    </StackPanel>
    <!-- One constrained viewport scrolls all settings; job actions stay visible. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Name="InputPanel" Margin="24,0,24,20">
        <TextBlock Classes="renderSectionTitle" Text="{DynamicResource render.section.destination}" Margin="0,0,0,12"/>
        <Border Classes="renderSegment">
          <Grid ColumnDefinitions="*,*">
            <RadioButton Grid.Column="0" Name="RadioMixdown" Classes="renderSegmentItem" GroupName="OutMode"
                         IsChecked="True" IsCheckedChanged="OnOptionsChanged" Content="{DynamicResource render.mixdown}"/>
            <RadioButton Grid.Column="1" Name="RadioPerTrack" Classes="renderSegmentItem" GroupName="OutMode"
                         IsCheckedChanged="OnOptionsChanged" Content="{DynamicResource render.pertrack}"/>
          </Grid>
        </Border>
        <TextBlock Name="ModeContractHint" Classes="renderHint" Text="{DynamicResource render.mode.mixhint}" Margin="0,8,0,16"/>
        <TextBlock Classes="renderFieldLabel" Text="{DynamicResource render.outputpath}" Margin="0,0,0,6"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Name="OutputPathBox" Classes="renderInput" TextChanged="OnOptionsChanged"
                   Margin="0,0,8,0" PlaceholderText="{DynamicResource render.outputpath.placeholder}"/>
          <Button Grid.Column="1" Name="BrowsePathBtn" Classes="renderAction" Content="{DynamicResource button.open}" Click="OnBrowsePath"/>
        </Grid>
        <Grid ColumnDefinitions="*,12,*" Margin="0,12,0,0">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Classes="renderFieldLabel" Text="{DynamicResource render.formatlabel}"/>
            <ComboBox Name="FormatCombo" Classes="renderInput" SelectedIndex="0" SelectionChanged="OnOptionsChanged">
              <ComboBoxItem Content="WAV 16-bit" Tag="Wav16"/>
              <ComboBoxItem Content="WAV 24-bit" Tag="Wav24"/>
              <ComboBoxItem Content="WAV 32-bit float" Tag="Wav32"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6">
            <TextBlock Classes="renderFieldLabel" Text="{DynamicResource render.samplerate}"/>
            <ComboBox Name="SampleRateCombo" Classes="renderInput" SelectedIndex="0" SelectionChanged="OnOptionsChanged">
              <ComboBoxItem Content="44100 Hz" Tag="44100"/>
              <ComboBoxItem Content="48000 Hz" Tag="48000"/>
              <ComboBoxItem Content="96000 Hz" Tag="96000"/>
            </ComboBox>
          </StackPanel>
        </Grid>
        <TextBlock Classes="renderHint" Text="{DynamicResource render.samplerate.hint}" Margin="0,8,0,0"/>
        <Border Classes="renderDivider"/>
        <StackPanel Name="RangeOptions" Spacing="{DynamicResource Md3Spacing3}">
          <TextBlock Classes="renderSectionTitle" Text="{DynamicResource render.section.range}"/>
          <Border Classes="renderSegment">
            <Grid ColumnDefinitions="*,*,*">
              <RadioButton Grid.Column="0" Name="RadioFullSong" Classes="renderSegmentItem" GroupName="Range"
                           IsChecked="True" IsCheckedChanged="OnOptionsChanged" Content="{DynamicResource render.fullsong}"/>
              <RadioButton Grid.Column="1" Name="RadioLoop" Classes="renderSegmentItem" GroupName="Range"
                           IsCheckedChanged="OnOptionsChanged" Content="{DynamicResource render.loop}"/>
              <RadioButton Grid.Column="2" Name="RadioCustom" Classes="renderSegmentItem" GroupName="Range"
                           IsCheckedChanged="OnOptionsChanged" Content="{DynamicResource render.custom}"/>
            </Grid>
          </Border>
          <Grid Name="CustomSecondsPanel" ColumnDefinitions="*,12,*" IsVisible="False">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Classes="renderFieldLabel" Text="{DynamicResource render.startseconds}"/>
              <TextBox Name="CustomStartSecondsBox" Classes="renderInput" Text="0" TextChanged="OnOptionsChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6">
              <TextBlock Classes="renderFieldLabel" Text="{DynamicResource render.endseconds}"/>
              <TextBox Name="CustomEndSecondsBox" Classes="renderInput" TextChanged="OnOptionsChanged"/>
            </StackPanel>
          </Grid>
          <StackPanel Spacing="6" Width="240" HorizontalAlignment="Left">
            <TextBlock Classes="renderFieldLabel" Text="{DynamicResource render.tailseconds}"/>
            <TextBox Name="TailSecondsBox" Classes="renderInput" Text="0" TextChanged="OnOptionsChanged"/>
          </StackPanel>
        </StackPanel>
        <Border Classes="renderDivider"/>
        <Grid ColumnDefinitions="*,20,*">
          <StackPanel Grid.Column="0" Spacing="{DynamicResource Md3Spacing2}">
            <TextBlock Classes="renderSectionTitle" Text="{DynamicResource render.tracks}"/>
            <WrapPanel Orientation="Horizontal">
              <Button Name="TrackSelectAllBtn" Classes="renderAction subtle" Margin="0,0,4,0"
                      Content="{DynamicResource render.selectall}" Click="OnSelectAllTracks"/>
              <Button Name="TrackSelectNoneBtn" Classes="renderAction subtle"
                      Content="{DynamicResource render.selectnone}" Click="OnSelectNoTracks"/>
            </WrapPanel>
            <Border Background="{DynamicResource md3.surface-container-high}" BorderBrush="{DynamicResource md3.outline-variant}"
                    BorderThickness="1" CornerRadius="{DynamicResource Md3ShapeMedium}" Padding="10,6">
              <ScrollViewer MaxHeight="208" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Name="TrackCheckPanel"/>
              </ScrollViewer>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="{DynamicResource Md3Spacing2}">
            <TextBlock Classes="renderSectionTitle" Text="{DynamicResource render.section.processing}"/>
            <StackPanel Spacing="6">
              <TextBlock Classes="renderFieldLabel" Text="{DynamicResource render.processing.method}"/>
              <ComboBox Name="ProcessingModeCombo" Classes="renderInput" SelectedIndex="0" SelectionChanged="OnOptionsChanged">
                <ComboBoxItem Content="{DynamicResource render.processing.offline}" Tag="Offline"/>
                <ComboBoxItem Content="{DynamicResource render.processing.realtime}" Tag="Realtime"/>
              </ComboBox>
              <TextBlock Classes="renderHint" Text="{DynamicResource render.processing.hint}"/>
            </StackPanel>
            <StackPanel>
              <CheckBox Name="ChkVst" Classes="renderCheck" IsChecked="True" IsCheckedChanged="OnOptionsChanged" Content="{DynamicResource render.effects.vst}"/>
              <CheckBox Name="ChkBuiltinFx" Classes="renderCheck" IsChecked="True" IsCheckedChanged="OnOptionsChanged" Content="{DynamicResource render.effects.builtin}"/>
              <CheckBox Name="ChkVolume" Classes="renderCheck" IsChecked="True" IsCheckedChanged="OnOptionsChanged" Content="{DynamicResource render.effects.volume}"/>
              <Border Name="MasterOptionsHost">
                <CheckBox Name="ChkMaster" Classes="renderCheck" IsChecked="True" IsCheckedChanged="OnOptionsChanged" Content="{DynamicResource render.master}"/>
              </Border>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Border Classes="renderDivider"/>
        <StackPanel Spacing="10">
          <TextBlock Classes="renderSectionTitle" Text="{DynamicResource render.section.summary}"/>
          <Border Background="{DynamicResource md3.surface-container}" CornerRadius="{DynamicResource Md3ShapeMedium}" Padding="16,12">
            <TextBlock Name="OutputSummaryText" Classes="renderSummary" Text="{DynamicResource render.summary.placeholder}"/>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource md3.outline-variant}"
            Background="{DynamicResource md3.surface-container-low}" Padding="24,12,24,16">
      <StackPanel Spacing="{DynamicResource Md3Spacing2}">
        <TextBlock Name="ValidationText" Classes="renderError" IsVisible="False"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Name="ProgressLabel" Classes="renderHint" Text="{DynamicResource render.ready}"/>
          <TextBlock Grid.Column="1" Name="ProgressPercentText" Classes="renderHint" Text="0%" Margin="12,0,0,0"/>
        </Grid>
        <ProgressBar Name="ProgressBarControl" Classes="renderProgress" Value="0" Minimum="0" Maximum="100"/>
        <TextBlock Name="ProgressSubLabel" Classes="renderHint" IsVisible="False"/>
        <Grid ColumnDefinitions="*,Auto,8,Auto">
          <Button Grid.Column="0" Name="OpenFolderBtn" Classes="renderAction" HorizontalAlignment="Left"
                  Content="{DynamicResource render.openfolder}" Click="OnOpenFolder"/>
          <Button Grid.Column="1" Name="CancelBtn" Classes="renderAction" IsEnabled="False"
                  Content="{DynamicResource render.cancel}" Click="OnCancelRender"/>
          <Button Grid.Column="3" Name="StartBtn" Classes="renderAction primary"
                  Content="{DynamicResource render.start}" Click="OnStartRender"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</controls:WorkspaceToolView>
