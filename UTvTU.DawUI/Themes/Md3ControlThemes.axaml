<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ═══════════════════════════════════════════════════════════════════════
       MD3 控件主题（实验：ControlTheme 与"装主题"的样式放在**同一个文件**）

       上一轮四种挂法都失败，怀疑点是"跨字典 StaticResource 解析不到"：
       主题在 App.Resources、引用它的样式在另一个 Styles 文件 → 装不上去。
       这里把两者放同一字典，再用应用级 Style 显式 Setter Property="Theme"
       （应用级 Style 优先级已被反复验证为最高）。

       T8 起：**类变体的颜色也在本文件内**（`^.primary` / `^.outline` / `^.danger` 及其
       悬浮·按下态）。原因：应用级 Style setter 压过 ControlTheme setter —— 变体颜色留在
       应用级样式里会反过来压住主题（还会在 ContentPresenter 上刷没有圆角的色块）。
       ═══════════════════════════════════════════════════════════════════════ -->
  <Styles.Resources>
    <ControlTheme x:Key="Md3ButtonTheme" TargetType="Button" BasedOn="{StaticResource DawButtonTheme}">
      <!-- Outlined is the desktop default; explicit filled/tonal/text variants share the same states. -->
      <Setter Property="Foreground" Value="{DynamicResource md3.primary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource md3.outline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3ShapeFull}"/>
      <Setter Property="Padding" Value="{DynamicResource Md3ButtonPadding}"/>
      <Setter Property="MinHeight" Value="{DynamicResource Md3ControlHeight}"/>
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeLabelLarge}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Style Selector="^.linkButton">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="MinHeight" Value="{DynamicResource Md3DenseControlHeight}"/>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="Md3ListBoxItemTheme" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Md3DawCornerRadius}"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="FontSize" Value="{DynamicResource Md3TypeBodyMedium}"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource Md3MotionEffectsFast}" Easing="{StaticResource Md3EffectsFastEasing}"/>
          <BrushTransition Property="Foreground" Duration="{DynamicResource Md3MotionEffectsFast}" Easing="{StaticResource Md3EffectsFastEasing}"/>
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <!-- T10-B：与 Button 同一类转发缺失 —— 少了这行，`^:selected` 的
                 md3.on-secondary-container 到不了内容（渲染层恒为 on-surface）。
                 列表内容是**数据**而非标签，故不加 RecognizesAccessKey（下划线要保持字面），
                 改由 Md3Controls.axaml 的 `ListBoxItem TextBlock` 规则把 Item 前景转发给文本。 -->
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource md3.surface-container-highest}"/>
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Background" Value="{DynamicResource md3.secondary-container}"/>
        <Setter Property="Foreground" Value="{DynamicResource md3.on-secondary-container}"/>
      </Style>
      <Style Selector="^:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource md3.secondary-container}"/>
      </Style>
    </ControlTheme>

    <!-- ══ W31：ToggleButton 自有主题 ══
        为什么必须接管：Fluent 的 ToggleButton 模板**只有一个 ContentPresenter**（探针实证：无 Border），
        所以 `ToggleButton.Background` 根本无处可画 —— 应用级样式里那些"控件级底色"从来没生效过，
        过去只能靠 `/template/ ContentPresenter#PART_ContentPresenter` 补丁刷内缩方块（L9 同源问题）。
        本主题给它一个会画背景的 Border#PART_Root（与 Md3ButtonTheme 同构），
        使控件级状态色（Styles.axaml 的 .normal/.toolbar 与这里的 :checked/:pointerover）真正可见。 -->
    <ControlTheme x:Key="Md3ToggleButtonTheme" TargetType="ToggleButton" BasedOn="{StaticResource DawButtonTheme}">
      <Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource md3.secondary-container}"/>
        <Setter Property="Foreground" Value="{DynamicResource md3.on-secondary-container}"/>
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- 装主题：应用级 Style（同文件内的 StaticResource 必定解析得到） -->
  <Style Selector="Button">
    <Setter Property="Theme" Value="{StaticResource Md3ButtonTheme}"/>
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Theme" Value="{StaticResource Md3ListBoxItemTheme}"/>
  </Style>
  <Style Selector="ToggleButton">
    <Setter Property="Theme" Value="{StaticResource Md3ToggleButtonTheme}"/>
  </Style>
</Styles>
