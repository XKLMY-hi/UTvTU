<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.2" />
    <PackageReference Include="System.Text.Json" Version="9.0.2" />
    <!-- xunit v3：Avalonia.Headless.XUnit 12.x 依赖 xunit.v3（v3 无 xunit meta 包，拆成 core+assert） -->
    <PackageReference Include="xunit.v3.core" Version="3.2.2" />
    <PackageReference Include="xunit.v3.assert" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenUtau.Core\OpenUtau.Core.csproj" />
    <ProjectReference Include="..\OpenUtau.Plugin.Builtin\OpenUtau.Plugin.Builtin.csproj" />
    <ProjectReference Include="..\OpenUtau\OpenUtau.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Usts\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Usts\" />
    <None Include="Files\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Files\" />
    <!-- W7 音频验收装置：纯文本 .ustxp 测试工程 fixture（Ustxp.Load 读入用） -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Fixtures\" />
    <None Include="Core\Theming\Data\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Core\Theming\Data\" />
    <!-- 视图 XAML 源码：契约测试需要扫描资源键（avares 不保留 .axaml 原文） -->
    <None Include="..\OpenUtau\Views\WelcomeView.axaml" Link="Views\WelcomeView.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OpenUtau\Views\MainWindow.axaml" Link="Views\MainWindow.axaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- W16 面板系统：分隔条控件的视觉口径（细轨/命中区/hover 主色）按源码契约断言 -->
    <None Include="..\OpenUtau\Controls\PanelSplitter.axaml" Link="Controls\PanelSplitter.axaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- W21-A 平滑滚动：轨道视图接线要连 SmoothViewport / TracksViewModel 源码一起断言（MainWindow 源码已在上方） -->
    <None Include="..\OpenUtau\Controls\SmoothViewport.cs" Link="Controls\SmoothViewport.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OpenUtau\ViewModels\TracksViewModel.cs" Link="ViewModels\TracksViewModel.cs" CopyToOutputDirectory="PreserveNewest" />
    <!-- 窗口源码：S5 视图化的窗口层接线（胶囊 → 切视图、分离/收回）无法 headless 起窗，只能按源码契约断言 -->
    <None Include="..\OpenUtau\Views\MainWindow.axaml.cs" Link="Views\MainWindow.axaml.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OpenUtau\Views\PreferencesView.axaml" Link="Views\PreferencesView.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OpenUtau\Views\RenderWindow.axaml" Link="Views\RenderWindow.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OpenUtau\App.axaml" Link="App.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OpenUtau\Styles\Md3Controls.axaml" Link="Styles\Md3Controls.axaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- W31：应用级样式表不再允许 ControlTheme 之外的 /template/ 补丁 —— 按源码原文做常驻契约断言 -->
    <None Include="..\OpenUtau\Styles\Styles.axaml" Link="Styles\Styles.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OpenUtau\Styles\Md3ControlThemes.axaml" Link="Styles\Md3ControlThemes.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OpenUtau\Styles\Md3SelectionThemes.axaml" Link="Styles\Md3SelectionThemes.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OpenUtau\Styles\Md3Transitions.axaml" Link="Styles\Md3Transitions.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OpenUtau\Controls\TrackHeader.axaml" Link="Controls\TrackHeader.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OpenUtau\Styles\Md3Menus.axaml" Link="Styles\Md3Menus.axaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\OpenUtau\Views\MixFxDialog.axaml" Link="Views\MixFxDialog.axaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- W12：单文件 .vst3 与「老式 bundle 回退」都走子进程探针（VstProbeProcess 在 <appdir> 下找
       vst_probe.exe）。测试宿主过去不复制它 ⇒ 扫描链在测试环境里必然空转，所有单文件 VST3
       都扫不到（会被误读成"这台机器没有插件"）。与主工程 OpenUtau.csproj 的 CopyVstProbe 同款做法。 -->
  <Target Name="CopyVstProbeToTestOutput" AfterTargets="Build">
    <MSBuild Projects="..\VstProbe\VstProbe.csproj" Targets="Build" />
    <!-- 复制 vst_probe 全部产物：apphost 运行需要同目录的 dll + runtimeconfig.json -->
    <ItemGroup>
      <VstProbeFiles Include="..\VstProbe\bin\$(Configuration)\net8.0\vst_probe.*" />
    </ItemGroup>
    <Copy SourceFiles="@(VstProbeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
