<!-- W39c 品牌几何 —— **源路径 verbatim**（品牌板 HTML 抽出），一律用描边渲染：
     标志：viewBox 0 0 64 64，d = M8 13 H24 M16 13 V29 M40 13 H56 M48 13 V29 M27 25 L32 35 L37 25 M9 41 V44 Q9 51 16 51 Q23 51 23 44 V41 M55 41 V44 Q55 51 48 51 Q41 51 41 44 V41
            StrokeThickness = 显示尺寸 ÷ 8（64 网格内为 8）
     括号：viewBox -2 -2 28 48，d = M20 4 H14 Q10 4 10 8 V18 Q10 22 4 22 Q10 22 10 26 V36 Q10 40 14 40 H20
            StrokeThickness = 墨迹高 ÷ 6（此路径下为 6）；} 用 ScaleTransform ScaleX="-1"（不要手绘）
     切角 v：填充 M0 0 L4.5 14 L9 0（viewBox 0 0 9 14）／描边 M1.54 1.54 L4.5 12.46 L7.46 1.54
     用法：<Path Data="{StaticResource brand-mark}" Stroke="{DynamicResource md3.primary}"
                 StrokeThickness="{尺寸/8}" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"/> -->
<StreamGeometry x:Key="brand-mark">M8 13 H24 M16 13 V29 M40 13 H56 M48 13 V29 M27 25 L32 35 L37 25 M9 41 V44 Q9 51 16 51 Q23 51 23 44 V41 M55 41 V44 Q55 51 48 51 Q41 51 41 44 V41</StreamGeometry>
<StreamGeometry x:Key="brand-brace">M20 4 H14 Q10 4 10 8 V18 Q10 22 4 22 Q10 22 10 26 V36 Q10 40 14 40 H20</StreamGeometry>
<StreamGeometry x:Key="brand-v-chevron">M0 0 L4.5 14 L9 0</StreamGeometry>
<StreamGeometry x:Key="brand-v-chevron-stroke">M1.54 1.54 L4.5 12.46 L7.46 1.54</StreamGeometry>
