<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="UTvTU.Installer.App" RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="/Assets/Brand.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://UTvTU.DawUI/Themes/DawTheme.axaml"/>
    <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource md3.surface-container-lowest}"/><Setter Property="FontFamily" Value="{DynamicResource PlusFontFamily}"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource md3.on-surface}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/><Setter Property="LineHeight" Value="21"/></Style>
    <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="{DynamicResource md3.on-surface-variant}"/><Setter Property="FontSize" Value="11"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource md3.surface-container}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/></Style>
    <Style Selector="Border.step"><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
    <Style Selector="Border.step.active"><Setter Property="Background" Value="{DynamicResource md3.secondary-container}"/></Style>
    <Style Selector="Border.step.active TextBlock"><Setter Property="Foreground" Value="{DynamicResource md3.on-secondary-container}"/></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="40"/></Style>
    <Style Selector="CheckBox"><Setter Property="MinHeight" Value="36"/></Style>
  </Application.Styles>
</Application>
